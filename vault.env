# The vault's settings (docker-compose.yml: env_file [vault.env, .env]; the server's .env wins over this file).
# Only VAULT_NAME=value lines and full-line comments: a Telegram-approved deploy may change this file, and the host
# runner refuses anything else. Values without quotes or spaces.
# where the local LLM's weight files are (a read-only bind of the data pool)
VAULT_WEIGHTS=/models
# follow-up ask sessions (vault ask --session; memory only); 0 = off
VAULT_ASK_SESSIONS=1
# person cards (metadata only, /data/state/people.db); 0 = off
VAULT_PEOPLE=1
# relation questions and relays in the vault bot
VAULT_PEOPLE_ASK=1
# open asks + topics on the person cards; 0 = v1 cards
VAULT_PEOPLE_ASKS=1
# embedding server (SCHED_IDLE, 127.0.0.1) = model name; 0 = off
VAULT_EMBED=embeddinggemma
# hybrid retrieval by default for vault ask; 0 = keyword
VAULT_INDEX=1
# photos: OCR in the vault for media facts and the event feed; 0 = off
VAULT_PHOTOS=1
# media facts read by the model's vision projector; 0 = OCR only
VAULT_VISION=1
# Home Assistant status feed (read-only websocket, coarse flags, /ha/now); 0 = off
VAULT_HA_FEED=1

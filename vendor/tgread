def _window_rows(db, since, *, include_read, include_muted, include_archived, chat_id=None, until=None,
                 chat_ids=None):
    """Messages of the window [since, until) in time order. chat_id / chat_ids: only those chats (muted and archived
    ones included: they were asked for by name)."""
    where = ['m.ts >= ?', "c.type != 'self'"]
    params = [int(since)]
    picked = chat_id is not None or chat_ids is not None
    if until is not None:
        where.append('m.ts < ?')
        params.append(int(until))
    if not include_read:
        where.append('m.out = 0 AND m.msg_id > c.read_inbox_max_id')
    if not include_muted and not picked:
        where.append('c.muted = 0')
    if not include_archived and not picked:
        where.append('c.archived = 0')
    if chat_id is not None:
        where.append('m.chat_id = ?')
        params.append(chat_id)
    if chat_ids is not None:
        ids = sorted({int(x) for x in chat_ids}) or [0]
        where.append(f"m.chat_id IN ({','.join('?' * len(ids))})")
        params += ids
    return db.execute(f"SELECT m.* FROM messages m JOIN chats c ON c.chat_id = m.chat_id "
                      f"WHERE {' AND '.join(where)} ORDER BY m.ts, m.msg_id", params).fetchall()


def _cap_per_chat(rows, per_chat):
    groups, total = {}, {}
    for r in rows:
        groups.setdefault(r['chat_id'], []).append(r)
    kept = []
    for cid, rs in groups.items():
        total[cid] = len(rs)
        kept += rs[-per_chat:] if per_chat else rs
    return kept, total


def _sync_age_note(db):
    last = float(meta_get(db, 'last_sync_ts') or 0)
    if not last:
        return 'never synced'
    mins = (now_ts() - last) / 60
    return f'last sync {fmt_ts(last)}' + (f' ({mins:.0f} min ago; add --sync to refresh)' if mins > 30 else '')


def _unread_extra(total):
    def extra(chat, msgs):
        n = total.get(chat['chat_id'], len(msgs))
        s = f" · {chat.get('unread_count', 0)} unread"
        if chat.get('unread_mentions'):
            s += f", {chat['unread_mentions']} mention(s)"
        if chat.get('muted'):
            s += ' · muted'
        if chat.get('archived'):
            s += ' · archived'
        if n > len(msgs):
            s += f' · showing the last {len(msgs)} of {n}'
        return s
    return extra


def cmd_unread(args):
    cfg = load_config()
    db = open_db()

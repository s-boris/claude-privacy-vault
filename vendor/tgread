    except Exception as e:
        print(f'note: --sync failed ({mask_text(str(e))[:200]}); showing the stored data')


# =============================================================================================== masking

_URL_RE = re.compile(r"(?i)(?<![\w@/])(?:https?://|www\.|t\.me/|telegram\.(?:me|dog)/|tg://)[^\s<>\"'`]+")
_URL_TRAIL = '.,;:!?\'"»›…'
_UUID_RE = re.compile(r'(?i)\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b')
_STRONG_KEYS = {
    'token', 'access_token', 'refresh_token', 'id_token', 'auth', 'authorization', 'auth_token', 'key', 'api_key',
    'apikey', 'api-key', 'secret', 'client_secret', 'sig', 'signature', 'password', 'passwd', 'pass', 'pwd', 'code',
    'otp', 'pin', 'session', 'sessionid', 'session_id', 'sid', 'jwt', 'ticket', 'invite', 'invite_code',
    'invitation', 'share', 'sharekey', 'share_token', 'rlkey', 'x-amz-signature', 'x-amz-credential',
    'x-amz-security-token', 'email', 'mail', 'phone', 'tel', 'mobile', 'iban', 'user', 'username', 'login', 'uid',
    'userid', 'user_id'}
_WEAK_KEYS = {'t', 'h', 'k', 'e', 's', 'c', 'r', 'u', 'p', 'id', 'hash', 'ref'}
_INVITE_HOSTS = ('chat.whatsapp.com', 'discord.gg', 'signal.group', 'join.skype.com')


def _url_span(text, m):
    s, e = m.start(), m.end()
    while e > s and text[e - 1] in _URL_TRAIL:
        e -= 1
    pairs = {')': '(', ']': '[', '}': '{'}
    while e > s and text[e - 1] in pairs and text[s:e].count(text[e - 1]) > text[s:e].count(pairs[text[e - 1]]):
        e -= 1
        while e > s and text[e - 1] in _URL_TRAIL:
            e -= 1
    return s, e


def _tokenish(v):
    if _UUID_RE.search(v):
        return True
    for part in re.split(r'[-_.~]+', v):
        if len(part) >= 16 and re.search(r'\d', part) and re.search(r'[A-Za-z]', part):
            return True
    return len(re.sub(r'\D', '', v)) >= 9          # phone/account numbers in links (wa.me/4179...)


def mask_url(url):
    """Keep ordinary links; replace links that carry secrets or personal data with [URL:host]."""
    u = url if re.match(r'(?i)[a-z][a-z0-9+.-]*://', url) else 'http://' + url
    try:
        sp = urlsplit(u)
        host = (sp.hostname or '').lower()
    except ValueError:
        return '[URL]'
    label = f'[URL:{host}]' if host else '[URL]'
    if sp.scheme.lower() == 'tg':
        return '[URL:tg]'
    try:
        if sp.username or sp.password:
            return label
    except ValueError:
        return label
    path = sp.path or ''
    if host in ('t.me', 'telegram.me', 'telegram.dog') and (path.startswith('/+') or path.lower().startswith('/joinchat')):
        return label
    if any(host == h or host.endswith('.' + h) for h in _INVITE_HOSTS):
        return label
    for k, v in parse_qsl(sp.query, keep_blank_values=True):
        kl = k.lower()
        if kl in _STRONG_KEYS or '@' in v or (v and _tokenish(v)) or (kl in _WEAK_KEYS and len(v) >= 8):
            return label
    for seg in [s for s in path.split('/') if s] + ([sp.fragment] if sp.fragment else []):
        if '@' in seg or _tokenish(seg):
            return label
    return url



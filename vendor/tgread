def _luhn(d):
    total, alt = 0, False
    for ch in reversed(d):
        x = int(ch)
        if alt:
            x = x * 2 - 9 if x > 4 else x * 2
        total, alt = total + x, not alt
    return total % 10 == 0


def _phone_valid(c):
    d = re.sub(r'\D', '', c)
    s = c.lstrip()
    if s.startswith('+'):
        return 8 <= len(d) <= 15
    if s.startswith('00'):
        return 10 <= len(d) <= 17
    if s.startswith('0') or s.startswith('(0'):
        return 10 <= len(d) <= 12
    return False


def _mask_phone(cand):
    if _DATE_LIKE.search(cand):
        return cand
    if _phone_valid(cand):
        return '[PHONE]'
    seps = [m for m in _SEP_RUN.finditer(cand)]
    for m in reversed(seps):            # two numbers glued by a separator: mask the longest valid head, recurse
        head, rest = cand[:m.start()], cand[m.end():]
        if _phone_valid(head) and rest[:1] in '+0(':
            return '[PHONE]' + m.group(0) + _mask_phone(rest)
    return cand


def _iban_repl(m):
    compact = re.sub(r'\s', '', m.group(1))
    if (15 <= len(compact) <= 34 and compact[:2].upper() in IBAN_COUNTRIES
            and sum(c.isdigit() for c in compact) >= 10):
        return '[IBAN]'
    return m.group(0)


def _addr_repl(m):
    """An address match swallows a sentence's final period ('1234 Exampletown.'): give it back."""
    return '[ADDRESS].' if m.group(0).endswith('.') and m.group(0)[-2:-1].isalpha() else '[ADDRESS]'


def _long_repl(m):
    d = m.group(0)
    if d.startswith('00') and len(d) <= 17:          # 0041791234567: international phone number
        return '[PHONE]'
    return '[CARD]' if len(d) <= 19 and _luhn(d) else '[NUMBER]'


_PLAIN_MASKS = [
    (EMAIL_RE, '[EMAIL]'),
    (IBAN_RE, _iban_repl),
    (AHV_RE, '[AHV]'),
    (CARD_GROUPED_RE, '[CARD]'),
    (LONG_DIGITS_RE, _long_repl),
    (POSTAL_ACCOUNT_RE, '[ACCOUNT]'),
    (ACCOUNT_KW_RE, lambda m: m.group(1) + m.group(2) + '[ACCOUNT]'),
    (COORD_RE, '[LOCATION]'),
    (PHONE_INTL_RE, lambda m: _mask_phone(m.group(0))),
    (PHONE_NAT_RE, lambda m: _mask_phone(m.group(0))),
    *[(rx, _addr_repl) for rx in ADDRESS_RES],
    (SECRET_KW_RE, lambda m: m.group(1) + m.group(2) + '[SECRET]'),
    (PIN_RE, lambda m: m.group(1) + ' [SECRET]'),
]


_ADDRESS_IDS = {id(rx) for rx in ADDRESS_RES}


def _mask_plain(s, addresses=True):
    for rx, repl in _PLAIN_MASKS:
        if addresses or id(rx) not in _ADDRESS_IDS:
            s = rx.sub(repl, s)
    return s


_SS = None


def _secretscan():
    """~/bin/secretscan.py as a module (my own secret values + token formats), loaded by path; optional."""
    global _SS
    if _SS is None:
        _SS = False
        try:
            if SECRETSCAN_PATH.is_file():
                spec = importlib.util.spec_from_file_location('tgread_secretscan', SECRETSCAN_PATH)
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
                if hasattr(mod, 'redact'):
                    _SS = mod
        except Exception as e:
            log.warning('secretscan unavailable: %s', type(e).__name__)
    return _SS or None


def mask_text(text, addresses=True):
    """Regex safety net for everything that leaves tgread (except --raw). addresses=False keeps street addresses
    (llm-local policy v2 lets them through; the fallback and --strict mask them)."""
    if not text:
        return text
    ss = _secretscan()
    if ss:
        try:
            text = ss.redact(text)
        except Exception:
            pass
    out, last = [], 0
    for m in _URL_RE.finditer(text):
        s, e = _url_span(text, m)
        if s < last:
            continue
        out.append(_mask_plain(text[last:s], addresses))
        out.append(mask_url(text[s:e]))
        last = e
    out.append(_mask_plain(text[last:], addresses))
    return ''.join(out)



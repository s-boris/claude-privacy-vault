def _types(*names):
    T = _telethon().types
    return tuple(c for c in (getattr(T, n, None) for n in names) if c is not None)


def entity_type(e):
    T = _telethon().types
    if isinstance(e, T.User):
        return 'self' if getattr(e, 'is_self', False) else ('bot' if getattr(e, 'bot', False) else 'user')
    if isinstance(e, _types('Chat', 'ChatForbidden', 'ChatEmpty')):
        return 'group'
    if isinstance(e, _types('Channel', 'ChannelForbidden')):
        return 'supergroup' if (getattr(e, 'megagroup', False) or getattr(e, 'gigagroup', False)) else 'channel'
    if isinstance(e, _types('Community', 'CommunityForbidden')):
        return 'community'
    return 'other'


def display_name(e):
    if e is None:
        return None
    TL = _telethon()
    if isinstance(e, TL.types.User):
        if getattr(e, 'deleted', False):
            return 'Deleted Account'
        n = ' '.join(x for x in (e.first_name, e.last_name) if x).strip()
        return n or (f'@{e.username}' if getattr(e, 'username', None) else str(e.id))
    try:
        return TL.utils.get_display_name(e) or getattr(e, 'title', None) or '?'
    except Exception:
        return getattr(e, 'title', None) or '?'



def shred(p):
    """Best effort: overwrite a regular file with zeros, then unlink (a symlink is only unlinked)."""
    p = Path(p)
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        return
    try:
        if stat.S_ISREG(st.st_mode) and st.st_size:
            fd = os.open(p, os.O_WRONLY | getattr(os, 'O_NOFOLLOW', 0))
            try:
                os.write(fd, b'\0' * st.st_size)
                os.fsync(fd)
            finally:
                os.close(fd)
    except OSError:
        pass
    try:
        os.unlink(p)
    except FileNotFoundError:
        pass


class Lock:
    """One Telegram connection at a time (cron sync vs. manual commands); flock on ~/.local/share/tgread/lock."""

    def __init__(self, wait=0.0):
        self.wait, self.ok, self.fd = wait, False, None

    def __enter__(self):
        ensure_private_dir(DATA_DIR)
        self.fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o600)
        end = time.monotonic() + self.wait
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.ok = True
                break
            except BlockingIOError:
                if time.monotonic() >= end:
                    break
                time.sleep(0.5)
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            if self.ok:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
        return False



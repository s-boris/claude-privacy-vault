def _validate_config(cfg):
    isint = lambda v: isinstance(v, int) and not isinstance(v, bool)
    isnum = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    sels = lambda v: isinstance(v, list) and all(isinstance(x, (int, str)) and not isinstance(x, bool) for x in v)
    strs = lambda v: isinstance(v, list) and all(isinstance(x, str) for x in v)
    rules = {
        'exclude_chats': (sels, 'a list of chat ids / @usernames / titles'),
        'include_only': (sels, 'a list of chat ids / @usernames / titles'),
        'max_history_days': (lambda v: isint(v) and 1 <= v <= 36500, 'whole days, 1..36500'),
        'include_archived': (lambda v: isinstance(v, bool), 'true or false'),
        'skip_channels_over_members': (lambda v: v is None or (isint(v) and v > 0), 'null or a positive integer'),
        'skip_groups_over_members': (lambda v: v is None or (isint(v) and v > 0), 'null or a positive integer'),
        'request_delay_seconds': (lambda v: isnum(v) and 0 <= v <= 60, 'seconds, 0..60'),
        'max_flood_sleep_seconds': (lambda v: isint(v) and 0 <= v <= 86400, 'seconds, 0..86400'),
        'pseudonymize_names': (lambda v: isinstance(v, bool), 'true or false'),
        'use_local_llm': (lambda v: isinstance(v, bool), 'true or false'),
        'local_llm_cmd': (lambda v: isinstance(v, str), 'a command path'),
        'local_llm_anonymize_args': (strs, 'a list of strings'),
        'local_llm_summary_args': (strs, 'a list of strings'),
        'local_llm_timeout_seconds': (lambda v: isint(v) and 10 <= v <= 14400, 'seconds, 10..14400'),
        'local_llm_max_chars': (lambda v: isint(v) and 500 <= v <= 10_000_000, 'characters, 500..10000000'),
        'local_llm_seconds_per_kchar': (lambda v: isnum(v) and 0 <= v <= 3600, 'seconds, 0..3600'),
        'llm_fallback': (lambda v: isinstance(v, bool), 'true or false'),
        'llm_skip_public_channels': (lambda v: isinstance(v, bool), 'true or false'),
        'live_events': (lambda v: isinstance(v, bool), 'true or false'),
        'live_max_queue_days': (lambda v: isint(v) and 1 <= v <= 30, 'whole days, 1..30'),
    }
    for key, (ok, what) in rules.items():
        if not ok(cfg.get(key)):
            raise UsageError(f'{CONFIG_PATH}: {key} must be {what} (got {cfg.get(key)!r})')


def forced_excludes():
    """TGREAD_FORCE_EXCLUDE (comma-separated chat ids / @usernames; set by the privacy vault): always excluded,
    whatever the config says, so `exclude rm` can't undo them (the vault's bot chat, which carries raw-release codes,
    and Telegram's login-code chat 777000)."""
    out = []
    for x in (os.environ.get('TGREAD_FORCE_EXCLUDE') or '').split(','):
        x = x.strip()
        if re.fullmatch(r'-?\d{1,20}', x):
            out.append(int(x))
        elif re.fullmatch(r'@\w{3,64}', x):
            out.append(x)
    return out


def _with_forced(cfg):
    extra = [e for e in forced_excludes() if e not in cfg['exclude_chats']]
    if extra:
        cfg['exclude_chats'] = list(cfg['exclude_chats']) + extra
    return cfg


def load_config():
    ensure_private_dir(CONFIG_DIR)
    if not CONFIG_PATH.exists():
        cfg = {'_help': CONFIG_HELP, **DEFAULT_CONFIG}
        write_private_json(CONFIG_PATH, cfg)
        return _with_forced(cfg)
    try:
        if stat.S_IMODE(os.lstat(CONFIG_PATH).st_mode) & 0o077:
            os.chmod(CONFIG_PATH, 0o600)
        data = json.loads(CONFIG_PATH.read_text('utf-8'))
    except ValueError as e:
        raise UsageError(f'{CONFIG_PATH} is not valid JSON ({e}); fix it by hand')
    if not isinstance(data, dict):
        raise UsageError(f'{CONFIG_PATH} must contain a JSON object')
    cfg = {**DEFAULT_CONFIG, **data}
    _validate_config(cfg)
    return _with_forced(cfg)


def save_config(cfg):
    ensure_private_dir(CONFIG_DIR)
    _validate_config(cfg)
    write_private_json(CONFIG_PATH, {'_help': CONFIG_HELP, **{k: v for k, v in cfg.items() if k != '_help'}})


# =============================================================================================== credentials

_HEX32 = re.compile(r'[0-9a-f]{32}')


def load_creds():
    if not check_private_file(CREDS_PATH, 'credentials file'):
        raise NotAuthorized('no API credentials yet. The owner creates an app at https://my.telegram.org -> API '
                            'development tools, then: printf "%s\\n%s\\n" API_ID API_HASH | tgread set-credentials')
    try:
        d = json.loads(CREDS_PATH.read_text('utf-8'))
        api_id, api_hash = int(d['api_id']), str(d['api_hash']).strip().lower()
    except Exception:
        raise TgreadError(f'{CREDS_PATH} is unreadable or incomplete (needs api_id and api_hash); '
                          f'run tgread set-credentials again')
    if api_id <= 0 or not _HEX32.fullmatch(api_hash):
        raise TgreadError(f'{CREDS_PATH} holds an invalid api_id/api_hash; run tgread set-credentials again')
    _SECRET_VALUES.add(api_hash)
    return api_id, api_hash


def parse_creds_input(text):
    """api_id + api_hash from: JSON {"api_id":..,"api_hash":..}, 'api_id=..' lines, or two whitespace-separated
    tokens. Error messages never contain the values."""
    text = (text or '').strip()
    if not text:
        raise UsageError('nothing on stdin: pipe in the api_id and the api_hash')
    api_id = api_hash = None
    try:
        d = json.loads(text)
        if not isinstance(d, dict):
            raise ValueError
        api_id, api_hash = d.get('api_id'), d.get('api_hash')
    except ValueError:
        kv = {k.lower(): v for k, v in re.findall(r'(?im)^\s*(api_id|api_hash)\s*[=:]\s*(\S+)\s*$', text)}
        if kv:
            api_id, api_hash = kv.get('api_id'), kv.get('api_hash')
        else:
            parts = text.split()
            if len(parts) != 2:
                raise UsageError('expected exactly two values on stdin: api_id, then api_hash (or JSON)')
            api_id, api_hash = parts
    try:
        api_id = int(str(api_id).strip())
    except (TypeError, ValueError):
        raise UsageError('api_id must be a number (from my.telegram.org)')
    api_hash = str(api_hash or '').strip().lower()
    if api_id <= 0 or not _HEX32.fullmatch(api_hash):
        raise UsageError('api_id must be a positive number and api_hash 32 hex characters (from my.telegram.org)')
    return api_id, api_hash


# =============================================================================================== the guard

# Allowlists: Telethon request classes (module.ClassName). Everything else is refused. Wrappers are unwrapped and
# their inner request is checked; MTProto service requests (keep-alive pings) are allowed only below the client layer.
READ_BASE = (
    'help.GetConfigRequest',                # connect(): sent inside InitConnection; DC options
    'updates.GetStateRequest',              # connect()/_on_login, is_user_authorized()
    'updates.GetDifferenceRequest',         # connect()/_on_login, update loop
    'updates.GetChannelDifferenceRequest',  # update loop for channels seen in dialogs
    'users.GetUsersRequest',                # get_me(), entity lookup
    'users.GetFullUserRequest',             # read a user's profile (allowed, unused by tgread itself)
    'messages.GetDialogsRequest',           # iter_dialogs()
    'messages.GetHistoryRequest',           # iter_messages() / get_messages()
    'messages.GetMessagesRequest',          # get_messages(ids=...) in private chats and basic groups
    'messages.GetChatsRequest',             # entity lookup (basic groups)
    'channels.GetMessagesRequest',          # get_messages(ids=...) in channels/supergroups
    'channels.GetChannelsRequest',          # entity lookup (channels)
    'channels.GetFullChannelRequest',       # member count for skip_*_over_members
)
LOGIN_EXTRA = (                             # only during `tgread login-qr`
    'auth.ExportLoginTokenRequest',         # create the QR token (this new device asks to be authorized)
    'auth.ImportLoginTokenRequest',         # finish the QR login after a DC migration
    'account.GetPasswordRequest',           # 2FA: SRP parameters + hint
    'auth.CheckPasswordRequest',            # 2FA: password proof
)
DOWNLOAD_EXTRA = (                          # only during `tgread download`
    'upload.GetFileRequest',                # read file parts
    'auth.ExportAuthorizationRequest',      # files stored on another DC: export our own authorization ...
    'auth.ImportAuthorizationRequest',      # ... and import it on that DC's connection
)
WRAPPERS = ('InvokeWithLayerRequest', 'InitConnectionRequest', 'InvokeWithoutUpdatesRequest',
            'InvokeAfterMsgRequest', 'InvokeAfterMsgsRequest')
MTPROTO_SERVICE = ('PingRequest', 'PingDelayDisconnectRequest')
# 'live' (`tgread live`, 2026-10-13): exactly the read allowlist. The only difference is receive_updates=True:
# Telethon's update loop runs (updates.GetState/GetDifference/GetChannelDifference, already allowed) and Telegram
# pushes new messages. No new request type, no high-level method unblocked (run_until_disconnected, catch_up and
# set_receive_updates stay blocked: `tgread live` waits on its own loop and catches gaps with the regular sync).
PROFILES = {'read': READ_BASE, 'login': READ_BASE + LOGIN_EXTRA, 'download': READ_BASE + DOWNLOAD_EXTRA,
            'live': READ_BASE}

# High-level methods that can never be used (the request guard would refuse them anyway; this fails earlier).
BLOCKED_METHODS = (
    'send_message', 'send_file', 'send_read_acknowledge', 'edit_message', 'delete_messages', 'forward_messages',
    'pin_message', 'unpin_message', 'action', 'edit_admin', 'edit_permissions', 'kick_participant', 'delete_dialog',
    'edit_folder', 'upload_file', 'log_out', 'sign_up', 'send_code_request', 'edit_2fa', 'inline_query',
    'conversation', 'takeout', 'end_takeout', 'start', 'set_proxy', 'catch_up', 'set_receive_updates',
    'run_until_disconnected', 'get_participants', 'iter_participants', 'get_admin_log', 'iter_admin_log',
    'get_stats', 'get_permissions', 'get_drafts', 'iter_drafts', 'get_profile_photos', 'iter_profile_photos',
    'download_profile_photo', 'build_reply_markup',
)


class _Guard:
    def __init__(self):
        self.profile = 'read'
        self.allowed = {}          # profile -> frozenset of request classes
        self.wrappers = frozenset()
        self.service = frozenset()
        self.blocked = []          # (layer, name) refused in this process


GUARD = _Guard()
_TL = None


def tl_name(cls):
    mod = cls.__module__.rsplit('.', 1)[-1]
    return cls.__name__ if mod == 'functions' else f'{mod}.{cls.__name__}'


def check_request(req, layer):
    """Raise ReadOnlyViolation unless req (or every item of a list) is allowlisted for the current profile."""
    if isinstance(req, (list, tuple)):
        for r in req:
            check_request(r, layer)
        return
    inner, depth = req, 0
    while type(inner) in GUARD.wrappers and depth < 8:
        inner, depth = getattr(inner, 'query', None), depth + 1
    t = type(inner)
    if t in GUARD.allowed.get(GUARD.profile, ()) or (layer != 'client' and t in GUARD.service):
        return
    name = tl_name(t) if inner is not None else 'an empty wrapper'
    GUARD.blocked.append((layer, name))
    log.error('GUARD BLOCKED %s at the %s layer (profile %s)', name, layer, GUARD.profile)
    raise ReadOnlyViolation(f'tgread is strictly read-only: {name} is not on the {GUARD.profile} allowlist '
                            f'({layer} layer); nothing was sent')


def _check_state(state):
    """Wire layer: every encrypted message passes MessagePacker. Non-requests (MsgsAck, MsgsStateInfo) carry no API
    call; pings are allowed; everything else must be allowlisted and its bytes must belong to that object."""
    from telethon.tl.tlobject import TLRequest
    req = state.request
    if not isinstance(req, TLRequest) or type(req) in GUARD.service:
        return
    if bytes(state.data[:4]) != struct.pack('<I', req.CONSTRUCTOR_ID):
        GUARD.blocked.append(('wire', 'payload mismatch'))
        log.error('GUARD BLOCKED a payload that does not match its request object (%s)', tl_name(type(req)))
        raise ReadOnlyViolation('tgread guard: serialized payload does not match the request object; nothing sent')
    check_request(req, 'wire')


def _telethon():
    """Import the pinned Telethon once and install the guard before any client can exist."""
    global _TL
    if _TL is not None:
        return _TL
    import telethon
    if telethon.__version__ != TELETHON_PIN:
        raise TgreadError(f'Telethon {telethon.__version__} is installed but tgread is pinned to {TELETHON_PIN}. '
                          f'Re-check the guard against the new version, then update TELETHON_PIN and '
                          f'~/opt/tgread-requirements.txt and run ~/opt/tgread-tests/run.sh')
    from telethon import TelegramClient, errors, events, functions, types, utils
    from telethon.extensions.messagepacker import MessagePacker
    from telethon.network.mtprotosender import MTProtoSender
    from telethon.sessions import MemorySession
    from telethon.tl.tlobject import TLRequest

    def resolve(name):  # AttributeError = the TL schema changed under us -> crash, never run half-guarded
        mod, _, cls = name.rpartition('.')
        return getattr(getattr(functions, mod) if mod else functions, cls)

    GUARD.allowed = {p: frozenset(resolve(n) for n in names) for p, names in PROFILES.items()}
    GUARD.wrappers = frozenset(resolve(n) for n in WRAPPERS)
    GUARD.service = frozenset(resolve(n) for n in MTPROTO_SERVICE)

    orig_send, orig_append, orig_extend = MTProtoSender.send, MessagePacker.append, MessagePacker.extend

    def guarded_send(self, request, ordered=False):          # layer 2: also catches connect()'s InitConnection
        check_request(request, 'sender')                     # and exported (other-DC) senders, which bypass _call
        return orig_send(self, request, ordered=ordered)

    def guarded_append(self, state):                         # layer 3: the wire
        _check_state(state)
        return orig_append(self, state)

    def guarded_extend(self, states):
        states = list(states)
        for s in states:
            _check_state(s)
        return orig_extend(self, states)

    for f in (guarded_send, guarded_append, guarded_extend):
        f._tgread_guard = True
    MTProtoSender.send = guarded_send
    MessagePacker.append = guarded_append
    MessagePacker.extend = guarded_extend

    class GuardedClient(TelegramClient):
        async def _call(self, sender, request, ordered=False, flood_sleep_threshold=None):   # layer 1
            check_request(request, 'client')
            return await super()._call(sender, request, ordered=ordered, flood_sleep_threshold=flood_sleep_threshold)

        async def qr_login(self, ignored_ids=None):
            if GUARD.profile != 'login':
                raise ReadOnlyViolation('qr_login is only allowed inside `tgread login-qr`')
            return await super().qr_login(ignored_ids)

        async def sign_in(self, phone=None, code=None, *, password=None, bot_token=None, phone_code_hash=None):
            if GUARD.profile != 'login' or phone or code or bot_token or phone_code_hash or not password:
                raise ReadOnlyViolation('only the 2FA password step of `tgread login-qr` may sign in')
            return await super().sign_in(password=password)

    def blocker(name):
        def blocked(self, *a, **kw):
            GUARD.blocked.append(('method', name))
            log.error('GUARD BLOCKED method %s()', name)
            raise ReadOnlyViolation(f'tgread is strictly read-only: {name}() is disabled; nothing was sent')
        blocked.__name__ = name
        return blocked

    for name in BLOCKED_METHODS:
        setattr(GuardedClient, name, blocker(name))

    _TL = SimpleNamespace(telethon=telethon, TelegramClient=TelegramClient, GuardedClient=GuardedClient,
                          errors=errors, events=events, functions=functions, types=types, utils=utils,
                          MTProtoSender=MTProtoSender,
                          MessagePacker=MessagePacker, TLRequest=TLRequest, MemorySession=MemorySession)
    return _TL


def guards_installed():
    TL = _telethon()
    return all(getattr(f, '_tgread_guard', False)
               for f in (TL.MTProtoSender.send, TL.MessagePacker.append, TL.MessagePacker.extend))


class ReadOnlyTelegram:
    """The only door to Telegram: a handful of read calls. The guard enforces read-only below this class anyway."""

    def __init__(self, api_id, api_hash, *, profile='read', session=None, receive_updates=False,
                 flood_sleep_threshold=120):
        TL = _telethon()
        if profile not in PROFILES:
            raise ValueError(f'unknown guard profile {profile!r}')
        if not guards_installed():
            raise ReadOnlyViolation('the guard patches are missing; refusing to create a Telegram client')
        GUARD.profile = profile
        self.profile = profile
        self._receive_updates = receive_updates
        self._c = TL.GuardedClient(
            session if session is not None else str(SESSION_PATH), api_id, api_hash,
            device_model=DEVICE_MODEL, system_version=SYSTEM_VERSION, app_version=f'tgread {VERSION}',
            lang_code='en', system_lang_code='en', receive_updates=receive_updates, catch_up=False,
            flood_sleep_threshold=flood_sleep_threshold, request_retries=3, connection_retries=3, retry_delay=2,
            auto_reconnect=True)

    async def connect(self):
        await self._c.connect()
        if not self._receive_updates:
            # sync/download need no updates: stop Telethon's update loop so it never starts background
            # updates.getDifference / getChannelDifference calls during long runs (keep-alive pings continue)
            h = getattr(self._c, '_updates_handle', None)
            if h is not None:
                h.cancel()
                try:
                    await h
                except BaseException:
                    pass
                self._c._updates_handle = None

    async def disconnect(self):
        r = self._c.disconnect()
        if asyncio.iscoroutine(r):
            await r

    async def is_authorized(self):
        return await self._c.is_user_authorized()

    def is_connected(self):
        return self._c.is_connected()

    def on_new_message(self, callback):
        """`tgread live` only: await callback(event) for every new message Telegram pushes (receive-only)."""
        if self.profile != 'live' or not self._receive_updates:
            raise ReadOnlyViolation('live updates are only allowed in `tgread live`')
        self._c.add_event_handler(callback, _telethon().events.NewMessage())

    async def get_me(self):
        return await self._c.get_me()

    def iter_dialogs(self):
        return self._c.iter_dialogs()

    def iter_messages(self, entity, **kw):
        return self._c.iter_messages(entity, **kw)

    async def get_messages(self, entity, **kw):
        return await self._c.get_messages(entity, **kw)

    async def get_input_entity(self, peer):
        return await self._c.get_input_entity(peer)

    async def channel_members(self, entity):
        full = await self._c(_telethon().functions.channels.GetFullChannelRequest(entity))
        return getattr(full.full_chat, 'participants_count', None)

    async def download_media(self, message, path):
        if self.profile != 'download':
            raise ReadOnlyViolation('downloads are only allowed in `tgread download`')
        return await self._c.download_media(message, file=path)

    async def qr_login(self):
        return await self._c.qr_login()

    async def password_hint(self):
        pwd = await self._c(_telethon().functions.account.GetPasswordRequest())
        return getattr(pwd, 'hint', None)

    async def sign_in_password(self, password):
        return await self._c.sign_in(password=password)



def maybe_sync(args, cfg, db):
    """--sync on message commands: a short incremental sync first; failures only print a note."""
    if not getattr(args, 'sync', False):
        return
    try:
        api = load_creds()
        if not SESSION_PATH.exists():
            raise NotAuthorized('not logged in yet')
        with Lock(wait=90) as lk:
            if not lk.ok:
                print('note: another sync is running; showing the data of the last completed sync')
                return
            sync_once(db, cfg, api, max_seconds=120, quiet=True)
    except ReadOnlyViolation:

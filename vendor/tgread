def cmd_summarize(args):
    """Summary written by the LOCAL LLM (`llm-local --summary`: it anonymizes first, then summarizes). No fallback:
    without the local LLM this exits 6."""
    cfg = load_config()
    db = open_db()
    maybe_sync(args, cfg, db)
    since, until, span = _span(args)
    chat_id, picked = _picked_chats(db, cfg, args)
    if not cfg['use_local_llm']:
        raise LLMUnavailable('summarize needs the local LLM, but use_local_llm is false in the config')
    exe = llm_command(cfg)
    rows = _window_rows(db, since, include_read=not args.unread, include_muted=args.include_muted,
                        include_archived=args.include_archived, chat_id=chat_id, until=until, chat_ids=picked)
    rows, total = _cap_per_chat(rows, args.per_chat)
    if not rows:
        print(f'No messages to summarize {span} ({_sync_age_note(db)}).')
        return EXIT_OK
    pr = Presenter(db, 'real', focus_ids(rows), chat_ids(rows))
    blocks = blocks_by_chat(rows, chat_map(db), pr, 0 if args.full else 2000,
                            None if args.no_counts else _unread_extra(total))
    if args.no_counts:     # the vault's chunked summaries: the same messages give the same text (anonymization cache)
        head = (f"# Telegram messages{' (unread only)' if args.unread else ''}, grouped by chat; times "
                f'Europe/Zurich; "You" is the owner.')
    else:
        head = (f"# Telegram messages from the last {args.hours:g} h{' (unread only)' if args.unread else ''}, "
                f'grouped by chat; times Europe/Zurich; "You" is the owner.')
    strict = llm_strict(cfg['local_llm_summary_args'])
    text = head + '\n\n' + '\n\n'.join(mask_text(b.text(), addresses=strict) for b in blocks)
    llm_gate(text, cfg, args, 'summarizer')
    shield = IdShield()
    res = shield.restore(run_llm(exe, list(cfg['local_llm_summary_args']) + _owner_args(pr), shield.hide(text), cfg))
    print(mask_text(f"Summary of {len(rows)} message(s) in {len(blocks)} chat(s), {span.replace('in the ', '')} "
                    f"({_sync_age_note(db)}):"))
    print()
    res = mask_text(res, addresses=strict)
    print(mask_text(pr.scrub_leftovers(res) if strict else res, addresses=strict))
    print('\n(summary by the local LLM from anonymized text; regex masks applied before and after)')
    return EXIT_OK


def _span(args):
    """(since, until, words) of a summarize/window call: --since/--until (dates, '7d', '@epoch') or --hours."""
    until = parse_when(args.until) if getattr(args, 'until', None) else None
    if getattr(args, 'since', None):
        since = parse_when(args.since)
        words = f'since {fmt_ts(since)}' + (f' until {fmt_ts(until)}' if until else '')
    else:
        since = now_ts() - args.hours * 3600
        words = f'in the last {args.hours:g} h' + (f' until {fmt_ts(until)}' if until else '')
    if until is not None and until <= since:
        raise UsageError('--until must be after the start of the window')
    return since, until, words


def _picked_chats(db, cfg, args):
    """--chat X -> (chat_id, None); --chats A B -> (None, {ids}); neither -> (None, None)."""
    if getattr(args, 'chat', None) and getattr(args, 'chats', None):
        raise UsageError('give --chat or --chats, not both')
    pr = config_presenter(db, cfg)
    if getattr(args, 'chat', None):
        return resolve_chat(db, args.chat, pr)['chat_id'], None
    if getattr(args, 'chats', None):
        return None, {resolve_chat(db, c, pr)['chat_id'] for c in args.chats}
    return None, None


def cmd_window(args):
    """Size of a summary window, per chat: message and character counts per chat and per day (Europe/Zurich), the
    unread count and first/last message time. Ids and numbers only: no text, no chat or sender names. The vault
    plans its chunked summaries from this (plan v2 #4)."""
    cfg = load_config()
    db = open_db()
    maybe_sync(args, cfg, db)
    since, until, span = _span(args)
    chat_id, picked = _picked_chats(db, cfg, args)
    rows = _window_rows(db, since, include_read=not args.unread, include_muted=args.include_muted,
                        include_archived=args.include_archived, chat_id=chat_id, until=until, chat_ids=picked)
    rows, total = _cap_per_chat(rows, args.per_chat)
    chats, info = {}, chat_map(db)
    for r in rows:
        c = chats.setdefault(r['chat_id'], {'chat_id': r['chat_id'], 'msgs': 0, 'chars': 0, 'first_ts': r['ts'],
                                            'last_ts': r['ts'], 'days': {}})
        n = len(r['text'] or '') + 40                  # the line as the LLM sees it: time, sender, refs
        c['msgs'] += 1
        c['chars'] += n
        c['first_ts'], c['last_ts'] = min(c['first_ts'], r['ts']), max(c['last_ts'], r['ts'])
        day = dt.datetime.fromtimestamp(r['ts'], TZ).date().isoformat()
        d = c['days'].setdefault(day, {'day': day, 'msgs': 0, 'chars': 0})
        d['msgs'] += 1
        d['chars'] += n
    out = []
    for cid in sorted(chats, key=lambda k: chats[k]['last_ts'], reverse=True):     # like summarize: newest first
        c = chats[cid]
        c['days'] = [c['days'][k] for k in sorted(c['days'])]
        c['total'] = total.get(cid, c['msgs'])         # before --per-chat
        c['chat_id'] = str(cid)                        # a string: a regex net that masks long numbers keeps the JSON
        c['unread'] = int((info.get(cid) or {}).get('unread_count') or 0)
        out.append(c)
    print(json.dumps({'since': int(since), 'until': int(until) if until is not None else None, 'span': span,
                      'sync': _sync_age_note(db), 'msgs': len(rows), 'chars': sum(c['chars'] for c in out),
                      'chats': out}, ensure_ascii=False))
    return EXIT_OK


def cmd_chats(args):
    cfg = load_config()
    db = open_db()
    ps = cfg['pseudonymize_names'] if args.pseudonyms is None else args.pseudonyms
    # group titles often hold members' names ("Geburtstag Lisa"): posters of small groups count as close people
    pr = Presenter(db, 'raw' if args.raw else ('alias' if ps else 'real'),
                   focus_chats=[r[0] for r in db.execute('SELECT chat_id FROM chats WHERE chat_id < 0')])
    rows = db.execute('SELECT c.*, COUNT(m.id) AS n, MAX(m.ts) AS last FROM chats c LEFT JOIN messages m '
                      'ON m.chat_id = c.chat_id GROUP BY c.chat_id '
                      'ORDER BY COALESCE(c.top_ts, MAX(m.ts), 0) DESC').fetchall()
    out = []
    for r in rows:
        c = dict(r)
        listed = c['in_dialogs'] and (c['status'] == 'sync' or c['status'].startswith('error'))
        if not args.all and not listed:
            continue
        if args.type and c['type'] != args.type:
            continue
        if args.grep and _norm(args.grep) not in _norm(c['title']) and _norm(args.grep) not in _norm(pr.chat_label(c)):
            continue
        flags = [f for f, on in (('muted', c['muted']), ('archived', c['archived']), ('pinned', c['pinned']),
                                 ('gone', not c['in_dialogs'])) if on]
        if c['status'] != 'sync':
            flags.append(c['status'])
        hist = 'complete' if c['history_done'] else (f"back to {fmt_ts(c['back_ts'])[:10]}" if c['back_ts'] else '-')
        label = pr.chat_label(c) if args.raw else mask_text(pr.chat_label(c))     # ids stay exact
        out.append(f"{c['chat_id']:>15}  {c['type']:<10} {label} · {c['n']} msgs · last "
                   f"{fmt_ts(c['last'] or c['top_ts'])} · unread {c['unread_count']} · history {hist}"
                   + (f" · {', '.join(flags)}" if flags else ''))
    head = (f"{len(out)} chat(s) ({_sync_age_note(db)}); id, type, name, stored messages, last message, unread"
            + ('; private chats shown by stable alias' if pr.ps else '') + ':')
    if args.raw:
        log.warning('raw output used (chats)')
        print('RAW OUTPUT (exact names): only when the owner explicitly asked; never forward it.')
        print(head)
        print('\n'.join(out))
    else:
        print(mask_text(head))
        if out:
            print('\n'.join(out))
    return EXIT_OK


def cmd_exclude(args):
    cfg = load_config()
    db = open_db()
    pr = config_presenter(db, cfg)
    chats = chat_map(db)
    if args.action == 'list':
        if not cfg['exclude_chats']:
            print('No excluded chats. Add one: tgread exclude add "chat name or id"')
            return EXIT_OK
        print('Excluded chats (never fetched; stored messages deleted):')
        for sel in cfg['exclude_chats']:
            hits = [c for c in chats.values() if selector_matches(sel, c)]
            if hits:
                for c in hits:
                    print(f"  {c['chat_id']:>15}  {c['type']:<10} {mask_text(pr.chat_label(c))}")
            else:
                print(mask_text(f'  {sel!r} (not seen in a sync yet)'))
        return EXIT_OK
    changed = False
    for sel in args.chats:
        if args.action == 'add':
            try:
                chat = resolve_chat(db, sel, pr)
            except UsageError:
                if re.fullmatch(r'-?\d+', sel.strip()) or sel.strip().startswith('@'):
                    entry = int(sel) if re.fullmatch(r'-?\d+', sel.strip()) else sel.strip()
                    if entry not in cfg['exclude_chats']:
                        cfg['exclude_chats'].append(entry)
                        changed = True
                    print(mask_text(f'excluded {entry!r} (not in the archive yet; it will never be fetched)'))
                    continue
                raise
            if chat['chat_id'] not in cfg['exclude_chats']:
                cfg['exclude_chats'].append(chat['chat_id'])
                changed = True
            n = purge_chat_messages(db, chat['chat_id'])
            db.execute("UPDATE chats SET status='excluded' WHERE chat_id=?", (chat['chat_id'],))
            db.execute('DELETE FROM chat_aliases WHERE chat_id=?', (chat['chat_id'],))
            db.commit()
            print(f"excluded {mask_text(pr.chat_label(chat))} ({chat['type']}, chat {chat['chat_id']}); "
                  f'deleted {n} stored message(s); it will never be fetched again')
        else:
            before = list(cfg['exclude_chats'])
            target = None
            try:
                target = resolve_chat(db, sel, pr)
            except UsageError:
                pass
            cfg['exclude_chats'] = [e for e in cfg['exclude_chats']
                                    if not (str(e).strip().casefold() == sel.strip().casefold()
                                            or (target is not None and selector_matches(e, target)))]
            if cfg['exclude_chats'] == before:
                raise UsageError(f'{sel!r} is not on the exclude list (see: tgread exclude list)')
            changed = True
            if target is not None:
                db.execute("UPDATE chats SET status='sync' WHERE chat_id=?", (target['chat_id'],))
                db.commit()
            print(mask_text(f'removed {sel!r} from the exclude list; the next sync fetches it again'))
    if changed:
        save_config(cfg)
    return EXIT_OK


def cmd_purge(args):

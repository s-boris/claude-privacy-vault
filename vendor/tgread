def _letters(n):
    s, n = '', n + 1
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s


def _name_tokens(s):
    """'Anna-Lena Muster 🌸' -> ['Anna-Lena', 'Anna', 'Lena', 'Muster']; 'Sarah92' -> ['Sarah92', 'Sarah']"""
    out = []
    for w in _WORD_RE.findall(s or ''):
        out.append(w)
        if '-' in w or any(c.isdigit() for c in w):
            out += [p for p in _ALPHA_RE.findall(w) if p != w]
    return out


def _alpha_words(words):
    """['Climber1', 'Fels'] -> ['Climber', 'Fels'] (digits dropped; empty parts skipped)"""
    return [x for x in (''.join(_ALPHA_RE.findall(w)) for w in words) if x]


class Presenter:
    """How chats, senders and text are shown.
    mode 'alias': tgread's stable aliases "Person A/B/..." (local table aliases), the owner "You", known names in
                  text replaced. Used when the local LLM is unavailable and for `chats` (pseudonymize_names).
    mode 'real':  exact names (the owner still "You"): the input for the LOCAL LLM, which anonymizes it.
    mode 'raw':   exact names (--raw).
    scrub_leftovers(): after the local LLM in --strict mode, any known person name it missed becomes [NAME] (the
                  owner "You"). llm-local's default policy keeps names, so it isn't applied then."""

    SMALL_CHAT_POSTERS = 100

    def __init__(self, db, mode='alias', focus_ids=(), focus_chats=()):
        if mode not in ('alias', 'real', 'raw'):
            raise ValueError(f'unknown presenter mode {mode!r}')
        self.db, self.mode = db, mode
        self.ps = mode == 'alias'
        self.me_id = int(meta_get(db, 'me_id') or 0)
        self.me_first = meta_get(db, 'me_first') or ''
        self.me_last = meta_get(db, 'me_last') or ''
        self.me_username = meta_get(db, 'me_username') or ''
        self.focus = {int(x) for x in focus_ids if x}
        self.focus_chats = {int(x) for x in focus_chats if x}
        self._vocab = None

    def _small_chat_posters(self):
        """Everyone who ever posted in the group chats of this output, since members mention each other by first
        name. A chat with more than SMALL_CHAT_POSTERS posters is a community, not a circle: skipped (its members'
        names are often ordinary words)."""
        out = set()
        for cid in self.focus_chats:
            if cid > 0:
                continue
            ids = [r[0] for r in self.db.execute(
                'SELECT DISTINCT sender_id FROM messages WHERE chat_id=? AND sender_id > 0 LIMIT ?',
                (cid, self.SMALL_CHAT_POSTERS + 1))]
            if len(ids) <= self.SMALL_CHAT_POSTERS:
                out.update(ids)
        return out

    def owner_name(self):
        return ' '.join(x for x in (self.me_first, self.me_last) if x) or None

    def alias(self, key):
        r = self.db.execute('SELECT alias FROM aliases WHERE key=?', (key,)).fetchone()
        if r:
            return r[0]
        for _ in range(20):
            idx = self.db.execute('SELECT COALESCE(MAX(idx), -1) + 1 FROM aliases').fetchone()[0]
            try:
                self.db.execute('INSERT INTO aliases(key, idx, alias, created_ts) VALUES (?, ?, ?, ?)',
                                (key, idx, f'Person {_letters(idx)}', int(time.time())))
                self.db.commit()
                return f'Person {_letters(idx)}'
            except sqlite3.IntegrityError:
                r = self.db.execute('SELECT alias FROM aliases WHERE key=?', (key,)).fetchone()
                if r:
                    return r[0]
        raise TgreadError('could not allocate a pseudonym')

    def is_bot(self, uid):
        r = self.db.execute('SELECT is_bot FROM people WHERE user_id=?', (uid,)).fetchone()
        return bool(r and r[0])

    def chat_label(self, chat):
        t = chat.get('type')
        if t == 'self':
            return 'Saved Messages'
        if not self.ps:
            return chat.get('title') or '?'
        if t == 'user':
            return self.alias(f"u:{chat['chat_id']}")
        return self.scrub(chat.get('title') or '?')

    def sender_label(self, r, chat=None):
        if r['out'] or (self.me_id and r['sender_id'] == self.me_id):
            return 'You'
        sid = r['sender_id']
        if not self.ps:
            return r['sender_name'] or (chat.get('title') if chat else None) or '?'
        if sid is None:
            if chat and chat.get('type') == 'user':
                return self.alias(f"u:{chat['chat_id']}")
            return 'Unknown'
        if sid > 0:
            if self.is_bot(sid):
                return self.scrub(r['sender_name'] or 'a bot')
            return self.alias(f'u:{sid}')
        return self.scrub(r['sender_name'] or '?')          # a channel / group posting as itself

    def fwd_label(self, r):
        fid, name = r['fwd_from_id'], r['fwd_from']
        if not self.ps:
            return name or 'hidden'
        if fid is not None and fid > 0:
            return 'You' if fid == self.me_id else self.alias(f'u:{fid}')
        if fid is not None:
            return self.scrub(name or 'a channel')
        return self.alias('n:' + _norm(name)) if name and name != 'hidden' else 'hidden'

    # ---- name replacement in free text
    def _build_vocab(self):
        """full: normalized 'first last' -> keys (all people); users: @username -> keys (all people);
        single: one name token -> keys, only for people close to this output (private-chat partners, senders and
        forward sources in it, posters of its small group chats, the owner), since single first names collide with
        ordinary words."""
        full, single, users = {}, {}, {}

        def put(d, k, key):
            if k:
                d.setdefault(k, set()).add(key)

        partners = {r[0] for r in self.db.execute("SELECT chat_id FROM chats WHERE type='user'")}
        close = self.focus | partners | self._small_chat_posters()

        def add(key, first, last, username, is_close):
            words = _WORD_RE.findall(' '.join(x for x in (first, last) if x))
            for ws in (words, _alpha_words(words)):
                if len(ws) >= 2:
                    put(full, _norm(' '.join(ws)), key)
                    put(full, _norm(ws[0] + ' ' + ws[-1]), key)
            if username:
                put(users, username.casefold(), key)
            if is_close:
                for t in _name_tokens(' '.join(x for x in (first, last) if x)):
                    if len(t) >= 3:
                        put(single, _norm(t), key)

        for p in self.db.execute('SELECT user_id, first_name, last_name, username, is_bot, is_self FROM people'):
            if p['is_bot']:
                continue
            me = bool(p['is_self']) or p['user_id'] == self.me_id
            add('self' if me else f"u:{p['user_id']}", p['first_name'], p['last_name'], p['username'],
                me or p['user_id'] in close)
        for c in self.db.execute("SELECT chat_id, title FROM chats WHERE type='user'"):
            add('self' if c['chat_id'] == self.me_id else f"u:{c['chat_id']}", c['title'], None, None, True)
        for a in self.db.execute("SELECT key FROM aliases WHERE key LIKE 'n:%'"):
            add(a['key'], a['key'][2:], None, None, True)
        add('self', self.me_first, self.me_last, self.me_username or None, True)
        url_tokens = {t for t in single if len(t) >= 4} | {u for u in users if len(u) >= 4}
        self._vocab = (full, single, users, url_tokens)
        return self._vocab

    def _label(self, keys, leftover):
        if keys == {'self'}:
            return 'You'
        if len(keys) != 1 or leftover or not self.ps:
            return '[NAME]'
        return self.alias(next(iter(keys)))

    def scrub(self, text):
        """alias mode: known person names -> stable aliases, the owner -> You, unknown @handles -> [USERNAME],
        links containing a known name -> [URL:host]."""
        if not text or not self.ps:
            return text
        return self._replace_names(text, leftover=False)

    def scrub_leftovers(self, text):
        """After the local LLM (any mode): known person names it missed -> [NAME], the owner -> You."""
        if not text:
            return text
        return self._replace_names(text, leftover=True)

    def _replace_names(self, text, leftover):
        vocab = self._vocab or self._build_vocab()
        out, last = [], 0
        for m in _URL_RE.finditer(text):
            s, e = _url_span(text, m)
            if s < last:
                continue
            out.append(self._names_plain(text[last:s], leftover, vocab))
            url = text[s:e]
            low = _norm(url)
            if any(t in low for t in vocab[3]):
                try:
                    host = (urlsplit(url if '://' in url else 'http://' + url).hostname or '').lower()
                except ValueError:
                    host = ''
                url = f'[URL:{host}]' if host else '[URL]'
            out.append(url)
            last = e
        out.append(self._names_plain(text[last:], leftover, vocab))
        return ''.join(out)

    def _names_plain(self, s, leftover, vocab):
        """Email addresses stay whole (the regex masks turn them into [EMAIL]); names elsewhere are replaced."""
        out, last = [], 0
        for m in EMAIL_RE.finditer(s):
            out.append(self._names_words(s[last:m.start()], leftover, vocab))
            out.append(m.group(0))
            last = m.end()
        out.append(self._names_words(s[last:], leftover, vocab))
        return ''.join(out)

    def _names_words(self, s, leftover, vocab):
        full, single, users, _ = vocab
        s = _MENTION_RE.sub(lambda m: self._label(users[m.group(0)[1:].casefold()], leftover)
                            if m.group(0)[1:].casefold() in users else '[USERNAME]', s)

        def find(d, phrase):
            """-> (keys, possessive suffix, matched normalized base) or (None, '', None)"""
            n = _norm(phrase)
            if n in d:
                return d[n], '', n
            for suf in ("'s", '’s', 's'):
                if phrase.endswith(suf) and len(phrase) - len(suf) >= 3:
                    b = _norm(phrase[:-len(suf)])
                    if b in d:
                        return d[b], "'s", b
            return None, '', None

        def label(keys, suf):
            lab = self._label(keys, leftover)
            return ('Your' if lab == 'You' else lab + suf) if suf else lab

        words = list(_WORD_RE.finditer(s))
        spans, i = [], 0
        while i < len(words):
            hit = None
            for n in (3, 2):                                    # full names first
                seg = words[i:i + n]
                if len(seg) == n and all(s[a.end():b.start()] in _NAME_GAP for a, b in zip(seg, seg[1:])):
                    keys, suf, _ = find(full, s[seg[0].start():seg[-1].end()])
                    if keys:
                        hit = (seg[0].start(), seg[-1].end(), label(keys, suf), n)
                        break
            if hit:
                spans.append(hit[:3])
                i += hit[3]
                continue
            w = words[i]
            tok = w.group(0)
            keys, suf, base = find(single, tok)
            if keys and (base not in COMMON_NAME_WORDS or tok[:1].isupper()):
                spans.append((w.start(), w.end(), label(keys, suf)))
            elif '-' in tok or any(c.isdigit() for c in tok):  # Anna-Lena, Sarah92: replace the known part(s)
                for pm in _ALPHA_RE.finditer(tok):
                    part = pm.group(0)
                    k2, suf2, b2 = find(single, part) if len(part) >= 3 else (None, '', None)
                    if k2 and (b2 not in COMMON_NAME_WORDS or part[:1].isupper()):
                        spans.append((w.start() + pm.start(), w.start() + pm.end(), label(k2, suf2)))
            i += 1
        if not spans:
            return s
        out, last = [], 0
        for a, b, rep in spans:
            out.append(s[last:a])
            out.append(rep)
            last = b
        out.append(s[last:])
        return ''.join(out)


# =============================================================================================== rendering

class Block:
    """One chat's slice of output: a header line + message lines. private=False only for public broadcast channels
    (with llm_skip_public_channels they skip the local anonymizer: regex masks only)."""

    def __init__(self, header, lines, private=True):
        self.header, self.lines, self.private = header, lines, private

    def text(self):
        return '\n'.join([self.header] + self.lines)


def is_private_chat(chat):
    return not (chat.get('type') == 'channel' and chat.get('username'))


def chat_header(chat, pr, extra=''):
    return f"### {pr.chat_label(chat)} ({chat.get('type', '?')}, chat {chat['chat_id']}){extra}"


def fmt_line(r, pr, chat=None, max_text=2000, hit=False):
    """'[2026-10-10 18:02] Sender: text [photo; edited] (#123 reply to #120)' - the '[time] Name: ' prefix is
    also what llm-local recognizes as a chat log."""
    who = pr.sender_label(r, chat)
    if r['service']:
        body = f"[service: {r['service']}]"
    else:
        body = pr.scrub(r['text'] or '')
        if max_text and len(body) > max_text:
            body = body[:max_text].rstrip() + f' … [+{len(body) - max_text} chars]'
    extras = []
    if r['fwd_from'] or r['fwd_from_id']:
        extras.append(f'forwarded from {pr.fwd_label(r)}')
    if r['media_type']:
        md = pr.scrub(r['media_desc']) if r['media_desc'] else ''
        extras.append(r['media_type'] + (f': {md}' if md else ''))
    if r['edit_ts']:
        extras.append('edited')
    lines = body.split('\n') if body else ['']
    text = f"[{fmt_ts(r['ts'])}] {who}: " + lines[0] + ''.join('\n    ' + x for x in lines[1:])
    ref = f"#{r['msg_id']}" + (f" reply to #{r['reply_to']}" if r['reply_to'] else '')
    return (text + (' [' + '; '.join(extras) + ']' if extras else '') + f' ({ref})'
            + ('  <== match' if hit else ''))


def chat_map(db):
    return {r['chat_id']: dict(r) for r in db.execute('SELECT * FROM chats')}


def focus_ids(rows):
    """People close to an output: senders, forward sources and private-chat partners in these rows."""
    ids = set()
    for r in rows:
        for x in (r['sender_id'], r['fwd_from_id'], r['chat_id']):
            if x and x > 0:
                ids.add(x)
    return ids


def chat_ids(rows):
    return {r['chat_id'] for r in rows}


def blocks_by_chat(rows, chats, pr, max_text, header_extra=None):
    groups = {}
    for r in rows:
        groups.setdefault(r['chat_id'], []).append(r)
    out = []
    for cid in sorted(groups, key=lambda c: max(x['ts'] for x in groups[c]), reverse=True):
        chat = chats.get(cid) or {'chat_id': cid, 'type': '?', 'title': '?', 'username': None}
        msgs = sorted(groups[cid], key=lambda x: (x['ts'], x['msg_id']))
        extra = header_extra(chat, msgs) if header_extra else ''
        out.append(Block(chat_header(chat, pr, extra), [fmt_line(x, pr, chat, max_text) for x in msgs],
                         private=is_private_chat(chat)))
    return out


# =============================================================================================== local LLM

def llm_command(cfg):
    raw = (cfg.get('local_llm_cmd') or '').strip()
    if not raw:
        raise LLMUnavailable('local_llm_cmd is empty in the config')
    exe = str(HOME / raw[2:]) if raw.startswith('~/') else raw
    if not os.path.isabs(exe):
        exe = shutil.which(exe) or exe
    if not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
        raise LLMUnavailable(f'{raw} is not installed or not executable')
    return exe


def run_llm(exe, args, text, cfg):
    """One call of the local LLM command: text on stdin, answer on stdout. Its stderr is never printed raw."""
    try:
        p = subprocess.run([exe] + list(args), input=text, capture_output=True, text=True,
                           timeout=cfg['local_llm_timeout_seconds'])
    except subprocess.TimeoutExpired:
        raise LLMUnavailable(f'{Path(exe).name} timed out after {cfg["local_llm_timeout_seconds"]} s')
    except OSError as e:
        raise LLMUnavailable(f'cannot run {Path(exe).name}: {e.strerror}')
    if p.returncode != 0:
        first = (p.stderr or '').strip().splitlines()[-1:]
        raise LLMUnavailable(f'{Path(exe).name} exited with {p.returncode}'
                             + (f': {mask_text(first[0])[:160]}' if first else ''))
    res = (p.stdout or '').strip()
    if not res:
        raise LLMUnavailable(f'{Path(exe).name} returned nothing')
    return res


def llm_gate(text, cfg, args, what):
    """Before a local LLM call (CPU, slow): refuse oversized input, else print a time estimate on stderr."""
    n = len(text)
    limit = getattr(args, 'llm_max_chars', None) or cfg['local_llm_max_chars']
    # measured 2026-10-10 (CPU, Qwen3.5-9B): ~30 s per call + ~20 s per 1000 chars (more with many names);
    # a summary adds ~2 min of generation
    est = 30 + n / 1000 * cfg['local_llm_seconds_per_kchar'] + (120 if what == 'summarizer' else 0)
    est_s = f'~{max(1, round(est / 60))} min' if est >= 90 else f'~{max(1, int(est))} s'
    if n > limit:
        raise UsageError(f'{n} characters is too much for the local LLM {what} (limit {limit}; it would take '
                         f'{est_s}). Narrow the request (--chat, --hours, -n, --per-chat), or raise the limit for '
                         f'this call with --llm-max-chars N and run it in the background.')
    eprint(f'tgread: local LLM {what}: {n} characters, expect {est_s}')


def _owner_args(pr):
    name = pr.owner_name()
    return ['--owner-name', name] if name else []


def llm_strict(llm_args):
    """llm-local's --strict (old policy: names aliased, addresses masked) -> tgread masks addresses and runs the
    [NAME] net too. Default (policy v2): names and addresses stay; llm-local redacts intimate passages."""
    return '--strict' in llm_args


class IdShield:
    """Chat ids in '### label (type, chat ID)' headers and message refs '(#123 reply to #120)' -> short placeholders
    before the local LLM call, restored after it (2026-10-13): the anonymizer can no longer turn an id into [phone].
    The ids are Telegram-internal (`chats` shows them anyway)."""
    HEAD = re.compile(r'(?m)^(### [^\n]*\(\w+, chat )(-?\d+)\)')
    REF = re.compile(r'\(#(\d+)(?: reply to #(\d+))?\)')

    def __init__(self):
        self.chats, self.msgs = {}, {}

    @staticmethod
    def _slot(d, v):
        return d.setdefault(v, len(d) + 1)

    def hide(self, text):
        text = self.HEAD.sub(lambda m: f'{m[1]}C{self._slot(self.chats, m[2])})', text)
        return self.REF.sub(lambda m: f'(#M{self._slot(self.msgs, m[1])}'
                            + (f' reply to #M{self._slot(self.msgs, m[2])}' if m[2] else '') + ')', text)

    def restore(self, text):
        chats = {v: k for k, v in self.chats.items()}
        msgs = {v: k for k, v in self.msgs.items()}

        def head(m):
            cid = chats.get(int(m[2]))
            return f'{m[1]}{cid})' if cid else m[0]

        def ref(m):
            a, b = msgs.get(int(m[1])), (msgs.get(int(m[2])) if m[2] else None)
            if a is None or (m[2] and b is None):
                return m[0]
            return f'(#{a}' + (f' reply to #{b}' if m[2] else '') + ')'
        text = re.sub(r'(?m)^(### [^\n]*\(\w+, chat )C(\d+)\)', head, text)
        return re.sub(r'\(#M(\d+)(?: reply to #M(\d+))?\)', ref, text)


def anonymize_via_llm(blocks, cfg, pr, args=None):
    """Blocks rendered with exact names -> regex masks -> ONE `llm-local --anonymize` call for all private blocks
    (consistent within the call) -> regex masks again (with --strict also: addresses, and known names it missed ->
    [NAME]). Public broadcast channels skip the LLM (regex masks only) when llm_skip_public_channels."""
    exe = llm_command(cfg)
    strict = llm_strict(cfg['local_llm_anonymize_args'])
    skip = cfg['llm_skip_public_channels']
    private = [b for b in blocks if b.private or not skip]
    public = [b for b in blocks if not (b.private or not skip)]
    out = []
    if private:
        text = '\n\n'.join(mask_text(b.text(), addresses=strict) for b in private)
        llm_gate(text, cfg, args, 'anonymizer')
        shield = IdShield()
        llm_args = list(cfg['local_llm_anonymize_args'])
        if getattr(args, 'no_paraphrase', False):      # the vault's facts read (plan v2 #6): anonymized, not paraphrased
            llm_args = [a for a in llm_args if a != '--paraphrase']
        res = shield.restore(run_llm(exe, llm_args + _owner_args(pr), shield.hide(text), cfg))
        anon = mask_text(res, addresses=strict)
        if strict:
            anon = pr.scrub_leftovers(anon)
        parts = _split_blocks(anon)
        if public and parts is not None and len(parts) == len(private):     # keep the chats' original order
            it = iter(parts)
            return [next(it) if b in private else mask_text(b.text(), addresses=strict) for b in blocks]
        out.append(anon)
    out += [mask_text(b.text(), addresses=strict) for b in public]
    return out


def _split_blocks(text):
    """LLM output -> one string per '### ' chat block, or None if anything precedes the first header."""
    parts, cur = [], None
    for line in text.split('\n'):
        if line.startswith('### '):
            if cur is not None:
                parts.append('\n'.join(cur).strip('\n'))
            cur = [line]
        elif cur is None:
            if line.strip():
                return None
        else:
            cur.append(line)
    if cur is not None:
        parts.append('\n'.join(cur).strip('\n'))
    return parts


FOOTER_LLM = ('(private passages and identifiers removed by the local LLM; names and addresses kept as written. '
              'Regex masks applied before and after.)')
FOOTER_LLM_STRICT = ('(names and personal data anonymized by the local LLM; its "Person A/B" aliases hold for this '
                     'output only and are not --chat/--from selectors: use chat ids. Regex masks applied before and '
                     'after.)')
FOOTER_FALLBACK = '(tgread\'s stable aliases "Person A/B": valid as --chat/--from selectors. Regex masks applied.)'
FOOTER_LLM_PARA = ('(messages paraphrased in their own language by the local LLM after private passages and '
                   'identifiers were removed (policy v4.1); names, places, dates, times and numbers kept and checked in code, '
                   '"[not paraphrased]" lines kept as anonymized. Regex masks applied before and after.)')


def output_messages(args, cfg, intro, render):
    """The one exit for message content. render(mode) -> ([Block], Presenter) with mode 'real' (exact names, for the
    local LLM), 'alias' (stable pseudonyms, fallback) or 'raw'."""
    if args.raw:
        log.warning('raw output used (%s)', args.cmd)
        print('RAW OUTPUT (exact text, unmasked): only for an exact quote the owner explicitly asked for; '
              'never forward it.')
        for line in intro:
            print(line)
        for b in render('raw')[0]:
            print()
            print(b.text())
        return EXIT_OK
    texts, warning, addr = None, None, True
    if cfg['use_local_llm']:
        blocks, pr = render('real')
        if not blocks:
            for line in intro:
                print(mask_text(line))
            return EXIT_OK
        try:
            texts = anonymize_via_llm(blocks, cfg, pr, args)
            addr = llm_strict(cfg['local_llm_anonymize_args'])
        except LLMUnavailable as e:
            if not cfg['llm_fallback']:
                raise LLMUnavailable(f'{e}; nothing shown (llm_fallback is false in the config)')
            warning = f'WARNING: local LLM anonymizer unavailable ({e}); fallback: regex masking + pseudonyms.'
    else:
        warning = ('WARNING: the local LLM anonymizer is disabled (use_local_llm=false in the config); '
                   'fallback: regex masking + pseudonyms.')
    if texts is None:
        blocks, pr = render('alias')
        texts = [mask_text(b.text()) for b in blocks]
    if warning and texts:
        print(warning)
    for line in intro:
        print(mask_text(line))
    for t in texts:
        print()
        print(mask_text(t, addresses=addr))
    if texts:
        print()
        print(FOOTER_FALLBACK if warning else FOOTER_LLM_STRICT if addr
              else FOOTER_LLM_PARA if ('--paraphrase' in cfg['local_llm_anonymize_args']
                                       and not getattr(args, 'no_paraphrase', False)) else FOOTER_LLM)
    return EXIT_OK


# =============================================================================================== resolving

_ALIAS_RE = re.compile(r'(?i)\s*person\s+([a-z]{1,3})\s*')


def alias_key(name):
    return ' '.join(unicodedata.normalize('NFKC', str(name or '')).casefold().split())


def chat_alias_id(db, sel):
    """The chat id of one of my chat aliases (`tgread alias set`), or None."""
    k = alias_key(sel)
    r = db.execute('SELECT chat_id FROM chat_aliases WHERE name=?', (k,)).fetchone() if k else None
    return r[0] if r else None


def resolve_chat(db, sel, pr):
    rows = [dict(r) for r in db.execute('SELECT * FROM chats')]
    s = str(sel).strip()
    m = _ALIAS_RE.fullmatch(s)
    al = chat_alias_id(db, s)
    if al is not None:
        hits = [r for r in rows if r['chat_id'] == al]
    elif s.casefold() in ('me', 'self', 'saved', 'saved messages'):
        hits = [r for r in rows if r['type'] == 'self']
    elif re.fullmatch(r'-?\d+', s):
        hits = [r for r in rows if selector_matches(int(s), r)]
    elif m:
        a = db.execute('SELECT key FROM aliases WHERE alias=?', (f'Person {m[1].upper()}',)).fetchone()
        uid = int(a[0][2:]) if a and a[0].startswith('u:') else None
        hits = [r for r in rows if uid is not None and r['chat_id'] == uid]
    elif s.startswith('@'):
        hits = [r for r in rows if r['username'] and r['username'].casefold() == s[1:].casefold()]
    else:
        hits = [r for r in rows if _norm(r['title']) == _norm(s)] or \
               [r for r in rows if _norm(s) and _norm(s) in _norm(r['title'])]
    if not hits:
        raise UsageError(f'no chat matches {sel!r}; see `tgread chats` (ids work best)')
    if len(hits) > 1:
        names = '; '.join(f"{pr.chat_label(h)} ({h['type']}, chat {h['chat_id']})" for h in hits[:8])
        raise UsageError(f'{sel!r} matches {len(hits)} chats: {names}. Use the chat id.')
    return hits[0]


def resolve_senders(db, who):
    """-> (set of sender ids, outgoing: bool)."""
    w = str(who).strip()
    if w.casefold() in ('me', 'you', 'self', 'ich', 'owner'):
        return set(), True
    if re.fullmatch(r'-?\d+', w):
        return {int(w)}, False
    m = _ALIAS_RE.fullmatch(w)
    if m:
        a = db.execute('SELECT key FROM aliases WHERE alias=?', (f'Person {m[1].upper()}',)).fetchone()
        if a and a[0].startswith('u:'):
            return {int(a[0][2:])}, False
        raise UsageError(f'unknown alias {w!r}')
    ids = set()
    if w.startswith('@'):
        ids = {r[0] for r in db.execute('SELECT user_id FROM people WHERE lower(username)=lower(?)', (w[1:],))}
    else:
        nw = _norm(w)
        for r in db.execute('SELECT user_id, first_name, last_name, username FROM people WHERE is_self=0'):
            full = _norm(' '.join(x for x in (r['first_name'], r['last_name']) if x))
            if nw and (nw == full or nw in full.split() or (len(nw) >= 3 and nw in full)
                       or nw == _norm(r['username'])):
                ids.add(r['user_id'])
        for r in db.execute("SELECT chat_id, title FROM chats WHERE type IN ('user', 'bot')"):
            if nw and nw in _norm(r['title']):
                ids.add(r['chat_id'])
    if not ids:
        raise UsageError(f'no sender matches {who!r} (try a chat id from `tgread chats`)')
    return ids, False


def _sender_clause(db, who, where, params):
    ids, outgoing = resolve_senders(db, who)
    if outgoing:
        where.append('m.out = 1')
    else:
        where.append(f'm.sender_id IN ({",".join("?" * len(ids))}) AND m.out = 0')
        params.extend(sorted(ids))



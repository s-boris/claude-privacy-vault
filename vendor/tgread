def write_qr_png(url, path):
    import segno
    path = Path(path)
    if path.parent == DATA_DIR:
        ensure_private_dir(DATA_DIR)
    else:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = path.with_name(f'.{path.name}.tmp')
    segno.make(url, error='m').save(str(tmp), kind='png', scale=10, border=4)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


async def read_password_file(p, wait_s, say, poll=1.0):
    """The one-time 2FA file: must be private (0600, ours, no symlink); read once, shredded immediately."""
    end = time.monotonic() + wait_s
    last_size = None
    while time.monotonic() < end:
        if os.path.lexists(p):
            try:
                check_private_file(p, '2FA password file')
            except PermError as e:
                shred(p)
                say(f'PASSWORD_FILE_REJECTED reason="{e}" (deleted it; write it again with mode 0600)')
                last_size = None
                await asyncio.sleep(poll)
                continue
            size = os.lstat(p).st_size
            if size and size == last_size:                     # stable: the writer is done
                data = Path(p).read_bytes()
                shred(p)
                pw = data.decode('utf-8', 'replace').rstrip('\r\n')
                if pw:
                    return pw
            last_size = size
            await asyncio.sleep(min(poll, 0.3))
            continue
        await asyncio.sleep(poll)
    raise TgreadError('no 2FA password arrived in time; run login-qr again')


async def login_flow(tg, out_png, pwfile, timeout, say, *, password_stdin=False, pw_wait=300):
    """QR login. say() gets machine-readable lines for the assistant (QR_READY / QR_REFRESHED / PASSWORD_NEEDED ...)."""
    E = _telethon().errors
    if await tg.is_authorized():
        me = await tg.get_me()
        say(f'ALREADY_LOGGED_IN user_id={me.id} name={json.dumps(display_name(me))}')
        return me
    qr = await tg.qr_login()
    deadline = time.monotonic() + timeout
    attempt = 1

    def expires_in():
        return max(1, int((qr.expires - dt.datetime.now(dt.timezone.utc)).total_seconds()))

    write_qr_png(qr.url, out_png)
    say(f'QR_READY path={out_png} expires_in={expires_in()}s attempt=1 '
        f'(scan from another screen: Telegram app > Settings > Devices > Link Desktop Device)')
    user = None
    while user is None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            say('LOGIN_TIMEOUT (nobody scanned the QR code in time; run login-qr again)')
            raise TgreadError('QR login timed out')
        try:
            user = await qr.wait(timeout=max(1.0, min(remaining, expires_in())))
        except asyncio.TimeoutError:
            if deadline - time.monotonic() > 2:
                await qr.recreate()
                attempt += 1
                write_qr_png(qr.url, out_png)
                say(f'QR_REFRESHED path={out_png} expires_in={expires_in()}s attempt={attempt}')
        except E.SessionPasswordNeededError:
            user = await login_2fa(tg, pwfile, say, password_stdin=password_stdin, pw_wait=pw_wait)
        except (E.AuthTokenExpiredError, E.AuthTokenInvalidError, E.AuthTokenAlreadyAcceptedError) as e:
            if deadline - time.monotonic() <= 2:
                continue
            say(f'QR_ERROR reason={type(e).__name__}; regenerating')
            await qr.recreate()
            attempt += 1
            write_qr_png(qr.url, out_png)
            say(f'QR_REFRESHED path={out_png} expires_in={expires_in()}s attempt={attempt}')
    return user


async def login_2fa(tg, pwfile, say, *, password_stdin=False, pw_wait=300, attempts=3):
    E = _telethon().errors
    hint = await tg.password_hint()
    src = 'stdin' if password_stdin else (f'file={pwfile}' if not sys.stdin.isatty() else 'prompt')
    say(f'PASSWORD_NEEDED hint={json.dumps(hint or "")} {src} (one line; the file must be mode 0600 and is shredded '
        f'right after reading; waiting {pw_wait}s)')
    for left in range(attempts - 1, -1, -1):
        if password_stdin:
            pw = (await asyncio.to_thread(sys.stdin.readline)).rstrip('\r\n')
        elif sys.stdin.isatty():
            pw = await asyncio.to_thread(getpass.getpass, '2FA password: ')
        else:
            pw = await read_password_file(pwfile, pw_wait, say)
        try:
            return await tg.sign_in_password(pw)
        except E.PasswordHashInvalidError:
            say(f'PASSWORD_INVALID attempts_left={left}')
        finally:
            pw = None
    raise TgreadError('wrong 2FA password too many times')



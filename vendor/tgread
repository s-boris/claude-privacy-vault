    return {
        'chat_id': int(d.id), 'type': typ,
        'title': 'Saved Messages' if typ == 'self' else (display_name(e) or getattr(d, 'name', None) or '?'),
        'username': entity_username(e), 'members': getattr(e, 'participants_count', None),
        'archived': int(bool(getattr(d, 'archived', False))), 'pinned': int(bool(getattr(d, 'pinned', False))),
        'muted': int(bool(muted)), 'unread_count': int(getattr(d, 'unread_count', 0) or 0),
        'unread_mentions': int(getattr(d, 'unread_mentions_count', 0) or 0),
        'read_inbox_max_id': int(getattr(raw, 'read_inbox_max_id', 0) or 0),
        'top_msg_id': int(getattr(raw, 'top_message', 0) or 0),
        'top_ts': int(date.timestamp()) if isinstance(date, dt.datetime) else None,
    }


def _snake(name, prefix):
    name = name[len(prefix):] if name.startswith(prefix) else name
    return re.sub(r'(?<!^)(?=[A-Z])', '_', name).lower()


def classify_media(media):
    """-> (media_type, short description or None). Contact cards, locations: type only (no phone, no coordinates)."""
    if media is None:
        return None, None
    T = _telethon().types
    isa = lambda *names: isinstance(media, _types(*names))
    if isa('MessageMediaEmpty'):
        return None, None
    if isa('MessageMediaPhoto'):
        return 'photo', None
    if isa('MessageMediaDocument'):
        attrs = list(getattr(getattr(media, 'document', None), 'attributes', None) or [])
        fname = next((a.file_name for a in attrs if isinstance(a, T.DocumentAttributeFilename)), None)
        for a in attrs:
            if isinstance(a, T.DocumentAttributeSticker):
                return 'sticker', getattr(a, 'alt', None) or None
        if any(isinstance(a, T.DocumentAttributeAnimated) for a in attrs):
            return 'gif', None
        for a in attrs:
            if isinstance(a, T.DocumentAttributeVideo):
                return ('video_note' if getattr(a, 'round_message', False) else 'video'), fname
            if isinstance(a, T.DocumentAttributeAudio):
                if getattr(a, 'voice', False):
                    return 'voice', None
                return 'audio', fname or (' - '.join(x for x in (a.performer, a.title) if x) or None)
        return 'document', fname
    if isa('MessageMediaWebPage'):
        return 'link', getattr(getattr(media, 'webpage', None), 'site_name', None) or None
    if isa('MessageMediaGeo', 'MessageMediaGeoLive'):
        return 'location', None
    if isa('MessageMediaVenue'):
        return 'venue', getattr(media, 'title', None) or None
    if isa('MessageMediaContact'):
        return 'contact', None
    if isa('MessageMediaPoll'):
        q = getattr(getattr(media, 'poll', None), 'question', None)
        return 'poll', (getattr(q, 'text', q) if q is not None else None)
    if isa('MessageMediaDice'):
        return 'dice', f'{media.emoticon} {media.value}'
    if isa('MessageMediaGame'):
        return 'game', getattr(getattr(media, 'game', None), 'title', None)
    if isa('MessageMediaInvoice'):
        return 'invoice', getattr(media, 'title', None)
    if isa('MessageMediaStory'):
        return 'story', None
    return _snake(type(media).__name__, 'MessageMedia') or 'media', None


def forward_info(m):
    f = getattr(m, 'fwd_from', None)
    if not f:
        return None, None
    fw = getattr(m, 'forward', None)            # Telethon resolves the original sender from the response entities
    ent = (getattr(fw, 'sender', None) or getattr(fw, 'chat', None)) if fw is not None else None
    fid = None
    if getattr(f, 'from_id', None) is not None:
        try:
            fid = _telethon().utils.get_peer_id(f.from_id)
        except Exception:
            fid = None
    name = display_name(ent) if ent is not None else (getattr(f, 'from_name', None) or 'hidden')
    return name, fid


def is_real_message(m):
    return (m is not None and not isinstance(m, _telethon().types.MessageEmpty)
            and isinstance(getattr(m, 'date', None), dt.datetime))


def msg_ts(m):
    return int(m.date.timestamp())


FILE_MEDIA = ('photo', 'document', 'video', 'audio', 'voice', 'video_note', 'gif', 'sticker')


def file_meta(m):
    """(size in bytes, MIME type, duration in s) of a message's file from Telethon's m.file; unknown -> None."""
    try:
        f = getattr(m, 'file', None)
        size, mime, dur = getattr(f, 'size', None), getattr(f, 'mime_type', None), getattr(f, 'duration', None)
    except Exception:
        return None, None, None
    size = size if isinstance(size, int) and not isinstance(size, bool) and size >= 0 else None
    dur = int(dur) if isinstance(dur, (int, float)) and not isinstance(dur, bool) and dur >= 0 else None
    return size, (str(mime)[:100] if mime else None), dur


def message_row(m, chat_id, me_id, me_name):
    if not is_real_message(m):
        return None
    ts = msg_ts(m)
    out = bool(getattr(m, 'out', False))
    sender = getattr(m, 'sender', None)
    sid = me_id if (out and me_id) else getattr(m, 'sender_id', None)
    sname = display_name(sender) if sender is not None else (me_name if out else None)
    action = getattr(m, 'action', None)
    service = _snake(type(action).__name__, 'MessageAction') if action is not None else None
    rt = getattr(m, 'reply_to', None)
    mtype, mdesc = (None, None) if service else classify_media(getattr(m, 'media', None))
    msize, mmime, mdur = file_meta(m) if mtype in FILE_MEDIA else (None, None, None)
    fwd_name, fwd_id = forward_info(m)
    ed = getattr(m, 'edit_date', None)
    return {'chat_id': chat_id, 'msg_id': int(m.id), 'ts': ts, 'date': iso_local(ts), 'sender_id': sid,
            'sender_name': sname, 'out': int(out), 'text': '' if service else (getattr(m, 'message', None) or ''),
            'reply_to': getattr(rt, 'reply_to_msg_id', None) if rt is not None else None,
            'media_type': mtype, 'media_desc': mdesc, 'media_size': msize, 'media_mime': mmime,
            'media_duration': mdur, 'fwd_from': fwd_name, 'fwd_from_id': fwd_id,
            'service': service, 'edit_ts': int(ed.timestamp()) if isinstance(ed, dt.datetime) else None}


def upsert_person(db, e, seen, now):
    if e is None or not isinstance(e, _telethon().types.User) or e.id in seen:
        return
    seen.add(e.id)
    db.execute(
        '''INSERT INTO people(user_id, first_name, last_name, username, is_bot, is_self, updated_ts)
           VALUES (?, ?, ?, ?, ?, ?, ?)
           ON CONFLICT(user_id) DO UPDATE SET first_name=COALESCE(excluded.first_name, people.first_name),
             last_name=COALESCE(excluded.last_name, people.last_name),
             username=COALESCE(excluded.username, people.username), is_bot=excluded.is_bot,
             is_self=excluded.is_self, updated_ts=excluded.updated_ts''',
        (e.id, e.first_name, e.last_name, entity_username(e), int(bool(getattr(e, 'bot', False))),
         int(bool(getattr(e, 'is_self', False))), int(now)))


# =============================================================================================== sync engine

class SyncCtx:
    def __init__(self, db, me_id, me_name, deadline=None, now=None):
        self.db, self.me_id, self.me_name, self.deadline = db, me_id, me_name, deadline
        self.now = now or now_ts()
        self.seen_people = set()
        self.enqueue_since = None          # event feed on: queue new incoming messages at least this young

    def deadline_passed(self):
        return bool(self.deadline) and time.time() > self.deadline

    def store(self, chat_id, msgs, cutoff=None):
        new = upd = 0
        for m in msgs:
            row = message_row(m, chat_id, self.me_id, self.me_name)
            if row is None or (cutoff is not None and row['ts'] < cutoff):
                continue
            upsert_person(self.db, getattr(m, 'sender', None), self.seen_people, self.now)
            fw = getattr(m, 'forward', None)
            if fw is not None:
                upsert_person(self.db, getattr(fw, 'sender', None), self.seen_people, self.now)
            r = upsert_message(self.db, row)
            new += r == 'new'
            upd += r == 'updated'
            if r == 'new' and self.enqueue_since is not None:
                live_enqueue(self.db, row, self.enqueue_since)
        return new, upd


def decide_chat(info, cfg):
    if any(selector_matches(s, info) for s in cfg['exclude_chats']):
        return 'excluded'
    if cfg['include_only'] and not any(selector_matches(s, info) for s in cfg['include_only']):
        return 'not_included'
    if info.get('archived') and not cfg['include_archived']:
        return 'archived'
    m = info.get('members')
    if info['type'] == 'channel' and cfg['skip_channels_over_members'] and m and m > cfg['skip_channels_over_members']:
        return 'too_large'
    if (info['type'] in ('supergroup', 'group') and cfg['skip_groups_over_members'] and m
            and m > cfg['skip_groups_over_members']):
        return 'too_large'
    return 'sync'


def _needs_members(info, cfg):
    return info.get('members') is None and (
        (info['type'] == 'channel' and cfg['skip_channels_over_members']) or
        (info['type'] == 'supergroup' and cfg['skip_groups_over_members']))


async def _member_count(tg, db, d, info, now):
    r = db.execute('SELECT members, members_ts FROM chats WHERE chat_id=?', (info['chat_id'],)).fetchone()
    if r and r['members'] is not None and r['members_ts'] and now - r['members_ts'] < 7 * 86400:
        return r['members'], False
    try:
        return await tg.channel_members(d.input_entity), True
    except _telethon().errors.RPCError as e:
        log.warning('member count failed for a chat: %s', type(e).__name__)
        return (r['members'] if r else None), False


async def sync_forward(tg, d, info, cutoff, delay, ctx):
    """New messages of one chat. First contact: the newest page (searchable at once; backfill continues later).
    Later: if the newest page reaches what we have, it also refreshes edits and mirrors deletions inside it; for big
    gaps it walks up from the cursor oldest-first, committing the cursor every page (resumable)."""
    db, cid = ctx.db, info['chat_id']
    st = db.execute('SELECT fwd_id FROM chats WHERE chat_id=?', (cid,)).fetchone()
    fwd_old = st['fwd_id'] if st else None
    if fwd_old is not None and info['top_msg_id'] == fwd_old:
        return 0, 0, 0
    got = await tg.get_messages(d.input_entity, limit=PAGE)
    page = [m for m in got if is_real_message(m)]
    if fwd_old is None:
        kept = [m for m in page if msg_ts(m) >= cutoff]       # newest-first, so `kept` is a prefix of `page`
        new, upd = ctx.store(cid, kept)
        if page:
            fwd = max(m.id for m in page)
            back_id = min(m.id for m in kept) if kept else fwd + 1
            back_ts = msg_ts(page[len(kept)]) if len(kept) < len(page) else msg_ts(kept[-1])
            done = int(len(got) < PAGE and len(kept) == len(page))
        else:
            fwd, back_id, back_ts, done = 0, 0, None, 1
        db.execute('UPDATE chats SET fwd_id=?, back_id=?, back_ts=?, history_done=?, last_sync_ts=? WHERE chat_id=?',
                   (fwd, back_id, back_ts, done, int(ctx.now), cid))
        db.commit()
        return new, upd, 0
    if not page:
        if info['top_msg_id'] == 0:             # history cleared: mirror it
            n = db.execute('DELETE FROM messages WHERE chat_id=?', (cid,)).rowcount
            db.execute('UPDATE chats SET fwd_id=0, last_sync_ts=? WHERE chat_id=?', (int(ctx.now), cid))
            db.commit()
            return 0, 0, n
        return 0, 0, 0
    ids = {m.id for m in page}
    lo = min(ids)
    if lo <= fwd_old or len(got) < PAGE:
        new, upd = ctx.store(cid, page, cutoff=cutoff)
        gone = [r[0] for r in db.execute('SELECT msg_id FROM messages WHERE chat_id=? AND msg_id>=?', (cid, lo))
                if r[0] not in ids]                # the page is the complete history from `lo` upwards
        for g in gone:
            db.execute('DELETE FROM messages WHERE chat_id=? AND msg_id=?', (cid, g))
        db.execute('UPDATE chats SET fwd_id=?, last_sync_ts=? WHERE chat_id=?', (max(ids), int(ctx.now), cid))
        db.commit()
        return new, upd, len(gone)
    new, upd = ctx.store(cid, page)              # more than a page is new: keep the newest now ...
    db.commit()
    last, batch = fwd_old, []
    async for m in tg.iter_messages(d.input_entity, reverse=True, min_id=fwd_old, wait_time=delay):
        if not is_real_message(m):
            continue
        if m.id >= lo:                            # ... and walk up until the page we already stored
            break
        batch.append(m)
        last = max(last, m.id)
        if len(batch) >= PAGE:
            a, b = ctx.store(cid, batch)
            new, upd, batch = new + a, upd + b, []
            db.execute('UPDATE chats SET fwd_id=? WHERE chat_id=?', (last, cid))
            db.commit()
            if ctx.deadline_passed():
                return new, upd, 0
    if batch:
        a, b = ctx.store(cid, batch)
        new, upd = new + a, upd + b
    db.execute('UPDATE chats SET fwd_id=?, last_sync_ts=? WHERE chat_id=?', (max(ids), int(ctx.now), cid))
    db.commit()
    return new, upd, 0


def needs_backfill(row, cutoff):
    return (not row['history_done'] and row['back_id'] is not None and row['back_id'] > 1
            and (row['back_ts'] is None or row['back_ts'] >= cutoff))


async def backfill(tg, d, info, cutoff, delay, ctx):
    """Older history of one chat, newest-first from the back cursor down to the cutoff; cursor committed per page."""
    db, cid = ctx.db, info['chat_id']
    row = db.execute('SELECT back_id, back_ts, history_done FROM chats WHERE chat_id=?', (cid,)).fetchone()
    if not row or not needs_backfill(row, cutoff):
        return 0
    back_id, back_ts, n, batch, exhausted, cut_ts = row['back_id'], row['back_ts'], 0, [], True, None
    async for m in tg.iter_messages(d.input_entity, offset_id=back_id, wait_time=delay):
        if not is_real_message(m):
            continue
        if msg_ts(m) < cutoff:
            exhausted, cut_ts = False, msg_ts(m)
            break
        batch.append(m)
        if len(batch) >= PAGE:
            a, _ = ctx.store(cid, batch)
            n, back_id, back_ts, batch = n + a, batch[-1].id, msg_ts(batch[-1]), []
            db.execute('UPDATE chats SET back_id=?, back_ts=? WHERE chat_id=?', (back_id, back_ts, cid))
            db.commit()
            if ctx.deadline_passed():
                return n
    if batch:
        a, _ = ctx.store(cid, batch)
        n, back_id, back_ts = n + a, batch[-1].id, msg_ts(batch[-1])
    if cut_ts is not None:
        back_ts = cut_ts
    db.execute('UPDATE chats SET back_id=?, back_ts=?, history_done=? WHERE chat_id=?',
               (back_id, back_ts, int(exhausted), cid))
    db.commit()
    return n


def _chat_errors():
    E = _telethon().errors
    return tuple(c for c in (getattr(E, 'BadRequestError', None), getattr(E, 'ForbiddenError', None)) if c)


async def run_sync(tg, db, cfg, *, since_ts=None, only=None, deadline=None, say=None, label=None, sleep=None,
                   enqueue_since=None):
    """One incremental sync over all dialogs. Commits per page, so any interruption (error, flood wait, deadline,
    kill) resumes where it stopped. FloodWait / auth errors propagate to the caller."""
    say = say or (lambda s: None)
    label = label or (lambda info: f"chat {info['chat_id']}")
    sleep = sleep or asyncio.sleep
    now = now_ts()
    me = await tg.get_me()
    if me is None:
        raise NotAuthorized('the Telegram session is not logged in: run tgread login-qr')
    me_name = display_name(me)
    for k, v in (('me_id', me.id), ('me_first', me.first_name or ''), ('me_last', me.last_name or ''),
                 ('me_username', entity_username(me) or ''), ('me_name', me_name)):
        meta_set(db, k, v, commit=False)
    ctx = SyncCtx(db, me.id, me_name, deadline=deadline, now=now)
    ctx.enqueue_since = enqueue_since
    upsert_person(db, me, ctx.seen_people, now)
    cutoff_cfg = int(now - cfg['max_history_days'] * 86400)
    cutoff = max(cutoff_cfg, int(since_ts)) if since_ts else cutoff_cfg
    delay = float(cfg['request_delay_seconds'])
    stats = {'dialogs': 0, 'planned': 0, 'skipped': 0, 'new': 0, 'updated': 0, 'deleted': 0, 'purged': 0,
             'backfilled': 0, 'errors': 0, 'stopped': False}

    dialogs = [d async for d in tg.iter_dialogs()]
    plan, seen = [], set()
    for d in dialogs:
        info = dialog_info(d, now)
        if info['chat_id'] in seen:
            continue
        seen.add(info['chat_id'])
        upsert_person(db, d.entity, ctx.seen_people, now)
        fetched = False
        status = decide_chat(info, cfg)
        if status == 'sync' and _needs_members(info, cfg):
            info['members'], fetched = await _member_count(tg, db, d, info, now)
            status = decide_chat(info, cfg)
        upsert_chat(db, info, status, now)
        if fetched:
            db.execute('UPDATE chats SET members_ts=? WHERE chat_id=?', (int(now), info['chat_id']))
        if status != 'sync':
            stats['skipped'] += 1
            n = purge_chat_messages(db, info['chat_id'])
            if n:
                stats['purged'] += n
                say(f'purged {n} stored messages of {label(info)} ({status})')
            continue
        if only and not any(selector_matches(s, info) for s in only):
            continue
        plan.append((d, info))
    stats['dialogs'], stats['planned'] = len(seen), len(plan)
    if seen:
        db.execute(f'UPDATE chats SET in_dialogs=0 WHERE chat_id NOT IN ({",".join("?" * len(seen))})', tuple(seen))
    db.commit()

    errs = _chat_errors()
    for i, (d, info) in enumerate(plan, 1):
        if ctx.deadline_passed():
            stats['stopped'] = True
            break
        row = db.execute('SELECT fwd_id FROM chats WHERE chat_id=?', (info['chat_id'],)).fetchone()
        if row and row['fwd_id'] is not None and row['fwd_id'] == info['top_msg_id']:
            continue                              # nothing new: no request, no pause
        try:
            new, upd, gone = await sync_forward(tg, d, info, cutoff, delay, ctx)
        except errs as e:
            stats['errors'] += 1
            db.execute('UPDATE chats SET status=? WHERE chat_id=?', (f'error: {type(e).__name__}', info['chat_id']))
            db.commit()
            log.warning('sync of a chat failed: %s', type(e).__name__)
            continue
        stats['new'] += new
        stats['updated'] += upd
        stats['deleted'] += gone
        if new or upd or gone:
            say(f'[{i}/{len(plan)}] {label(info)}: +{new} new' + (f', {upd} edited' if upd else '')
                + (f', {gone} deleted' if gone else ''))
        await sleep(delay)

    if not stats['stopped']:
        for d, info in sorted(plan, key=lambda x: -(x[1]['top_ts'] or 0)):
            if ctx.deadline_passed():
                stats['stopped'] = True
                break
            row = db.execute('SELECT back_id, back_ts, history_done FROM chats WHERE chat_id=?',
                             (info['chat_id'],)).fetchone()
            if not row or not needs_backfill(row, cutoff):
                continue
            try:
                n = await backfill(tg, d, info, cutoff, delay, ctx)
            except errs as e:
                stats['errors'] += 1
                log.warning('backfill of a chat failed: %s', type(e).__name__)
                continue
            finally:
                await sleep(delay)
            if n:
                stats['backfilled'] += n
                row = db.execute('SELECT back_ts, history_done FROM chats WHERE chat_id=?', (info['chat_id'],)).fetchone()
                say(f'backfill {label(info)}: +{n} older' + (' (complete)' if row['history_done'] else
                                                              f' (back to {fmt_ts(row["back_ts"])})'))
    meta_set(db, 'last_sync_ts', int(now_ts()), commit=False)
    meta_set(db, 'last_sync_stats', json.dumps(stats), commit=False)
    db.commit()
    return stats


def config_presenter(db, cfg):
    """Presenter for output that never goes through the local LLM (chat names in chats/exclude/sync lines)."""
    return Presenter(db, 'alias' if cfg['pseudonymize_names'] else 'real')


def sync_label_fn(db, cfg):
    state = {'pr': None, 'people': -1}

    def label(info):
        n = db.execute('SELECT COUNT(*) FROM people').fetchone()[0]
        if state['pr'] is None or n != state['people']:      # new names arrived: rebuild the name list
            state['pr'], state['people'] = config_presenter(db, cfg), n
        return mask_text(f"{state['pr'].chat_label(info)} ({info['type']})")
    return label


async def _sync_session(api, db, cfg, *, since_ts=None, only=None, max_seconds=None, quiet=True, say=None):
    tg = ReadOnlyTelegram(*api, profile='read',
                          flood_sleep_threshold=min(120, cfg['max_flood_sleep_seconds']) if quiet
                          else cfg['max_flood_sleep_seconds'])
    await tg.connect()
    try:
        check_private_file(SESSION_PATH, 'session file')
        if not await tg.is_authorized():
            raise NotAuthorized('the Telegram session is not authorized (logged out, or terminated in Telegram > '
                                'Settings > Devices): run tgread login-qr')
        deadline = time.time() + max_seconds if max_seconds else None
        stats = await run_sync(tg, db, cfg, since_ts=since_ts, only=only, deadline=deadline, say=say,
                               label=sync_label_fn(db, cfg), enqueue_since=live_enqueue_since(db, cfg))
        live_prune(db, cfg)
        return stats
    finally:
        await tg.disconnect()


def sync_once(db, cfg, api, *, since_ts=None, only=None, max_seconds=None, quiet=True, say=None):
    """Run one sync and map Telethon failures to tgread errors. Any blocked request fails the run."""
    TL = _telethon()
    E = TL.errors
    blocked_before = len(GUARD.blocked)
    try:
        stats = asyncio.run(_sync_session(api, db, cfg, since_ts=since_ts, only=only, max_seconds=max_seconds,
                                          quiet=quiet, say=say))
    except ReadOnlyViolation:
        raise
    except (E.UnauthorizedError, E.AuthKeyDuplicatedError) as e:
        raise NotAuthorized(f'Telegram rejected the session ({type(e).__name__}): it was logged out or terminated '
                            f'(Telegram > Settings > Devices). Run tgread login-qr again.')
    except E.FloodError as e:
        secs = int(getattr(e, 'seconds', 0) or 0)
        meta_set(db, 'flood_until', int(now_ts()) + secs)
        raise TempFail(f'Telegram asked us to wait {secs} s (FLOOD_WAIT); progress is saved, the next sync runs after '
                       f'{fmt_ts(now_ts() + secs)}')
    except (ConnectionError, OSError, asyncio.TimeoutError) as e:
        raise TgreadError(f'network problem talking to Telegram: {type(e).__name__}: {e}')
    except E.RPCError as e:
        raise TgreadError(f'Telegram error: {type(e).__name__}')
    if len(GUARD.blocked) > blocked_before:
        names = ', '.join(sorted({n for _, n in GUARD.blocked[blocked_before:]}))
        raise ReadOnlyViolation(f'the guard blocked request(s) during the sync: {names} (nothing was sent)')
    return stats


# =============================================================================================== live (event feed)

LIVE_WINDOW = 6 * 3600       # only messages younger than this are queued for the event feed (no history floods)


def live_enqueue_since(db, cfg):
    """None unless the event feed is on (config live_events); else the oldest message time worth queueing: never
    before the feed was switched on (meta live_since), never more than LIVE_WINDOW back."""
    if not cfg.get('live_events'):
        return None
    since = meta_get(db, 'live_since')
    if since is None:
        since = int(now_ts())
        meta_set(db, 'live_since', since)
    return max(int(float(since)), int(now_ts()) - LIVE_WINDOW)


def live_enqueue(db, row, since):
    """Queue one stored message for the event feed: incoming only (never the owner's own), no service messages."""
    if since is None or row['out'] or row['service'] or row['ts'] < since:
        return False
    cur = db.execute('INSERT OR IGNORE INTO live_queue(chat_id, msg_id, ts, queued_ts) VALUES (?, ?, ?, ?)',
                     (row['chat_id'], row['msg_id'], row['ts'], int(now_ts())))
    return cur.rowcount > 0


def live_prune(db, cfg):
    db.execute('DELETE FROM live_queue WHERE queued_ts < ?', (int(now_ts() - cfg['live_max_queue_days'] * 86400),))
    db.commit()


def live_chat_info(entity, chat_id):
    """Chat info for a chat no sync has seen yet (no dialog data; the next sync fills in the rest)."""
    typ = entity_type(entity) if entity is not None else ('user' if chat_id > 0 else 'group')
    return {'chat_id': chat_id, 'type': typ,
            'title': 'Saved Messages' if typ == 'self' else ((display_name(entity) if entity is not None else None)
                                                             or '?'),
            'username': entity_username(entity) if entity is not None else None,
            'members': getattr(entity, 'participants_count', None), 'archived': 0, 'pinned': 0, 'muted': 0,
            'unread_count': 0, 'unread_mentions': 0, 'read_inbox_max_id': 0, 'top_msg_id': 0, 'top_ts': None}


class LiveCtx:
    """`tgread live`: stores each new message Telegram pushes (exactly like a sync would) and queues incoming ones
    for the vault's event feed. Chats the sync skips (excluded incl. the forced excludes, not included, archived or
    too large as of the last sync) are dropped before anything is stored; a chat no sync has seen yet is stored
    unless a selector excludes it or its size is unknown while a member limit applies."""

    def __init__(self, db, cfg, me, say=None):
        self.db, self.cfg = db, cfg
        self.me_id, self.me_name = me.id, display_name(me)
        self.say = say or (lambda s: None)
        self.seen_people = set()
        self.stats = {'stored': 0, 'queued': 0, 'skipped': 0, 'errors': 0}

    def chat(self, chat_id, entity):
        row = self.db.execute('SELECT * FROM chats WHERE chat_id=?', (chat_id,)).fetchone()
        if row is not None:
            return dict(row) if row['status'] == 'sync' else None
        info = live_chat_info(entity, chat_id)
        if decide_chat(info, self.cfg) != 'sync' or _needs_members(info, self.cfg):
            return None
        upsert_chat(self.db, info, 'sync', now_ts())
        return info

    async def handle(self, event):
        try:
            m = event.message
            chat_id = int(event.chat_id)
            entity = getattr(event, 'chat', None)
            if entity is None:
                try:
                    entity = await event.get_chat()
                except Exception:
                    entity = None
            if self.chat(chat_id, entity) is None:
                self.stats['skipped'] += 1
                return
            row = message_row(m, chat_id, self.me_id, self.me_name)
            if row is None:
                return
            upsert_person(self.db, getattr(m, 'sender', None), self.seen_people, now_ts())
            r = upsert_message(self.db, row)
            queued = r == 'new' and live_enqueue(self.db, row, live_enqueue_since(self.db, self.cfg))
            self.db.commit()
            self.stats['stored'] += r == 'new'
            if queued:
                self.stats['queued'] += 1
                self.say('LIVE_QUEUED')
        except ReadOnlyViolation:
            raise
        except Exception as e:
            self.stats['errors'] += 1
            log.warning('live: storing a new message failed: %s', type(e).__name__)


async def _live_session(api, db, cfg, *, sync_minutes=15, max_seconds=None, say=None):
    say = say or (lambda s: print(s, flush=True))
    tg = ReadOnlyTelegram(*api, profile='live', receive_updates=True,
                          flood_sleep_threshold=min(120, cfg['max_flood_sleep_seconds']))
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            loop.add_signal_handler(sig, stop.set)
        except (NotImplementedError, RuntimeError, ValueError):
            pass
    blocked_before = len(GUARD.blocked)
    await tg.connect()
    try:
        check_private_file(SESSION_PATH, 'session file')
        if not await tg.is_authorized():
            raise NotAuthorized('the Telegram session is not authorized (logged out, or terminated in Telegram > '
                                'Settings > Devices): run tgread login-qr')
        me = await tg.get_me()
        live = LiveCtx(db, cfg, me, say=say)
        live_enqueue_since(db, cfg)                      # the feed starts now (no history)
        tg.on_new_message(live.handle)
        say('LIVE_READY')
        end = time.time() + max_seconds if max_seconds else None
        next_sync, label = time.time(), sync_label_fn(db, cfg)     # first: catch up what came in while down
        while not stop.is_set() and not (end and time.time() >= end):
            if len(GUARD.blocked) > blocked_before:
                break
            if not tg.is_connected():
                raise ConnectionError('the Telegram connection dropped')
            if time.time() >= next_sync:
                stats = await run_sync(tg, db, cfg, deadline=time.time() + 600, label=label,
                                       enqueue_since=live_enqueue_since(db, cfg))
                meta_set(db, 'fail_count', 0, commit=False)
                live_prune(db, cfg)
                say(f"SYNC_DONE new={stats['new']} edited={stats['updated']} deleted={stats['deleted']} "
                    f"older={stats['backfilled']} errors={stats['errors']}")
                next_sync = time.time() + sync_minutes * 60
            meta_set(db, 'live_heartbeat', int(time.time()))
            step = min(20.0, max(0.05, end - time.time())) if end else 20.0
            try:
                await asyncio.wait_for(stop.wait(), timeout=step)
            except asyncio.TimeoutError:
                pass
    finally:
        await tg.disconnect()
        for sig in (signal.SIGTERM, signal.SIGINT):
            try:
                loop.remove_signal_handler(sig)
            except (NotImplementedError, RuntimeError, ValueError):
                pass


def live_once(db, cfg, api, *, sync_minutes=15, max_seconds=None, say=None):
    """Run the live session until stopped (SIGTERM), disconnected or max_seconds; map Telethon failures like
    sync_once. Any request the guard blocked ends the run as a violation."""
    TL = _telethon()
    E = TL.errors
    blocked_before = len(GUARD.blocked)
    try:
        asyncio.run(_live_session(api, db, cfg, sync_minutes=sync_minutes, max_seconds=max_seconds, say=say))
    except ReadOnlyViolation:
        raise
    except (E.UnauthorizedError, E.AuthKeyDuplicatedError) as e:
        raise NotAuthorized(f'Telegram rejected the session ({type(e).__name__}): it was logged out or terminated '
                            f'(Telegram > Settings > Devices). Run tgread login-qr again.')
    except E.FloodError as e:
        secs = int(getattr(e, 'seconds', 0) or 0)
        meta_set(db, 'flood_until', int(now_ts()) + secs)
        raise TempFail(f'Telegram asked us to wait {secs} s (FLOOD_WAIT); live resumes after {fmt_ts(now_ts() + secs)}')
    except (ConnectionError, OSError, asyncio.TimeoutError) as e:
        raise TgreadError(f'network problem talking to Telegram: {type(e).__name__}: {e}')
    except E.RPCError as e:
        raise TgreadError(f'Telegram error: {type(e).__name__}')
    if len(GUARD.blocked) > blocked_before:
        names = ', '.join(sorted({n for _, n in GUARD.blocked[blocked_before:]}))
        raise ReadOnlyViolation(f'the guard blocked request(s) in live mode: {names} (nothing was sent)')


def live_items(db, cfg, after=0, max_items=30, max_chars=12000):
    """Queued messages after `after` for the vault's event feed. Text is the usual chat line ('[time] Name: text
    [media] (#id)'), regex-masked, with REAL names (the vault's local LLM triages it and anonymizes what it
    surfaces). Messages deleted or chats excluded since queueing are skipped; the owner's own never appear."""
    pr = Presenter(db, 'real')
    chats, items, last, size = {}, [], after, 0
    rows = db.execute('SELECT qid, chat_id, msg_id FROM live_queue WHERE qid > ? ORDER BY qid LIMIT ?',
                      (after, max_items * 4 + 50)).fetchall()
    for q in rows:
        if len(items) >= max_items:
            break
        m = db.execute('SELECT * FROM messages WHERE chat_id=? AND msg_id=?', (q['chat_id'], q['msg_id'])).fetchone()
        if q['chat_id'] not in chats:
            r = db.execute('SELECT * FROM chats WHERE chat_id=?', (q['chat_id'],)).fetchone()
            chats[q['chat_id']] = dict(r) if r else None
        chat = chats[q['chat_id']]
        if (m is None or chat is None or chat['status'] != 'sync' or m['out']
                or any(selector_matches(s, chat) for s in cfg['exclude_chats'])):
            last = q['qid']
            continue
        line = mask_text(fmt_line(m, pr, chat, max_text=1500))
        if items and size + len(line) > max_chars:
            break
        size += len(line)
        sender = m['sender_name'] or chat.get('title') or '?'
        if m['sender_id']:
            p = db.execute('SELECT first_name FROM people WHERE user_id=?', (m['sender_id'],)).fetchone()
            sender = (p[0] if p and p[0] else sender)
        first = sender.split()[0] if sender.split() else sender
        title = first if chat['type'] in ('user', 'bot') else (chat.get('title') or '?')
        quiet = ('muted' if chat.get('muted') else 'archived' if chat.get('archived')
                 else 'channel' if chat['type'] == 'channel' else None)
        items.append({'qid': q['qid'], 'ts': m['ts'], 'chat_key': str(chat['chat_id']), 'chat_id': chat['chat_id'],
                      'chat_type': chat['type'], 'chat': mask_text(title), 'sender': mask_text(first),
                      'sender_key': str(m['sender_id'] or ''), 'msg_id': m['msg_id'], 'text': line, 'quiet': quiet,
                      'public': not is_private_chat(chat)})
        last = q['qid']
    pending = db.execute('SELECT COUNT(*) FROM live_queue WHERE qid > ?', (last,)).fetchone()[0]
    return {'source': 'telegram', 'owner_name': pr.owner_name(), 'items': items, 'last_qid': last,
            'pending': pending}


PEOPLE_MAX = 500


def people_stats(db, cfg, min_msgs=10, days=365, now=None, max_people=PEOPLE_MAX):
    """Vault memory plan C2 (2026-10-15): the vault's person cards are derived from this. Per DM contact (a 'user'
    chat; not a bot, not the owner, not excluded incl. the vault's forced excludes) with at least `min_msgs` real
    messages (no service rows) in the last `days` days: incoming/outgoing counts for 30/90/365 days, the last
    incoming and outgoing time, the first DM time and how many other (non-excluded) chats they posted in. Counts and
    times only, never text; the name is the vault's input for its first-name rule (regex-masked here)."""
    now = int(now if now is not None else now_ts())
    t30, t90, t365, tmin = now - 30 * 86400, now - 90 * 86400, now - 365 * 86400, now - int(days) * 86400
    me = int(meta_get(db, 'me_id') or 0)
    chats = {r['chat_id']: dict(r) for r in db.execute("SELECT * FROM chats WHERE status != 'excluded'")}
    rows = db.execute(
        '''SELECT m.chat_id AS uid,
                  SUM(m.out = 0 AND m.ts >= :t30) AS in30, SUM(m.out = 1 AND m.ts >= :t30) AS out30,
                  SUM(m.out = 0 AND m.ts >= :t90) AS in90, SUM(m.out = 1 AND m.ts >= :t90) AS out90,
                  SUM(m.out = 0 AND m.ts >= :t365) AS in365, SUM(m.out = 1 AND m.ts >= :t365) AS out365,
                  SUM(m.ts >= :tmin) AS n_window,
                  MAX(CASE WHEN m.out = 0 THEN m.ts END) AS last_in, MAX(CASE WHEN m.out = 1 THEN m.ts END) AS last_out,
                  MIN(m.ts) AS first_ts
           FROM messages m JOIN chats c ON c.chat_id = m.chat_id
           WHERE c.type = 'user' AND c.status != 'excluded' AND (m.service IS NULL OR m.service = '')
             AND m.ts <= :now
           GROUP BY m.chat_id HAVING n_window >= :min ORDER BY MAX(m.ts) DESC''',
        {'t30': t30, 't90': t90, 't365': t365, 'tmin': tmin, 'min': int(min_msgs), 'now': now}).fetchall()
    out = []
    for r in rows:
        uid = r['uid']
        chat = chats.get(uid)
        if chat is None or uid in (me, 777000) or any(selector_matches(s, chat) for s in cfg['exclude_chats']):
            continue
        p = db.execute('SELECT first_name, last_name, is_bot, is_self FROM people WHERE user_id=?', (uid,)).fetchone()
        if p is not None and (p['is_bot'] or p['is_self']):
            continue
        name = (' '.join(x for x in (p['first_name'], p['last_name']) if x) if p else '') or chat.get('title') or ''
        groups = sum(1 for g in db.execute('SELECT DISTINCT chat_id FROM messages WHERE sender_id=? AND chat_id != ?',
                                           (uid, uid))
                     if g[0] in chats and chats[g[0]]['type'] not in ('user', 'bot', 'self')
                     and not any(selector_matches(s, chats[g[0]]) for s in cfg['exclude_chats']))
        out.append({'uid': uid, 'name': mask_text(name), 'in30': r['in30'] or 0, 'out30': r['out30'] or 0,
                    'in90': r['in90'] or 0, 'out90': r['out90'] or 0, 'in365': r['in365'] or 0,
                    'out365': r['out365'] or 0, 'last_in': r['last_in'], 'last_out': r['last_out'],
                    'first_ts': r['first_ts'], 'groups_shared': groups})
        if len(out) >= max_people:
            break
    return {'source': 'telegram', 'now': now, 'min': int(min_msgs), 'days': int(days), 'people': out}


INDEX_KINDS = ('user', 'group', 'supergroup')          # DMs and groups; broadcast channels and bots are not indexed
INDEX_ROWS_MAX = 5000


def index_chats(db, cfg):
    """{chat id: chat row} of the chats the vault's semantic index may hold: DMs and groups, never channels, bots,
    777000 or excluded chats (incl. the vault's forced excludes)."""
    chats = {r['chat_id']: dict(r) for r in db.execute("SELECT * FROM chats WHERE status != 'excluded'")}
    return {cid: c for cid, c in chats.items() if c['type'] in INDEX_KINDS and cid != 777000
            and not any(selector_matches(s, c) for s in cfg['exclude_chats'])}


def index_rows(db, cfg, after=0, max_rows=INDEX_ROWS_MAX, chat=None, since_ts=None):
    """Vault memory plan C3/C4 (2026-10-15): messages for the vault's semantic index, oldest row first after rowid
    `after`: DMs and groups only (no channels, bots, service rows, empty texts, excluded chats incl. the vault's forced
    excludes). Raw text and the sender's first name ('me' for his own): vault-internal only, never in TG_SPECS, so no
    API route and no raw release can reach it; the vault embeds the text inside and stores ids and numbers only.
    C4: chat + since_ts = one chat's rows from that time on (the index re-chunks a chat's open tail)."""
    chats = index_chats(db, cfg)
    ok = set(chats)
    first = {}
    out, last = [], int(after)
    where, params = ['id > ?', "(service IS NULL OR service = '')", "text != ''"], [int(after)]
    if chat is not None:
        where.append('chat_id = ?')
        params.append(int(chat))
    if since_ts is not None:
        where.append('ts >= ?')
        params.append(int(since_ts))
    for r in db.execute(f'''SELECT id, chat_id, msg_id, ts, edit_ts, out, sender_id, text FROM messages
                           WHERE {' AND '.join(where)} ORDER BY id LIMIT ?''', params + [int(max_rows)]):
        last = r['id']
        if r['chat_id'] not in ok:
            continue
        sid = r['sender_id']
        if r['out']:
            who = 'me'
        else:
            if sid not in first:
                p = db.execute('SELECT first_name FROM people WHERE user_id=?', (sid,)).fetchone() if sid else None
                first[sid] = ((p['first_name'] or '').split() or ['?'])[0] if p else '?'
            who = first[sid]
        out.append({'id': r['id'], 'chat': r['chat_id'], 'msg': r['msg_id'], 'ts': r['ts'], 'edit_ts': r['edit_ts'],
                    'out': int(r['out'] or 0), 'sid': sid, 'sender': who,
                    'kind': 'dm' if chats[r['chat_id']]['type'] == 'user' else 'group', 'text': r['text']})
    return {'after': int(after), 'last': last, 'rows': out}


OUT_ITEMS_MAX = 400
PRIOR_MAX = 500


def out_items(db, cfg, after=0, since_ts=0, max_rows=OUT_ITEMS_MAX):
    """Vault memory plan C5 (2026-10-15): the owner's OWN messages in DM chats (a 'user' chat the index may hold: no
    bots, channels, 777000 or excluded chats), oldest row first after rowid `after` and from `since_ts` on, as
    regex-masked chat lines with real names, for the vault's nightly owner-perspective triage ("does his message ask
    the other person for something?"). Raw text: vault-internal only, never in TG_SPECS, so no API route and no raw
    release can reach it; the vault keeps enums, dates and refs only."""
    dms = {cid: c for cid, c in index_chats(db, cfg).items() if c['type'] == 'user'}
    pr = Presenter(db, 'real')
    out, last = [], int(after)
    for r in db.execute("""SELECT * FROM messages WHERE id > ? AND ts >= ? AND out = 1
                           AND (service IS NULL OR service = '') AND text != '' ORDER BY id LIMIT ?""",
                        (int(after), int(since_ts), int(max_rows))):
        last = r['id']
        chat = dms.get(r['chat_id'])
        if chat is None:
            continue
        out.append({'id': r['id'], 'chat': r['chat_id'], 'msg': r['msg_id'], 'ts': r['ts'],
                    'line': mask_text(fmt_line(r, pr, chat, max_text=800))})
    return {'after': int(after), 'last': last, 'rows': out}


def prior_counts(db, cfg, pairs):
    """Vault memory plan C5: [[DM chat id, unix time], ...] -> how many messages the other person sent in that DM
    before that time (numbers only; the vault keeps asks of brand-new contacts off the cards)."""
    dms = {cid for cid, c in index_chats(db, cfg).items() if c['type'] == 'user'}
    return [db.execute('SELECT COUNT(*) FROM messages WHERE chat_id=? AND out=0 AND ts < ?',
                       (int(c), int(t))).fetchone()[0] if int(c) in dms else 0 for c, t in pairs]


INDEX_LINES_MAX = 400


def index_lines(db, cfg, pairs):
    """Vault memory plan C4: the messages the vault's hybrid retrieval picked ([chat id, msg id] pairs, at most
    INDEX_LINES_MAX), as the same JSON hits as `search --json` (chat, msg_id, ts, line), oldest first; only chats the
    index may hold. Raw text: vault-internal only (the vault anonymizes it before the local LLM reads it), never in
    TG_SPECS, so no API route and no raw release can reach it."""
    ok = index_chats(db, cfg)
    rows = []
    for cid, mid in pairs:
        if int(cid) not in ok:
            continue
        r = db.execute("SELECT * FROM messages WHERE chat_id=? AND msg_id=? AND (service IS NULL OR service = '')",
                       (int(cid), int(mid))).fetchone()
        if r is not None:
            rows.append(r)
    rows.sort(key=lambda r: (r['ts'], r['msg_id']))
    pr = Presenter(db, 'raw', focus_ids(rows), chat_ids(rows))
    out = []
    for h in rows:
        chat = ok[h['chat_id']]
        out.append({'chat_id': h['chat_id'], 'chat': pr.chat_label(chat), 'chat_type': chat.get('type'),
                    'msg_id': h['msg_id'], 'ts': h['ts'], 'line': fmt_line(h, pr, chat, 2000)})
    return {'hits': out}


def alert(kind, title, body, hours=24.0):
    """One ~/inbox note per kind per `hours` (cron mode); state in ~/.local/share/tgread/alerts.json."""
    try:
        state = json.loads(ALERTS_PATH.read_text('utf-8'))
    except (OSError, ValueError):
        state = {}
    if time.time() - float(state.get(kind, 0)) < hours * 3600:
        return False
    INBOX_DIR.mkdir(parents=True, exist_ok=True)
    note = INBOX_DIR / f'tgread-{kind}-{int(time.time())}.md'
    note.write_text(f'# tgread: {title}\n\n{mask_text(body)}\n\nFrom ~/bin/tgread (cron `sync --quiet`). '
                    f'Details: `tgread status`, ~/.local/share/tgread/tgread.log.\n', encoding='utf-8')
    state[kind] = time.time()
    ensure_private_dir(DATA_DIR)
    write_private_json(ALERTS_PATH, state)
    return True



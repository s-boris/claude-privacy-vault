def cmd_download(args):
    api = load_creds()
    if not SESSION_PATH.exists():
        raise NotAuthorized('not logged in yet: run tgread login-qr')
    db = open_db()
    cfg = load_config()
    chat = resolve_chat(db, args.chat, config_presenter(db, cfg))
    out_dir = Path(args.out).expanduser() if args.out else MEDIA_DIR
    if out_dir == MEDIA_DIR:
        ensure_private_dir(MEDIA_DIR)
    else:
        out_dir.mkdir(mode=0o700, parents=True, exist_ok=True)

    async def go():
        tg = ReadOnlyTelegram(*api, profile='download', flood_sleep_threshold=120)
        await tg.connect()
        try:
            if not await tg.is_authorized():
                raise NotAuthorized('the Telegram session is not authorized: run tgread login-qr')
            ent = await tg.get_input_entity(chat['chat_id'])
            msgs = await tg.get_messages(ent, ids=[args.msg])
            m = msgs[0] if msgs else None
            if m is None or not getattr(m, 'media', None):
                raise TgreadError(f"message #{args.msg} not found in chat {chat['chat_id']} or it has no file")
            f = m.file
            size = getattr(f, 'size', None) or 0
            if size > args.max_mb * 1024 * 1024:
                raise TgreadError(f'the file is {size / 1e6:.1f} MB, over --max-mb {args.max_mb}')
            target = out_dir / f"{chat['chat_id']}_{args.msg}{getattr(f, 'ext', '') or ''}"
            path = await tg.download_media(m, str(target))
            return path, size, classify_media(m.media)[0], getattr(f, 'name', None), getattr(f, 'mime_type', None)
        finally:
            await tg.disconnect()

    with Lock(wait=60) as lk:
        if not lk.ok:
            raise TempFail('another tgread command is using the Telegram session; try again later')
        try:
            path, size, kind, name, mime = asyncio.run(go())
        except _telethon().errors.RPCError as e:
            raise TgreadError(f'Telegram error: {type(e).__name__}')
    if path:
        os.chmod(path, 0o600)
    print(f'DOWNLOADED path={path} bytes={size} type={kind} mime={mime or "-"} '
          f'name={json.dumps(name) if name else "-"}')          # the original file name (JSON string), last
    if GUARD.blocked:
        raise ReadOnlyViolation('the guard blocked request(s): ' + ', '.join(sorted({n for _, n in GUARD.blocked})))
    return EXIT_OK



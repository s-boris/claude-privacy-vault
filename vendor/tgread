def cmd_wipe(args):
    if not args.yes or not (args.session or args.data or args.all):
        raise UsageError('wipe needs --session, --data or --all, and --yes')
    gone = []
    with Lock(wait=30) as lk:
        if not lk.ok:
            raise TempFail('another tgread command is running')
        if args.session or args.all:
            for p in (SESSION_PATH, Path(f'{SESSION_PATH}-journal'), PASSWORD_FILE_DEFAULT):
                if os.path.lexists(p):
                    shred(p)
                    gone.append(str(p))
        if args.data or args.all:
            for p in (DB_PATH, Path(f'{DB_PATH}-wal'), Path(f'{DB_PATH}-shm'), QR_DEFAULT, ALERTS_PATH):
                if os.path.lexists(p):
                    shred(p)
                    gone.append(str(p))
            if MEDIA_DIR.exists():
                shutil.rmtree(MEDIA_DIR)
                gone.append(str(MEDIA_DIR))
    print('deleted: ' + (', '.join(gone) if gone else 'nothing (already clean)'))
    if args.session or args.all:
        print(f'Note: the authorization itself stays in Telegram > Settings > Devices ("{DEVICE_MODEL}") until the '
              'owner terminates it there; tgread cannot log out (read-only).')
    return EXIT_OK



MEDIA_COLUMNS = (('media_size', 'INTEGER'), ('media_mime', 'TEXT'), ('media_duration', 'INTEGER'))


def _migrate(db):
    """Columns added after the first release (2026-10-13: file size, MIME type and duration for `tgread media`;
    messages stored before show them as unknown until a sync sees them again)."""
    have = {r[1] for r in db.execute('PRAGMA table_info(messages)')}
    for col, typ in MEDIA_COLUMNS:
        if col not in have:
            try:
                db.execute(f'ALTER TABLE messages ADD COLUMN {col} {typ}')
            except sqlite3.OperationalError as e:          # another tgread process added it first
                if 'duplicate column' not in str(e):
                    raise


def open_db(path=None):
    path = Path(path or DB_PATH)
    ensure_private_dir(path.parent)
    db = sqlite3.connect(str(path), timeout=30)
    db.row_factory = sqlite3.Row
    db.execute('PRAGMA journal_mode=WAL')
    db.execute('PRAGMA synchronous=NORMAL')
    db.execute('PRAGMA secure_delete=ON')        # purged/deleted messages are zeroed in the file, not just unlinked
    db.execute('PRAGMA busy_timeout=30000')
    db.executescript(SCHEMA)
    _migrate(db)
    for p in (path, Path(f'{path}-wal'), Path(f'{path}-shm')):
        try:
            if stat.S_IMODE(os.lstat(p).st_mode) & 0o077:
                os.chmod(p, 0o600)
        except FileNotFoundError:
            pass
    return db


def meta_get(db, key, default=None):

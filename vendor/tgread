# Word variants for `search --expand` and the vault's `find` (plan v2 #10): Swiss German, German and English words
# that mean the same. A query word that equals or starts one of a group's words (or is started by one of 4+ letters)
# gets the whole group; ue/ü, ae/ä, oe/ö count as the same letter; every variant matches word starts (FTS prefix).
VARIANT_GROUPS = (
    ('hochzeit', 'hochziit', 'hochzit', 'wedding', 'heirat', 'hürot', 'hürat', 'trauung'),
    ('junggesellenabschied', 'junggesellinnenabschied', 'jga', 'polterabend', 'bachelor party', 'bachelorette',
     'hen party'),
    ('geburtstag', 'geburi', 'geburtsi', 'birthday', 'bday'),
    ('montag', 'mäntig', 'mentig', 'monday'),
    ('dienstag', 'zischtig', 'ziischtig', 'tuesday'),
    ('mittwoch', 'mittwuch', 'wednesday'),
    ('donnerstag', 'dunschtig', 'donschtig', 'thursday'),
    ('freitag', 'fritig', 'friitig', 'friday'),
    ('samstag', 'samschtig', 'saturday'),
    ('sonntag', 'sunntig', 'sunday'),
    ('wochenende', 'weekend', 'wuchenend'),
    ('abendessen', 'znacht', 'nachtessen', 'dinner'),
    ('mittagessen', 'zmittag', 'lunch'),
    ('frühstück', 'zmorge', 'breakfast', 'brunch'),
    ('geschenk', 'gschänk'),
    ('ferien', 'urlaub', 'holiday', 'vacation'),
    ('reise', 'trip', 'travel'),
    ('tauchen', 'tauche', 'tauchgang', 'dive', 'diving'),
    ('konzert', 'concert'),
    ('termin', 'appointment'),
    ('rechnung', 'invoice'),
    ('treffpunkt', 'meeting point'),
)
_FOLD_PAIRS = (('ü', 'ue'), ('ä', 'ae'), ('ö', 'oe'))
_PLAIN = {'ü': 'u', 'ä': 'a', 'ö': 'o'}


def variant_key(w):
    """Compare key: casefolded, ü/ue -> u, ä/ae -> a, ö/oe -> o."""
    w = (w or '').casefold()
    for a, b in _FOLD_PAIRS:
        w = w.replace(b, _PLAIN[a]).replace(a, _PLAIN[a])
    return w


def spellings(w):
    """One word in its ü/ue (ä/ae, ö/oe) spellings, casefolded, the word itself first."""
    out = [(w or '').casefold()]
    for a, b in _FOLD_PAIRS:
        for x in list(out):
            for y in (x.replace(a, b), x.replace(b, a)):
                if y not in out:
                    out.append(y)
    return out


def expand_word(w, limit=16):
    """A query word -> its variants: the word, the variant groups it belongs to, each in its ü/ue spellings."""
    k = variant_key(w)
    words = [(w or '').casefold()]
    for g in VARIANT_GROUPS:
        keys = [variant_key(x) for x in g]
        if any(k == x or (len(x) >= 4 and k.startswith(x)) or (len(k) >= 4 and x.startswith(k)) for x in keys):
            words += [x for x in g if x not in words]
    out = []
    for x in words:
        for y in spellings(x):
            if y not in out:
                out.append(y)
    return out[:limit]


def expand_query(q):
    """'Hochzeit "Fritig Znacht"' -> [[variants of word 1], ['"fritig znacht"'], ...]: words are expanded, quoted
    phrases stay one exact term."""
    groups = []
    for m in re.finditer(r'"([^"]+)"|(\S+)', q or ''):
        if m.group(1):
            words = re.findall(r'\w+', m.group(1))
            if words:
                groups.append(['"' + ' '.join(words) + '"'])
        else:
            for w in re.findall(r'\w+', m.group(2)):
                groups.append(expand_word(w))
    return groups


def _fts_term(v):
    if v.startswith('"'):
        return v
    toks = re.findall(r'\w+', v)
    if not toks:
        return None
    return '"' + ' '.join(toks) + '"' + ('*' if len(toks) == 1 and len(toks[0]) >= 3 else '')


def build_fts_query(q, any_=False, expand=False):
    terms = []
    if expand:
        for g in expand_query(q):
            alts = []
            for v in g:
                t = _fts_term(v)
                if t and t not in alts:
                    alts.append(t)
            if alts:
                terms.append(alts[0] if len(alts) == 1 else '(' + ' OR '.join(alts) + ')')
        if not terms:
            raise UsageError('empty search query')
        return (' OR ' if any_ else ' AND ').join(terms)
    for m in re.finditer(r'"([^"]+)"|(\S+)', q or ''):
        if m.group(1):
            words = re.findall(r'\w+', m.group(1))
            if words:
                terms.append('"' + ' '.join(words) + '"')
        else:
            for w in re.findall(r'\w+', m.group(2)):
                terms.append(f'"{w}"*' if len(w) >= 3 else f'"{w}"')
    if not terms:
        raise UsageError('empty search query')
    return (' OR ' if any_ else ' AND ').join(terms)



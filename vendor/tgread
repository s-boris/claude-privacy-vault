    p.set_defaults(func=cmd_allowlist)

    p = sub.add_parser('selfcheck')                      # no help= : hidden from the command list (boot.sh check)
    p.set_defaults(func=cmd_selfcheck)

    p = sub.add_parser('wipe', help='delete the session and/or the archive (local only)')
    p.add_argument('--session', action='store_true')
    p.add_argument('--data', action='store_true')
    p.add_argument('--all', action='store_true')
    p.add_argument('--yes', action='store_true')
    p.set_defaults(func=cmd_wipe)
    return ap


NO_PREFLIGHT = ('status', 'wipe', 'selfcheck', 'allowlist')


def main(argv=None):
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding='utf-8', errors='replace')
        except Exception:
            pass
    ap = build_parser()
    args = ap.parse_args(argv)
    if not getattr(args, 'func', None):
        ap.print_help()
        return EXIT_USAGE
    if args.cmd == 'exclude' and args.action != 'list' and not args.chats:
        ap.error('exclude add/rm needs at least one chat')
    try:
        setup_logging()
        log.info('command %s', args.cmd)
        if args.cmd not in NO_PREFLIGHT:
            try:
                preflight()
            except PermError as e:
                if args.cmd == 'sync' and getattr(args, 'quiet', False):
                    alert('perms', 'refused to run (file permissions)', str(e), hours=24)
                raise
        return args.func(args) or EXIT_OK
    except ReadOnlyViolation as e:
        log.error('read-only violation: %s', e)
        eprint(f'tgread: BLOCKED: {e}')
        return EXIT_GUARD
    except TgreadError as e:
        eprint(f'tgread: {mask_text(str(e))}')
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main())

class _RedactFilter(logging.Filter):
    def filter(self, record):
        try:
            msg = record.getMessage()
        except Exception:
            return True
        for v in _SECRET_VALUES:
            if v and v in msg:
                msg = msg.replace(v, '[redacted]')
        record.msg, record.args = msg, None
        return True


def setup_logging():
    """Log to ~/.local/share/tgread/tgread.log only (never stdout): request type names and counts, never message
    text, never secrets."""
    global _logging_ready
    if _logging_ready:
        return
    ensure_private_dir(DATA_DIR)
    try:
        if LOG_PATH.exists() and LOG_PATH.stat().st_size > 5_000_000:
            os.replace(LOG_PATH, LOG_PATH.with_name('tgread.log.1'))
    except OSError:
        pass
    h = logging.FileHandler(LOG_PATH, encoding='utf-8')
    h.setFormatter(logging.Formatter('%(asctime)s %(levelname)s %(name)s: %(message)s'))
    h.addFilter(_RedactFilter())
    root = logging.getLogger()
    root.handlers[:] = [h]
    root.setLevel(logging.INFO)
    logging.getLogger('telethon').setLevel(logging.DEBUG if os.environ.get('TGREAD_DEBUG') else logging.WARNING)
    _logging_ready = True


# =============================================================================================== permissions

def ensure_private_dir(p):
    """mkdir -m 700; tighten it if it got looser; refuse symlinks and foreign owners."""
    p = Path(p)
    p.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = os.lstat(p)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise PermError(f'{p} is not a real directory; refusing to run')
    if st.st_uid != os.getuid():
        raise PermError(f'{p} is not owned by uid {os.getuid()}; refusing to run')
    if stat.S_IMODE(st.st_mode) & 0o077:
        os.chmod(p, 0o700)
    return p


def check_private_file(p, what):
    """True if p is a private regular file (ours, mode 0600 or stricter, one link), False if it doesn't exist,
    PermError otherwise. Used for the session, the credentials and the one-time 2FA file."""
    try:
        st = os.lstat(p)
    except FileNotFoundError:
        return False
    if stat.S_ISLNK(st.st_mode):
        raise PermError(f'{what} {p} is a symlink; refusing to run')
    if not stat.S_ISREG(st.st_mode):
        raise PermError(f'{what} {p} is not a regular file; refusing to run')
    if st.st_uid != os.getuid():
        raise PermError(f'{what} {p} is not owned by uid {os.getuid()}; refusing to run')
    mode = stat.S_IMODE(st.st_mode)
    if mode & 0o077:
        raise PermError(f'{what} {p} has mode {mode:04o}, looser than 0600; refusing to run (fix: chmod 600 {p})')
    if st.st_nlink != 1:
        raise PermError(f'{what} {p} has {st.st_nlink} hard links; refusing to run')
    return True


def check_secrets_dir():
    try:
        st = os.lstat(SECRETS_DIR)
    except FileNotFoundError:
        return False
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise PermError(f'{SECRETS_DIR} is not a real directory; refusing to run')
    if st.st_uid != os.getuid():
        raise PermError(f'{SECRETS_DIR} is not owned by uid {os.getuid()}; refusing to run')
    mode = stat.S_IMODE(st.st_mode)
    if mode & 0o022:
        raise PermError(f'{SECRETS_DIR} is writable by group/others (mode {mode:04o}); refusing to run '
                        f'(fix: chmod 700 {SECRETS_DIR})')
    return True



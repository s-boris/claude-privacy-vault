def upsert_message(db, r):
    cur = db.execute('SELECT text, edit_ts, media_type, media_desc, sender_name, service, media_size, media_mime, '
                     'media_duration FROM messages WHERE chat_id=? AND msg_id=?', (r['chat_id'], r['msg_id'])).fetchone()
    cols = ('ts', 'date', 'sender_id', 'sender_name', 'out', 'text', 'reply_to', 'media_type', 'media_desc',
            'fwd_from', 'fwd_from_id', 'service', 'edit_ts') + tuple(c for c, _ in MEDIA_COLUMNS)
    if cur is None:
        db.execute(f'INSERT INTO messages(chat_id, msg_id, {", ".join(cols)}) VALUES ({", ".join("?" * (len(cols) + 2))})',
                   (r['chat_id'], r['msg_id'], *(r.get(c) for c in cols)))
        return 'new'
    if tuple(cur)[:6] == (r['text'], r['edit_ts'], r['media_type'], r['media_desc'], r['sender_name'], r['service']):
        facts = tuple(r.get(c) for c, _ in MEDIA_COLUMNS)
        if any(v is not None for v in facts) and tuple(cur)[6:] != facts:     # file facts only (older rows): no edit
            db.execute('UPDATE messages SET media_size=?, media_mime=?, media_duration=? WHERE chat_id=? AND msg_id=?',
                       (*facts, r['chat_id'], r['msg_id']))
        return 'same'
    db.execute(f'UPDATE messages SET {", ".join(c + "=?" for c in cols)} WHERE chat_id=? AND msg_id=?',
               (*(r.get(c) for c in cols), r['chat_id'], r['msg_id']))
    return 'updated'


def purge_chat_messages(db, chat_id):
    db.execute('DELETE FROM chat_aliases WHERE chat_id=?', (chat_id,))       # my names for it go too
    """Delete a chat's stored messages and reset its sync cursors (secure_delete zeroes the pages)."""
    n = db.execute('DELETE FROM messages WHERE chat_id=?', (chat_id,)).rowcount
    db.execute('UPDATE chats SET fwd_id=NULL, back_id=NULL, back_ts=NULL, history_done=0 WHERE chat_id=?', (chat_id,))
    db.commit()
    if n:
        try:
            db.execute('PRAGMA wal_checkpoint(TRUNCATE)')
        except sqlite3.Error:
            pass
    return n


def raw_peer_id(chat_id):
    """Marked id (user 123, basic group -123, channel -100123) -> bare id 123."""
    if chat_id > 0:
        return chat_id
    s = str(chat_id)
    return int(s[4:]) if s.startswith('-100') and len(s) > 4 else -chat_id


def selector_matches(sel, chat):
    """Config/CLI chat selector: an id (marked or bare), @username, 'me' (Saved Messages) or an exact title
    (case and accents ignored)."""
    if isinstance(sel, bool):
        return False
    if isinstance(sel, int) or re.fullmatch(r'\s*-?\d+\s*', str(sel)):
        n = int(sel)
        return n == chat['chat_id'] or n == raw_peer_id(chat['chat_id'])
    s = str(sel).strip()
    if s.casefold() in ('me', 'self', 'saved messages'):
        return chat.get('type') == 'self'
    if s.startswith('@'):
        return bool(chat.get('username')) and s[1:].casefold() == chat['username'].casefold()
    return bool(s) and _norm(s) == _norm(chat.get('title'))



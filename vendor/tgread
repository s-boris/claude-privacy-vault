NAMED_MEDIA = ('document', 'video', 'audio')


def _hsize(n):
    if n is None:
        return 'size ?'
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return f'{n:.0f} {unit}' if unit == 'B' else f'{n:.1f} {unit}'
        n /= 1024


def _listed_chat(chat):
    if chat.get('status') == 'excluded':
        raise UsageError('that chat is excluded from the archive')
    return chat


def cmd_media(args):
    """Files in one chat, metadata only (no message text, no Telegram connection): message id, date, type, file name
    (regex-masked here; the vault filters names further), size + MIME + duration (stored since 2026-10-13; older
    messages: unknown), sender label. The file itself only through the owner's approval (`vault media request`)."""
    cfg = load_config()
    db = open_db()
    pr = config_presenter(db, cfg)
    chat = _listed_chat(resolve_chat(db, args.chat, pr))
    types = [args.type] if args.type else [t for t in FILE_MEDIA if t != 'sticker']
    sql = (f"SELECT * FROM messages WHERE chat_id=? AND service IS NULL AND media_type IN "
           f"({', '.join('?' * len(types))})")
    params = [chat['chat_id'], *types]
    if args.msg:
        sql += ' AND msg_id=?'
        params.append(args.msg)
    if args.since:
        sql += ' AND ts>=?'
        params.append(int(parse_when(args.since)))
    rows = [dict(r) for r in db.execute(sql + ' ORDER BY ts DESC, msg_id DESC LIMIT ?', (*params, max(1, args.n)))]
    items = [{'msg': r['msg_id'], 'date': fmt_ts(r['ts']), 'ts': r['ts'], 'type': r['media_type'],
              'name': mask_text(r['media_desc'])[:200] if r['media_type'] in NAMED_MEDIA and r['media_desc'] else None,
              'size': r.get('media_size'), 'mime': r.get('media_mime'), 'duration': r.get('media_duration'),
              'from': mask_text(pr.sender_label(r, chat))} for r in rows]
    label = mask_text(pr.chat_label(chat))
    if args.json:
        print(json.dumps({'chat': {'id': chat['chat_id'], 'type': chat['type'], 'label': label}, 'items': items},
                         ensure_ascii=False))
        return EXIT_OK
    print(f"{len(items)} file(s) in {label} ({chat['type']}, chat {chat['chat_id']}), newest first; metadata only "
          f"({_sync_age_note(db)}):")
    for it in items:
        extra = ', '.join(x for x in (it['mime'], _hsize(it['size']),
                                      f"{it['duration']} s" if it['duration'] is not None else None) if x)
        print(f"#{it['msg']:<9} {it['date']}  {it['type']:<10} {it['name'] or '-'}  ({extra})  from {it['from']}")
    return EXIT_OK


_ALIAS_RESERVED = re.compile(r'-?\d+|@.*|me|self|saved|saved messages|you|ich|owner|person\s+[a-z]{1,3}')


def cmd_alias(args):
    """My own names (and tags) for chats, e.g. "dive group" -> the Grouptrip chat; accepted wherever --chat is.
    Stored in the archive DB; `exclude add`, `purge` and `wipe --data` delete them with the chat's messages."""
    db = open_db()
    pr = config_presenter(db, load_config())
    a = [x for x in (args.args or []) if x.strip()]
    if args.action == 'list':
        rows = db.execute('SELECT a.name, a.tag, a.chat_id, c.type, c.title FROM chat_aliases a '
                          'LEFT JOIN chats c ON c.chat_id = a.chat_id ORDER BY a.name').fetchall()
        print(f'{len(rows)} chat alias(es):' if rows else 'no chat aliases yet (tgread alias set CHAT NAME)')
        for r in rows:
            chat = {'chat_id': r['chat_id'], 'type': r['type'], 'title': r['title']}
            lbl = mask_text(pr.chat_label(chat)) if r['type'] else '(not in the archive)'
            print(f"{r['name']}" + (f" [tag {r['tag']}]" if r['tag'] else '')
                  + f" -> {lbl} ({r['type'] or '?'}, chat {r['chat_id']})")
        return EXIT_OK
    if args.action == 'rm':
        if len(a) != 1:
            raise UsageError('usage: tgread alias rm NAME')
        n = db.execute('DELETE FROM chat_aliases WHERE name=?', (alias_key(a[0]),)).rowcount
        db.commit()
        if not n:
            raise UsageError(f'no chat alias {alias_key(a[0])!r} (tgread alias list)')
        print(f'chat alias removed: {alias_key(a[0])}')
        return EXIT_OK
    if len(a) != 2:
        raise UsageError('usage: tgread alias set CHAT NAME [--tag TAG]')
    name = alias_key(a[1])
    if not 0 < len(name) <= 60 or _ALIAS_RESERVED.fullmatch(name):
        raise UsageError('an alias is 1..60 characters and not a number, @username, "me" or "Person X"')
    chat = _listed_chat(resolve_chat(db, a[0], pr))
    tag = (alias_key(args.tag)[:60] or None) if args.tag else None
    db.execute('INSERT INTO chat_aliases(name, chat_id, tag, created_ts) VALUES (?, ?, ?, ?) ON CONFLICT(name) DO '
               'UPDATE SET chat_id=excluded.chat_id, tag=excluded.tag', (name, chat['chat_id'], tag, int(time.time())))
    db.commit()
    print(f"chat alias set: {name}" + (f" [tag {tag}]" if tag else '')
          + f" -> {mask_text(pr.chat_label(chat))} ({chat['type']}, chat {chat['chat_id']})")
    return EXIT_OK


def _fts_any(words):
    terms = [re.sub(r'[^\w]+', '', w) for w in words]
    return ' OR '.join(f'"{t}"*' for t in terms if t)


def cmd_find_chat(args):
    """Which chat is it? Ranked by my alias/tag, then the chat title, then the names of people who posted there, then
    how many stored messages match (FTS), then recency. Labels and counts only: no message text, no LLM. Excluded
    chats never appear."""
    db = open_db()
    pr = config_presenter(db, load_config())
    words = _norm(args.query).split()
    if not words:
        raise UsageError('find-chat needs a query')
    since = int(parse_when(args.since)) if args.since else 0
    chats = {r['chat_id']: dict(r) for r in db.execute("SELECT * FROM chats WHERE status != 'excluded'")}
    alias_of, score = {}, {}

    def entry(cid):
        return score.setdefault(cid, {'alias': 0, 'title': 0, 'names': 0, 'hits': 0, 'last': None})
    for r in db.execute('SELECT name, tag, chat_id FROM chat_aliases ORDER BY name'):
        if r['chat_id'] not in chats:
            continue
        alias_of.setdefault(r['chat_id'], r['name'])
        n = sum(w in _norm(f"{r['name']} {r['tag'] or ''}") for w in words)
        if n > entry(r['chat_id'])['alias']:
            score[r['chat_id']]['alias'], alias_of[r['chat_id']] = n, r['name']
    for cid, c in chats.items():
        n = sum(w in _norm(c['title'] or '') for w in words)
        if n:
            entry(cid)['title'] = n
    people = [dict(r) for r in db.execute('SELECT user_id, first_name, last_name, username FROM people WHERE is_self=0')]
    for w in (w for w in words if len(w) >= 3):
        ids = [p['user_id'] for p in people
               if w in _norm(' '.join(x for x in (p['first_name'], p['last_name'], p['username']) if x)).split()]
        if not 0 < len(ids) <= 50:
            continue
        for (cid,) in db.execute(f"SELECT DISTINCT chat_id FROM messages WHERE sender_id IN ({', '.join('?' * len(ids))})",
                                 ids):
            if cid in chats:
                entry(cid)['names'] += 1
    q = _fts_any(words)
    if q:
        try:
            rows = db.execute('SELECT m.chat_id AS cid, COUNT(*) AS n, MAX(m.ts) AS last FROM messages_fts '
                              'JOIN messages m ON m.id = messages_fts.rowid WHERE messages_fts MATCH ? AND m.ts >= ? '
                              'GROUP BY m.chat_id', (q, since)).fetchall()
        except sqlite3.OperationalError as e:
            raise UsageError(f'find-chat: the full-text index refused the query ({e})')
        for r in rows:
            if r['cid'] in chats:
                e = entry(r['cid'])
                e['hits'], e['last'] = r['n'], r['last']
    score = {k: v for k, v in score.items() if v['alias'] or v['title'] or v['names'] or v['hits']}

    def rank(cid):
        e = score[cid]
        return (e['alias'], e['title'], e['names'], e['hits'], e['last'] or chats[cid].get('top_ts') or 0)
    ranked = sorted(score, key=rank, reverse=True)[:max(1, args.n)]
    if not ranked:
        print(f'no chat matches {mask_text(args.query)!r} (aliases, titles, names, stored messages; '
              f'{_sync_age_note(db)})')
        return EXIT_OK
    print(f'{len(ranked)} chat(s) for {mask_text(args.query)!r}, best first (alias/tag, title, names, matching '
          f'messages, recency); labels and counts only:')
    for cid in ranked:
        e, c = score[cid], chats[cid]
        why = [k for k in ('alias', 'title', 'names') if e[k]]
        print(f"{cid:>15}  {c['type']:<10} {mask_text(pr.chat_label(c))}"
              + (f" · alias {alias_of[cid]}" if cid in alias_of else '')
              + f" · {e['hits']} matching msg(s)" + (f" · last hit {fmt_ts(e['last'])[:10]}" if e['last'] else '')
              + (f" · match: {', '.join(why)}" if why else ''))
    return EXIT_OK


WHO_MAX_GROUPS = 20


def cmd_who(args):
    """A person: their DM chat and the groups where they posted (message counts + last date, max 20). Labels and
    counts only, same labels as `chats`; excluded chats never appear."""
    db = open_db()
    pr = config_presenter(db, load_config())
    ids, outgoing = resolve_senders(db, args.name)
    if outgoing:
        raise UsageError('that is you (the owner); `tgread chats` lists your chats')
    chats = {r['chat_id']: dict(r) for r in db.execute("SELECT * FROM chats WHERE status != 'excluded'")}
    ids = sorted(ids)
    if len(ids) > 5:
        print(f'{len(ids)} people match {mask_text(args.name)!r}; showing 5 (be more specific, or use an id)')
    for sid in ids[:5]:
        p = db.execute('SELECT first_name, last_name FROM people WHERE user_id=?', (sid,)).fetchone()
        name = (' '.join(x for x in (p['first_name'], p['last_name']) if x) if p
                else (chats.get(sid) or {}).get('title'))
        who = mask_text(pr.sender_label({'out': 0, 'sender_id': sid, 'sender_name': name}, chats.get(sid)))
        dm = chats.get(sid) if (chats.get(sid) or {}).get('type') in ('user', 'bot') else None
        if dm:
            n, last = db.execute('SELECT COUNT(*), MAX(ts) FROM messages WHERE chat_id=?', (sid,)).fetchone()
            print(f"{who} (user {sid}): DM chat {sid} · {n} msg(s)" + (f" · last {fmt_ts(last)[:10]}" if last else ''))
        else:
            print(f"{who} (user {sid}): no DM chat in the archive")
        rows = [r for r in db.execute('SELECT chat_id, COUNT(*) AS n, MAX(ts) AS last FROM messages WHERE sender_id=? '
                                      'AND chat_id != ? GROUP BY chat_id ORDER BY last DESC', (sid, sid))
                if r['chat_id'] in chats]
        for r in rows[:WHO_MAX_GROUPS]:
            c = chats[r['chat_id']]
            print(f"  {r['chat_id']:>15}  {c['type']:<10} {mask_text(pr.chat_label(c))} · {r['n']} msg(s) · last "
                  f"{fmt_ts(r['last'])[:10]}")
        if len(rows) > WHO_MAX_GROUPS:
            print(f'  … and {len(rows) - WHO_MAX_GROUPS} more group(s)')
        if not rows:
            print('  no group messages from them in the archive')
    return EXIT_OK


def _cron_state():
    try:
        lines = [x.strip() for x in CRONTAB_PATH.read_text('utf-8').splitlines() if 'tgread sync' in x]
    except OSError:
        return 'no ~/crontab'
    if any(not x.startswith('#') for x in lines):
        try:
            inst = subprocess.run(['crontab', '-l'], capture_output=True, text=True, timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            return 'enabled in ~/crontab'
        if any('tgread sync' in x and not x.strip().startswith('#') for x in inst.splitlines()):
            return 'enabled (installed)'
        return 'enabled in ~/crontab but NOT installed (run: crontab ~/crontab)'
    return 'present but commented out (enable after the login works)' if lines else 'absent'


def cmd_status(args):
    print(f'tgread {VERSION} · pinned Telethon {TELETHON_PIN} · guard profiles: '
          + ', '.join(f'{p} ({len(n)} request types)' for p, n in PROFILES.items()))
    try:
        preflight()
        print('permissions: ok (session and credentials private)')
    except PermError as e:
        print(f'permissions: REFUSED - {e}')
    print(f"credentials: {'present' if CREDS_PATH.exists() else 'missing (tgread set-credentials)'}")
    print(f"session: {'present' if SESSION_PATH.exists() else 'missing (tgread login-qr)'}")
    cfg = None
    try:
        cfg = load_config()
    except TgreadError as e:
        print(f'config: ERROR - {e}')
    db = _db_or_none()
    if db is not None:
        me = meta_get(db, 'me_name')
        if me:
            print(f"account: {me} (id {meta_get(db, 'me_id')}), logged in {fmt_ts(float(meta_get(db, 'login_ts') or 0))}")
        n_msgs = db.execute('SELECT COUNT(*) FROM messages').fetchone()[0]
        n_chats = db.execute("SELECT COUNT(*) FROM chats WHERE status='sync' AND in_dialogs=1").fetchone()[0]
        n_skip = db.execute("SELECT COUNT(*) FROM chats WHERE status!='sync'").fetchone()[0]
        span = db.execute('SELECT MIN(ts), MAX(ts) FROM messages').fetchone()
        print(f'archive: {n_msgs} messages in {n_chats} synced chats ({n_skip} excluded/skipped/erroring), '
              f'{fmt_ts(span[0])} .. {fmt_ts(span[1])}; {DB_PATH} ({DB_PATH.stat().st_size / 1e6:.1f} MB)')
        if cfg:
            cutoff = int(now_ts() - cfg['max_history_days'] * 86400)
            pend = sum(1 for r in db.execute("SELECT back_id, back_ts, history_done FROM chats WHERE status='sync'")
                       if needs_backfill(r, cutoff))
            print(f'backfill: {pend} chats still have older history to fetch (window {cfg["max_history_days"]} days)')
        st = meta_get(db, 'last_sync_stats')
        print(f"{_sync_age_note(db)}" + (f'; last result {st}' if st else ''))
        fu = float(meta_get(db, 'flood_until') or 0)
        if fu > now_ts():
            print(f'flood wait: Telegram asked us to pause until {fmt_ts(fu)}')
        fc = int(meta_get(db, 'fail_count') or 0)
        if fc:
            print(f'failures: {fc} sync failure(s) in a row')
        hb = float(meta_get(db, 'live_heartbeat') or 0)
        if cfg and (cfg['live_events'] or hb):
            q = db.execute('SELECT COUNT(*), COALESCE(MAX(qid), 0) FROM live_queue').fetchone()
            state = (f'listening (heartbeat {fmt_ts(hb)})' if time.time() - hb < 120
                     else 'not running' + (f' (last heartbeat {fmt_ts(hb)})' if hb else ''))
            print(f"live: {state}; event feed {'on' if cfg['live_events'] else 'off'}, queue {q[0]} message(s), "
                  f"last id {q[1]}")
    else:
        print('archive: no database yet (tgread sync)')
    print(f'cron: {_cron_state()}')
    if cfg:
        try:
            llm = llm_command(cfg)
            print(f'local LLM: {llm} (anonymize args {cfg["local_llm_anonymize_args"]}, summary args '
                  f'{cfg["local_llm_summary_args"]}; input limit {cfg["local_llm_max_chars"]} chars, timeout '
                  f'{cfg["local_llm_timeout_seconds"]} s)' + ('' if cfg['use_local_llm'] else ' - DISABLED in config'))
        except LLMUnavailable as e:
            print(f'local LLM: unavailable ({e}) -> message output falls back to regex masks + pseudonyms')
        print(f"privacy: pseudonyms {'on' if cfg['pseudonymize_names'] else 'off'}, "
              f"{len(cfg['exclude_chats'])} excluded chat(s), include_only {len(cfg['include_only'])}")
    if args.check:
        api = load_creds()
        if not SESSION_PATH.exists():
            raise NotAuthorized('check: no session yet (tgread login-qr)')
        with Lock(wait=30) as lk:
            if not lk.ok:
                raise TempFail('another tgread command is running')

            async def go():
                tg = ReadOnlyTelegram(*api, profile='read')
                await tg.connect()
                try:
                    if not await tg.is_authorized():
                        return None
                    return await tg.get_me()
                finally:
                    await tg.disconnect()
            me = asyncio.run(go())
        print(f'check: authorized as {display_name(me)} (id {me.id})' if me else 'check: NOT authorized (login-qr)')
        if GUARD.blocked:
            raise ReadOnlyViolation('the guard blocked: ' + ', '.join(sorted({n for _, n in GUARD.blocked})))
    return EXIT_OK



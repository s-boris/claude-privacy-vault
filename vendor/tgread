def now_ts():
    v = os.environ.get('TGREAD_NOW')
    return float(v) if v else time.time()


def fmt_ts(ts):
    return dt.datetime.fromtimestamp(ts, TZ).strftime('%Y-%m-%d %H:%M') if ts else '-'


def iso_local(ts):
    return dt.datetime.fromtimestamp(ts, TZ).isoformat(timespec='seconds')


def parse_when(s):
    """'7d', '24h', '90m', '2w', 'today', 'yesterday', '2026-10-01', '2026-10-01 18:00', '1.10.2026' (Zurich),
    '@1760000000' (epoch seconds: the vault's chunked summaries pass exact window bounds)."""
    s = (s or '').strip().lower()
    m = re.fullmatch(r'@(\d{9,11}(?:\.\d{1,6})?)', s)
    if m:
        return float(m[1])
    m = re.fullmatch(r'(\d+)\s*([mhdw])', s)
    if m:
        return now_ts() - int(m[1]) * {'m': 60, 'h': 3600, 'd': 86400, 'w': 604800}[m[2]]
    today = dt.datetime.fromtimestamp(now_ts(), TZ).replace(hour=0, minute=0, second=0, microsecond=0)
    if s == 'today':
        return today.timestamp()
    if s == 'yesterday':
        return (today - dt.timedelta(days=1)).replace(tzinfo=TZ).timestamp()
    for fmt in ('%Y-%m-%d', '%Y-%m-%d %H:%M', '%Y-%m-%dt%H:%M', '%d.%m.%Y', '%d.%m.%Y %H:%M'):
        try:
            return dt.datetime.strptime(s, fmt).replace(tzinfo=TZ).timestamp()
        except ValueError:
            pass
    raise UsageError(f'cannot parse the date {s!r} (use e.g. 7d, 24h, today, 2026-10-01)')


def _norm(s):
    """Casefold + strip accents + collapse spaces: 'Zürich  Gang' -> 'zurich gang'."""
    s = unicodedata.normalize('NFKD', str(s or ''))
    s = ''.join(c for c in s if not unicodedata.combining(c))
    return ' '.join(s.casefold().split())


def eprint(*a):

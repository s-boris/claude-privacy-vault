# - Chats (default): a currency amount from MONEY_MIN up always goes; any amount (also a bare number from 100 up, with
#   cents, or with k/Mio) goes when a money/business/payment word is on the same line within MONEY_WINDOW characters;
#   a number right after an amount label (RX_LABEL: "Total:", "Betrag", "Rechnungsbetrag", "amount due", ...) goes
#   when it has a currency, cents, k/Mio or is from 100 up.
# - all_amounts (--all-amounts, the owner's own mail: receipts, orders, bank notices): every
#   currency amount of any size, every number right after an amount label, and bare cents that can't be a time.
# Dates, times ("um 19.30"), years, percentages, tgread refs (#123), chat ids and URL parameters stay. In chats, small
# everyday costs without such a word (35.- pro Person) and a bill's amount next to its due date stay.
# Mail (an address and phone must never become "Examplestrasse 1, [amount] Exampletown ... (+41) [amount]"): the money-word rule
# for BARE numbers is for chats only; in mail a number is an amount only with a currency, an amount label, cents, or a
# k/Mio suffix next to a money word. In both modes a postcode before a place ("1234 Exampletown", "CH-1234 Exampletown")
# and a phone-like number (after "+41", "(+41)", "Tel", or 9+ digits in a row) are never amounts.
MONEY_MIN = 5000
MONEY_WINDOW = 120
# Swiss German amounts ("12'000 Franke Schulde bi de Bank"): Swiss German currency words (Franke,
# Fränkli, Stutz, Chlotz, Rappe, "Fr" without a dot), currency words in any case ("chf 500"), more thousands separators
# (12’000, 12´000, 12 000 with a no-break/thin space; a plain space only next to a currency: "CHF 12 000", "12 000
# Franke"), "Tausend"/"tuusig"/"Mille"/"grand" as multipliers, debt nouns as money words ("Schulde", "Betreibig"), and
# amounts written in words next to a currency or a money word ("zwölftausend Franke", "twelve thousand dollars").
_TS = "'’‘´ʼ"                                    # Swiss thousands separators: 12'000, 12’000, 12´000
_TSP = "   "                      # no-break, narrow no-break and thin space as thousands separators
_CUR_PRE = r"(?i:CHF|SFr\.?|Fr\.|EUR|€|USD|US\$|\$|£|GBP)"
_CUR_POST = (r"(?i:CHF|SFr\.?|Fr\.?(?!\s?\d)|Franken|Franke|Frankä|Fränkli|Fränkle|Frankli|Rappen?|Räppli|Stutz|Stütz|"
             r"Stutzli|Stützli|Chlotz|Chlötz|Chlötzli|EUR|Euros?|€|USD|Dollars?|\$|£|GBP|Pfund|bucks|francs?)"
             r"(?![^\W\d_])")
_SUF = (r"(?i:k|Tsd\.?|tausend|tuusig|tusig|tausig|Mille|Mio\.?|Millionen|millions?|Mia\.?|Mrd\.?|Milliarden?|bn|"
        r"billions?|grand)(?![^\W\d_])")
_MULT = {"k": 1e3, "tsd": 1e3, "tausend": 1e3, "tuusig": 1e3, "tusig": 1e3, "tausig": 1e3, "mille": 1e3, "grand": 1e3,
         "mio": 1e6, "million": 1e6, "millionen": 1e6, "millions": 1e6,
         "mia": 1e9, "mrd": 1e9, "milliarde": 1e9, "milliarden": 1e9, "bn": 1e9, "billion": 1e9, "billions": 1e9}
RX_AMOUNT = re.compile(
    r"(?<![\w.,/:#=&?+" + _TS + r"-])"
    r"(?:(?P<pre>" + _CUR_PRE + r")\s?)?"
    r"(?P<num>\d{1,3}(?:[" + _TS + _TSP + r"]\d{3})+(?:[.,]\d{1,2})?"
    r"|(?(pre)\d{1,3}(?: \d{3})+(?:[.,]\d{1,2})?(?![\d" + _TS + r"])|(?!))"            # CHF 12 000
    r"|\d{1,3}(?: \d{3})+(?:[.,]\d{1,2})?(?=\s?(?:" + _CUR_POST + r"|\.[-–]))"         # 12 000 Franke
    r"|\d{1,3}(?:[.,]\d{3})+(?![.,]?\d)|\d+(?:[.,]\d{1,2})?)"
    r"(?:\s?(?P<suf>" + _SUF + r"))?"
    r"(?:(?P<dash>\.[-–])|\s?(?P<post>" + _CUR_POST + r"))?"
    r"(?![^\W_]|[" + _TS + r"]\d)")
# amounts in words: a number word with a magnitude (zwölftausend, füfzähtuusig, zwei Millionen, e Million, twelve
# thousand, a million, five grand); masked next to a currency word or a money word (not "hundert Prozent", "tausend Lüt")
_NUM_MORPH = (r"(?:eins|eine|ein|zwei|zwöi|drei|drü|vier|fünf|föif|füf|sechs|sächs|säch|sech|sieben|sieb|sibe|acht|ach|"
              r"neun|nün|zehn|zäh|elf|zwölf|zwanzig|zwänzg|dreissig|dreißig|drissg|zig|ßig|ssig|zg|und|e|hundert|"
              r"tausend|tuusig|tusig|tausig)")
_EN_NUM = (r"(?:one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|"
           r"seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred)")
RX_WORD_AMOUNT = re.compile(
    r"(?i)(?<![^\W\d_])(?:"
    r"(?=[^\W\d_]*(?:hundert|tausend|tuusig|tusig|tausig))" + _NUM_MORPH + r"+"
    r"|(?:" + _NUM_MORPH + r"+|en|ei|eis|a|an)[\s-]+(?:millionen|million|mio\.?|milliarden?|mia\.?|mrd\.?|mille|tausend|"
    r"tuusig)"
    r"|(?:" + _EN_NUM + r"|a|an)(?:[\s-]+(?:" + _EN_NUM + r"|and))*[\s-]+(?:hundred|thousand|million|billion|grand)s?"
    r")(?![^\W\d_])"
    r"(?!\s*(?:prozent|%|percent|pro|mal|times|jahre?|years?|meter|km|kilo\w*|kg|leute|lüt|people|personen|gäst\w*|"
    r"guests?|mitglieder|members?|follower\w*|views|likes|stück|stk)(?![^\W\d_]))"
    r"(?:\s?(?P<post>" + _CUR_POST + r"))?")
MONEY_CUE = re.compile(
    r"(?i)(?<![^\W\d_])(?:invest\w*|invesch\w*|aktie\w*|stocks?|shares|etfs?|fonds|funds?|depot\w*|portfolio\w*|"
    r"portefeuille|krypto\w*|crypto\w*|bitcoin|btc|ethereum|trading|trades?|traded|tranche\w*|rendite\w*|dividend\w*|"
    r"zinsen|hypothek\w*|mortgage|kredit|darlehen|loan|schulden|schulde|schuldä|schuldenberg\w*|schuldenfalle|"
    r"verschuld\w*|betreibung\w*|betreibig\w*|pfändung\w*|gepfändet|konkurs\w*|bankrupt\w*|pleite|pleiti|debts?|"
    r"indebted|gspart|gespart|geerbt|erbschaft\w*|inherit\w*|"
    r"lohn|löhne|lohnerhöhung|"
    r"gehalt|gehälter|salär|salary|salaries|wages?|bonus|einkommen|income|verdien\w*|earn(?:s|ed|ing)?|vermögen|"
    r"wealth|erspart\w*|ersparnis\w*|savings|sparkonto|sparplan|kontostand|säule\s?3a|3a|pensionskasse|umsatz|"
    r"revenue|turnover|gewinn\w*|profit\w*|verlust\w*|marge|margin|provision|commission|deals|deal\s+(?:mit|with)|geschäft\w*|"
    r"business|firma|company|startup|offerte\w*|verhandl\w*|negotiat\w*|kaufpreis|kauf|kaufe|kauft|gekauft|"
    r"chauf|chaufe|chauft|verkauf\w*|bought|buying|purchas\w*|bulk|resell\w*|wiederverkauf\w*|steuern|"
    r"steuerrechnung|taxes|"
    # v3.1: payment acts and receipts ("paid $108.34", "per TWINT überwiesen", "hat mich 120.- gekostet")
    r"paid|pay(?:s|ing)?|payments?|bezahl\w*|(?:ein|aus|zurück|ab|an|nach|vor)?zahl(?:e|en|st|t|te|ten|ed|sch|ung\w*|bar)|"
    r"überw[ie]+s\w*|abgebucht|belast(?:et|ung\w*)|gutschrift\w*|refund\w*|rückerstatt\w*|erstattet|charged|billed|"
    r"receipts?|quittung\w*|twint|spent|ausgegeben|gekostet)(?![^\W\d_])")
# Amount labels right before a number (v3.1). strong: a label in chats too; sep: in chats only with ':' or '='
# ("Total: 45.00", but not "kostet total 1450.-"); weak (prices, fees, taxes): only with --all-amounts.
RX_LABEL = re.compile(
    r"(?i)(?<![^\W\d_])(?:(?P<strong>(?:grand\s+|order\s+|sub-?)total|amount\s+(?:due|paid|charged|payable)|"
    r"balance\s+due|you\s+paid|charged|refund(?:ed)?|[^\W\d_]*betrag|[^\W\d_]*summe|zu\s+(?:be)?zahlen|abgebucht|"
    r"belastet|gutschrift|saldo|montant|importo)"
    r"|(?P<sepreq>total|totale|amount|balance|paid|payment|zahlung|überweisung|bezahlt)"
    r"|(?P<weak>price|prix|[^\W\d_]*preis|costs?|[^\W\d_]*kosten|fees?|[^\W\d_]*gebühr(?:en)?|tax|vat|mwst|tip))"
    r"\s*(?:\([^()\n]{0,40}\)\s*)?(?P<sep>[:=])?\s*$")
_DAY, _MON = r"(?:0?[1-9]|[12]\d|3[01])", r"(?:0?[1-9]|1[0-2])"
MONEY_KEEP = re.compile(
    r"(?<!\d)" + _DAY + r"\.\s?" + _MON + r"\.(?:\s?(?:19|20)?\d{2}(?!\d))?"          # 18.10. / 18.10.2026
    r"|(?<!\d)" + _DAY + r"\.\s?[–-]\s?" + _DAY + r"\."                                  # 16.–18.
    r"|(?<!\d)\d{1,2}[:.]\d{2}\s?(?:uhr|h)\b|(?<!\d)\d{1,2}:\d{2}(?!\d)"              # 19.00 Uhr, 14:00
    r"|\b(?:19|20)\d{2}-\d{2}-\d{2}\b|\bS&P\s?500\b|\d+(?:[.,]\d+)?\s?%"
    r"|\b(?:um|ab|bis|gegen|at|from|until|till)\s+(?:[01]?\d|2[0-3])[.:][0-5]\d(?!\d)", re.I)  # um 19.30


POSTCODE_BEFORE = re.compile(r"(?i)(?:^|[,;(]\s*|\b(?:CH|FL|D|A|F|I)\s?-\s?|\b(?:plz|zip|postcode|postal\s+code)\s*:?\s*|"
                             r"\b(?:in|an|nach|to|at|bei|von|aus|ab)\s+)$")
POSTCODE_AFTER = re.compile(r"\s+[A-ZÄÖÜ][a-zäöüéèàç]{2,}")
PHONE_BEFORE = re.compile(r"(?i)(?:\(\s?(?:\+|00)\d{1,3}\s?\)|(?<![\w+])(?:\+|00)\d{1,3}|\b(?:tel|telefon|phone|natel|"
                          r"mobile?|handy|fon|whatsapp)\b\.?\s*:?)[\s\d().\-/]*$")


def not_an_amount(text, s, e, bare, ls):
    """A postcode before a place name or a phone-like number: never [amount]."""
    if re.fullmatch(r"[1-9]\d{3,4}", bare):
        after = POSTCODE_AFTER.match(text, e)
        if after and POSTCODE_BEFORE.search(text, max(ls, s - 16), s) \
                and not MONEY_CUE.match(text, after.start() + len(after.group(0)) - len(after.group(0).lstrip()),
                                        after.end()):
            return True
    if re.fullmatch(r"\d{9,}", bare):
        return True
    return PHONE_BEFORE.search(text, max(ls, s - 30), s) is not None


def amount_value(m):
    num = re.sub("[ " + _TS + _TSP + "]", "", m.group("num"))
    if re.fullmatch(r"\d{1,3}(?:[.,]\d{3})+", num):
        num = re.sub(r"[.,]", "", num)
    try:
        v = float(num.replace(",", "."))
    except ValueError:
        return 0.0
    suf = (m.group("suf") or "").lower().rstrip(".")
    return v * _MULT.get(suf, 1)


def _maybe_time(num):
    t = re.fullmatch(r"(\d{1,2})[.:](\d{2})", num)
    return bool(t) and int(t.group(1)) <= 23 and int(t.group(2)) <= 59


def money_pass(text, all_amounts=False):
    """-> (text with money amounts -> [amount], hits). See MONEY_MIN / MONEY_CUE / RX_LABEL above. all_amounts: the
    owner's own mail (--all-amounts): every currency amount and labelled number, and bare cents that can't be a time."""
    keep = [(k.start(), k.end()) for k in MONEY_KEEP.finditer(text)]
    hits = [0]

    def repl(m):
        s, e = m.span()
        if any(s < ke and ks < e for ks, ke in keep):
            return m.group(0)
        cur = bool(m.group("pre") or m.group("post") or m.group("dash"))
        v = amount_value(m)
        bare, suf = m.group("num"), m.group("suf")
        cents = bool(re.search(r"[.,]\d{2}$", bare)) and not re.fullmatch(r"\d{1,3}(?:[.,]\d{3})+", bare)
        year = not (cur or suf or cents) and bool(re.fullmatch(r"(?:19|20)\d{2}", bare))
        ls = text.rfind("\n", 0, s) + 1
        le = text.find("\n", e)
        le = len(text) if le < 0 else le
        lab = RX_LABEL.search(text, max(ls, s - 60), s)
        amountish = cur or suf or cents or (v >= 100 and not year)
        if not (cur or lab) and not_an_amount(text, s, e, bare, ls):
            return m.group(0)                                    # a postcode or a phone number (v3.1 fix)
        if all_amounts:
            if (cur or lab) and not year:
                hits[0] += 1
                return "[amount]"
            if cents and not _maybe_time(bare):
                hits[0] += 1
                return "[amount]"
            if not suf:
                return m.group(0)                                # mail: a bare number near a money word is no amount
        elif cur and v >= MONEY_MIN:
            hits[0] += 1
            return "[amount]"
        elif lab and (lab.group("strong") or (lab.group("sepreq") and lab.group("sep"))) and amountish:
            hits[0] += 1
            return "[amount]"
        if not MONEY_CUE.search(text, max(ls, s - MONEY_WINDOW), min(le, e + MONEY_WINDOW)):
            return m.group(0)
        if not amountish:
            return m.group(0)
        if cents and not (cur or suf) and _maybe_time(bare):
            return m.group(0)                                    # "bezahlt, Treffpunkt 19.30": a time
        hits[0] += 1
        return "[amount]"
    text = RX_AMOUNT.sub(repl, text)

    def wrepl(m):                                                # amounts in words
        s, e = m.span()
        ls = text.rfind("\n", 0, s) + 1
        le = text.find("\n", e)
        le = len(text) if le < 0 else le
        if m.group("post") or (not all_amounts and MONEY_CUE.search(text, max(ls, s - MONEY_WINDOW),
                                                                    min(le, e + MONEY_WINDOW))):
            hits[0] += 1
            return "[amount]"
        return m.group(0)
    return RX_WORD_AMOUNT.sub(wrepl, text), hits[0]


# Money sentence backstop (the model can leave sentences like "[amount] in den Index-ETF investiert" or
# "12'000 Franke Schulde bi de Bank" visible). Policy: anyone's investments, portfolio, trading and
# money troubles (debts), the owner's own included, are [private: money]. In code, after the model and the money net,
# a sentence of a message body becomes "[private: money]" when it has
#   - an investment word (ETF, Aktie(n), Fonds, Depot, Portfolio, Krypto, Bitcoin/BTC, stocks, Sparplan, Säule 3a,
#     MSCI, Dividende, Rendite, Trading) with a personal sign: I/you/we/my/his/Sie..., an [amount], or a buy/sell/hold
#     or invest verb;
#   - an investing verb (investiert, inveschtiert, invested, nachgekauft) with a personal sign, an [amount] or an
#     investment word; not "Ziit/Zeit/time/energy investiert" without an amount or investment word;
#   - a debt noun (Schulde(n), verschuldet, Betreibung/Betreibig, Pfändung, Privatkonkurs, pleite, debt(s)) with a
#     personal sign or an [amount]. "Du schuldsch mir no 18.- fürs Kino" (a verb) and "technical debt" stay.
# Chat prefixes, tgread tails, "Subject: " and list bullets stay. Not with --keep-own-money (admin documents);
# regex_pass runs it after the money net: on the anonymized text and again on paraphrases and summaries.
_INVEST_NOUN = (r"etf\w*|[^\W\d_]*aktie\w*|[^\W\d_]*fonds|depot\w*|portfolio\w*|portefeuille\w*|krypto\w*|crypto\w*|"
                r"bitcoin\w*|btc|ethereum|altcoins?|stocks|stock\s+(?:market|portfolio|options?|picks?)|equities|"
                r"index\s?funds?|mutual\s?funds?|brokerage\w*|broker|wertschrift\w*|wertpapier\w*|[^\W\d_]*sparplan\w*|"
                r"säule\s?3a|msci|nasdaq|vanguard|ishares|dividend\w*|rendite\w*|trading|daytrad\w*|getradet|tradet|"
                r"traden")
_INVEST_VERB = r"invest(?!ig)\w*|invesch\w*|nachgekauft|nachkauf\w*|nachgchauft|nochegchauft"
_DEBT_NOUN = (r"schulden|schulde|schuldä|schuldenberg\w*|schuldenfalle|verschuld\w*|betreibung\w*|betreibig\w*|"
              r"pfändung\w*|gepfändet|privatkonkurs\w*|debts?|indebted|overdraft\w*|pleite|pleiti|bankrott|bankrupt\w*")
MONEY_TOPIC = re.compile(r"(?i)(?<![^\W\d_])(?:(?P<inv>" + _INVEST_NOUN + r")|(?P<verb>" + _INVEST_VERB + r")|(?P<debt>"
                         + _DEBT_NOUN + r"))(?![^\W\d_])")
MONEY_PERSONAL = re.compile(
    r"(?i)(?<![^\W\d_])(?:ich|mir|mich|mi|mis|mini|mine|mim|minere|mein\w*|du|di|dir|dich|dis|dini|dine|dim|dinere|"
    r"dein\w*|er|sie|si|ihm|ihn|ihr\w*|sein\w*|sini|sis|wir|mer|mier|üs|eus|uns|unser\w*|euse|eusi|euch|eue|euer\w*|"
    r"eure\w*|i(?=\s+(?:ha|han|hett|hetti|bi|bin|cha|chan|wett|wott|mues|würd|hät))|me|my|myself|we|us|our\w*|you|"
    r"your\w*|he|she|him|his|her|hers|they|them|their\w*)(?![^\W\d_])")
MONEY_DEAL_VERB = re.compile(
    r"(?i)(?<![^\W\d_])(?:kauf\w*|gekauft|chauf\w*|gchauft|kouft|verkauf\w*|verchauf\w*|vercheuf\w*|buy\w*|bought|"
    r"sell\w*|sold|halte|hält|halten|hold\w*|besitz\w*|own(?:s|ed)?|angelegt|aaglegt|anlegen|eingezahlt|iizahlt|"
    r"ibezahlt|gespart|gspart|sparen|spare)(?![^\W\d_])")
INVEST_EFFORT = re.compile(
    r"(?i)(?<![^\W\d_])(?:zeit|ziit|time|energie|energy|mühe|müeh|effort|arbeit|work|stunde\w*|stund|std|hours?|"
    r"herzblut|liebe|love|nerven|kraft|gedanke\w*|thoughts?|schweiss|tränen|freizeit|wochenende|weekend)(?![^\W\d_])")
TECH_DEBT = re.compile(r"(?i)(?<![^\W\d_])(?:technical|tech|technische[nr]?|technischi)[\s-]+(?:debts?|schulden?)"
                       r"(?![^\W\d_])")
BODY_LEAD = re.compile(r"(?:Subject:[ \t]?|[-*•][ \t]+|\d{1,2}[.)][ \t]+)")


def money_sentence(sent):
    """True: the sentence talks about someone's investments or debts (see the money sentence backstop above)."""
    s = TECH_DEBT.sub(" ", sent)
    inv = verb = debt = False
    for m in MONEY_TOPIC.finditer(s):
        inv, verb, debt = inv or bool(m.group("inv")), verb or bool(m.group("verb")), debt or bool(m.group("debt"))
    if not (inv or verb or debt):
        return False
    amount = "[amount]" in s.lower()
    personal = MONEY_PERSONAL.search(s) is not None
    if verb and not (inv or amount) and INVEST_EFFORT.search(s):
        verb = False                                             # "Ziit investiert": time, not money
    if inv and (personal or amount or verb or MONEY_DEAL_VERB.search(s)):
        return True
    if verb and (personal or amount):
        return True
    return debt and (personal or amount)


def money_backstop(text):
    """-> (text with every investment/debt sentence of a message body -> '[private: money]', hits)."""
    if not MONEY_TOPIC.search(text):
        return text, 0
    spans = []
    for lm in re.finditer(r"[^\n]+", text):
        bs, be = body_bounds(text, lm.start(), lm.end())
        lead = BODY_LEAD.match(text, bs, be)
        if lead:
            bs = lead.end()
        if bs >= be or not MONEY_TOPIC.search(text, bs, be):
            continue
        cuts = [bs] + [p for p in sentence_ends(text, bs, be) if bs < p < be] + [be]
        for x, y in zip(cuts, cuts[1:]):
            while x < y and text[x].isspace():
                x += 1
            while y > x and text[y - 1].isspace():
                y -= 1
            if x < y and money_sentence(text[x:y]):
                if spans and not text[spans[-1][1]:x].strip() and "\n" not in text[spans[-1][1]:x]:
                    spans[-1] = (spans[-1][0], y)                # adjacent sentences share one placeholder
                else:
                    spans.append((x, y))
    out, last = [], 0
    for s, e in spans:
        out += [text[last:s], "[private: money]"]
        last = e
    out.append(text[last:])
    return "".join(out), len(spans)


CONTENT_HOSTS = re.compile(r"(?i)^(?:https?://)?(?:www\.|m\.|music\.)?(youtube\.com|youtu\.be|open\.spotify\.com|"
                           r"soundcloud\.com|x\.com|twitter\.com|instagram\.com|tiktok\.com|reddit\.com|"
                           r"[a-z]{2}\.wikipedia\.org|github\.com|imdb\.com|ra\.co|galaxus\.ch|digitec\.ch)(/[^?#]*)?(\?[^#]*)?")


def clean_url(m):
    """Public content links (videos, tracks, posts, articles) stay, minus tracking/sharer params like si= or
    igsh=; other links with tokens or IDs become [link: domain]."""
    url = m.group(0)
    c = CONTENT_HOSTS.match(url)
    if c and c.end() >= len(url.split("#")[0]):
        q = [kv for kv in (c.group(3) or "?")[1:].split("&") if kv.split("=")[0] in ("v", "list", "t")]
        base = url.split("?")[0].split("#")[0]
        return base + ("?" + "&".join(q) if q else "")
    return link_placeholder(url) if token_link(url) else url


def token_link(url):
    """True if a URL carries a token / share id / personal id (long random-looking parts, query strings)."""
    if re.search(r"[?&#](?:[^=&#]*(?:token|key|share|invite|sig|auth|session|code|id|usp|s)\b[^=&#]*)=", url, re.I):
        return True
    for part in re.split(r"[/?&=#._-]", url):
        if len(part) >= 8 and re.search(r"\d", part) and re.search(r"[A-Za-z]", part):
            return True
        if len(part) >= 6 and part.isdigit():
            return True
    return "drive.google" in url or "/folders/" in url or "t.me/+" in url or "joinchat" in url


def luhn(digits):
    d = [int(c) for c in digits]
    return (sum(d[-1::-2]) + sum(sum(divmod(2 * x, 10)) for x in d[-2::-2])) % 10 == 0


def card_repl(m):
    """13-15 digits only if Luhn-valid (cards always are; Telegram chat ids like -1001234567890 mostly aren't);
    16-19 digits always. Never right after 'chat', '#' or 'id' (tgread headers, message refs)."""
    digits = re.sub(r"\D", "", m.group(0))
    if re.search(r"(?i)(?:chat\s*-?|#|\bid[:=\s]\s*-?)$", m.string[max(0, m.start() - 8):m.start()]):
        return m.group(0)
    if len(digits) < 16 and not luhn(digits):
        return m.group(0)
    return "[card number]"


def secret_repl(m):
    """Mask the value after a password/PIN/code keyword. With ':'/'=' any value; with 'is'/'ist'/a bare space only a
    value with a digit (so 'the code is great' stays); never a time or 'dress/zip/QR code'."""
    kw, sep, val = m.group(1), m.group(2) + m.group(3), m.group(4)
    core = val.rstrip(".!?)")
    if re.search(r"(?i)\b(?:dress|zip|area|post(?:al)?|qr|source|promo|country|colou?r)\s*$",
                 m.string[max(0, m.start() - 12):m.start()]):
        return m.group(0)
    if len(core) < 3 or re.fullmatch(r"\d{1,2}[:.h]\d{2}", core) or core.startswith("["):
        return m.group(0)
    if not re.search(r"[:=]", sep) and not (re.search(r"\d", core) and len(core) >= 4):
        return m.group(0)
    return kw + sep + "[secret]" + val[len(core):]


def regex_pass(text, money=True, all_amounts=False):
    counts = {}

    def sub(rx, repl, s, key):
        def f(m):
            r = repl(m) if callable(repl) else repl
            if r != m.group(0):
                counts[key] = counts.get(key, 0) + 1
            return r
        return rx.sub(f, s)

    text = sub(RX_EMAIL, "[email]", text, "email")
    text = sub(RX_URL, clean_url, text, "link")
    text = sub(RX_IBAN, lambda m: "[IBAN]" if sum(c.isdigit() for c in m.group(0)) >= 10 else m.group(0), text, "iban")
    text = sub(RX_AHV, "[AHV number]", text, "ahv")
    text = sub(RX_PHONE_INTL, "[phone]", text, "phone")
    text = sub(RX_PHONE_NAT, "[phone]", text, "phone")
    text = sub(RX_CARD, card_repl, text, "card")
    text = sub(RX_PLATE, "[license plate]", text, "plate")
    text = sub(RX_BIRTH_AFTER, lambda m: m.group(1) + "[birthdate]", text, "birthdate")
    text = sub(RX_BIRTH_BEFORE, lambda m: "[birthdate]" + m.group(2), text, "birthdate")
    text = sub(RX_HANDLE, "@[user]", text, "handle")
    text = sub(RX_ACCOUNT, lambda m: m.group(1) + m.group(2) + "[account number]", text, "account")
    text = sub(RX_POSTAL_ACCOUNT, "[account number]", text, "account")
    text = sub(RX_SECRET, secret_repl, text, "secret")
    if money:
        text, n = money_pass(text, all_amounts)
        if n:
            counts["amount"] = n
        text, n = money_backstop(text)                           # investments and debts -> [private: money]
        if n:
            counts["private_money"] = n
    return text, counts


def chat_senders(text):
    lines = [l for l in text.splitlines() if l.strip()]
    found, hits = [], 0
    for l in lines:
        for rx in CHAT_PREFIX:
            m = rx.match(l)
            if m:
                hits += 1
                n = m.group(1).strip()
                if n and n not in found:
                    found.append(n)
                break
    return found if lines and hits >= 0.3 * len(lines) else []


VENUE_WORD = (r"(?:Garten|Bar|Café|Cafe|Restaurant|Ristorante|Club|Klub|Halle|Lounge|Pub|Bistro|Beiz|Stübli|Brauerei|"
              r"Pizzeria|Hotel|Kino|Theater|Arena|Stadion|Grill|Kitchen)\b")


def venue_only(name, text):
    """True if a model-proposed 'person' only ever occurs as part of a venue name ("Frau Gerolds Garten")."""
    toks, titled = name_tokens(name)
    if not toks or (len(toks) > 1 and not titled):
        return False
    rx = re.compile(r"(?<!%s)%s(?:'s|’s|s)?(?!%s)(\s+%s)?" % (WORD, re.escape(toks[-1]), WORD, VENUE_WORD))
    occ = list(rx.finditer(text))
    return bool(occ) and all(m.group(1) for m in occ)


# ---- private passages (policy v2): the model quotes them, code finds and replaces them in the original text
PRIVATE_LABEL = {c: c.replace("_", " ") for c in PRIVATE_CATEGORIES}
# tgread block header "### Title (group, chat -100123)": never redacted (tgread splits its output on it)
BLOCK_HEADER = re.compile(r"^### .*\([\w ?-]+, chat (?:-?\d+|C\d+)\)")          # C1: tgread's IdShield
# tgread line tail: " [photo; edited] (#123 reply to #120)  <== match" is never redacted
LINE_TAIL = re.compile(r"(?:\s\[[^\[\]\n]*\])?\s\(#M?\d+(?: reply to #M?\d+)?\)(?:\s+<== match)?\s*$")   # #M1: shielded
EMOJI = "\u2600-\u27bf\U0001F000-\U0001FAFF"
SENT_END = re.compile(r"(?:[.!?…]+|[%s][%s\ufe0f\u200d]*)[\"'”’»)\]]*(?=\s|$)" % (EMOJI, EMOJI))
ABBREV = {"dr", "prof", "hr", "fr", "frl", "st", "ca", "bzw", "usw", "etc", "vs", "mr", "mrs", "ms", "inkl", "nr",
          "evtl", "ev", "jr", "sr", "str", "tel", "ggf", "zb", "bsp", "geb", "sog", "min", "max", "approx", "no"}
ABOUT_WRITER = {"", "writer", "the writer", "me", "myself", "i", "ich", "mir", "mich", "self", "sender", "author", "none",
                "n/a", "unknown"}
# words that look like a surname in "Lenas Mueter" / "her Brother" but are relations
RELATION_WORDS = {"mueter", "mutter", "mama", "mami", "vater", "vatter", "papa", "papi", "bruder", "brüeder", "brueder",
                  "schwester", "schwöschter", "schwoeschter", "freund", "freundin", "fründ", "fründin", "frau", "mann",
                  "ex", "chef", "chefin", "boss", "grosi", "oma", "opa", "tante", "onkel", "cousin", "cousine",
                  "kollege", "kollegin", "nachbar", "nachbarin", "sohn", "tochter", "kind", "baby", "partner",
                  "partnerin", "mom", "mum", "dad", "brother", "sister", "boyfriend", "girlfriend", "wife", "husband",
                  "friend", "family", "familie", "eltern", "parents"}


def norm_index(s):
    """(casefolded letters and digits of s, index in s of each of them): for whitespace/punctuation-blind search."""
    chars, idx = [], []
    for i, c in enumerate(s):
        if c.isalnum():
            for cc in c.casefold():
                chars.append(cc)
                idx.append(i)
    return "".join(chars), idx


def _nkey(s):
    return "".join(c.casefold() for c in s if c.isalnum())


def line_at(text, pos):
    ls = text.rfind("\n", 0, pos) + 1
    le = text.find("\n", pos)
    return ls, (len(text) if le < 0 else le)


def body_bounds(text, ls, le):
    """The redactable part of a line: after a chat prefix '[ts] Name: ' (or leading indent), before a tgread tail."""
    line = text[ls:le]
    if BLOCK_HEADER.match(line):
        return le, le
    bs = 0
    for rx in CHAT_PREFIX:
        m = rx.match(line)
        if m:
            bs = m.end()
            break
    else:
        bs = len(line) - len(line.lstrip())
    m = LINE_TAIL.search(line)
    be = m.start() if m and m.start() >= bs else len(line)
    return ls + bs, ls + be


def line_sender(text, ls):
    """The chat sender of the line at ls; for an indented continuation line, that of the message it continues."""
    for _ in range(200):
        line = text[ls:line_at(text, ls)[1]]
        for rx in CHAT_PREFIX:
            m = rx.match(line)
            if m:
                return m.group(1).strip()
        if not line[:1].isspace() or ls == 0:
            return None
        ls = line_at(text, ls - 1)[0]
    return None


def sentence_ends(text, bs, be):
    """Positions just after each sentence end in text[bs:be] (., !, ?, … or an emoji, before whitespace). Not after
    abbreviations, initials or dates ('Dr.', 'K.', '18.10. am')."""
    out = []
    for m in SENT_END.finditer(text, bs, be):
        tok = m.group(0)
        if tok[0] == "." and not tok.startswith(".."):
            before = text[max(bs, m.start() - 12):m.start()]
            if before[-1:].isdigit():
                nxt = text[m.end():be].lstrip()[:1]
                if not (nxt.isalpha() and nxt.isupper()):
                    continue
            else:
                w = re.search(r"([^\W\d_]+)$", before)
                if not w or len(w.group(1)) == 1 or w.group(1).lower() in ABBREV:
                    continue
        out.append(m.end())
    return out


def expand_to_sentence(text, s, e, bs, be):
    ends = sentence_ends(text, bs, be)
    start = max([p for p in ends if p <= s] + [bs])
    while start < s and text[start].isspace():
        start += 1
    end = min([p for p in ends if p >= e] + [be])
    return start, end


def locate(text, span, lo, hi, norm):
    """Where the model's quote is: ([(start, end)], how). Exact (whitespace-tolerant) anywhere; else ignoring case,
    spaces and punctuation; else its first/last words as anchors inside the chunk text[lo:hi]; else the chunk line
    sharing most of its words (then that whole message is redacted). Over-redaction beats a leak."""
    words = span.split()
    if not words:
        return [], None
    found = [(m.start(), m.end()) for m in re.finditer(r"\s+".join(map(re.escape, words)), text)]
    if found:
        return found, "exact"
    ns, nmap = norm
    key = _nkey(span)
    if len(key) >= 6:
        i = ns.find(key)
        while i >= 0:
            found.append((nmap[i], nmap[i + len(key) - 1] + 1))
            i = ns.find(key, i + 1)
        if found:
            return found, "fuzzy"
    nlo, nhi = bisect.bisect_left(nmap, lo), bisect.bisect_left(nmap, hi)
    if len(words) >= 6:
        k = min(4, len(words) // 2)
        a, b = _nkey(" ".join(words[:k])), _nkey(" ".join(words[-k:]))
        i = ns.find(a, nlo, nhi) if len(a) >= 6 else -1
        if i >= 0 and len(b) >= 6:
            j = ns.find(b, i + len(a), min(nhi, i + len(a) + max(400, 2 * len(key))))
            if j >= 0:
                return [(nmap[i], nmap[j + len(b) - 1] + 1)], "anchors"
    toks = set(re.findall(r"[^\W_]{3,}", span.casefold()))
    if len(toks) >= 2:
        best, pos = None, lo
        while pos < hi:
            ls, le = line_at(text, pos)
            lt = set(re.findall(r"[^\W_]{3,}", text[ls:le].casefold()))
            hit = len(toks & lt) / len(toks)
            if hit >= 0.6 and (best is None or hit > best[0]):
                best = (hit, ls, le)
            pos = le + 1
        if best:
            # within that line, the run of sentences that share most of their words with the quote (else all of it)
            bs, be = body_bounds(text, best[1], best[2])
            cuts = [bs] + [p for p in sentence_ends(text, bs, be) if p < be] + [be]
            sel = []
            for a, b in zip(cuts, cuts[1:]):
                st = set(re.findall(r"[^\W_]{3,}", text[a:b].casefold()))
                if st and len(st & toks) / len(st) >= 0.5:
                    sel.append((a, b))
            if sel:
                return [(sel[0][0], sel[-1][1])], "line"
            return [(bs, be)], "line"
    return [], None


def private_plausible(span, senders):
    t = span.strip(" \t\n.,;:!?\"'()[]")
    if len(t) < 3 or not re.search(r"[^\W\d_]", t):
        return False
    if TIME_OR_AMOUNT.match(t) or DATE_NO_YEAR.match(t) or DAY_WORDS.match(t):
        return False
    names = {People._norm(s) for s in senders} | {tok.lower() for s in senders for tok in name_tokens(s)[0]}
    return People._norm(t) not in names and t.lower() not in names


def surname_of(name, senders, text):
    """The surname to mask for a person attached to a private passage, or None. A first name alone is looked up among
    the chat senders ('Lena' -> 'Lena Brunner'); 'Lenas Mueter' or 'her brother' are not names."""
    toks, titled = name_tokens(name)
    if not toks:
        return None
    if not titled and len(toks) == 1:
        cands = {s for s in senders if len(name_tokens(s)[0]) > 1
                 and name_tokens(s)[0][0].casefold() == toks[0].casefold()}
        if len(cands) != 1:
            return None
        toks, titled = name_tokens(cands.pop())
    if not titled:
        if len(toks) > 3 or toks[0].lower() in NOT_NAMES or toks[0].lower() in RELATION_WORDS:
            return None
        if re.search(r"(?:'s|’s)$", toks[0]) or (toks[0].endswith("s") and any(
                name_tokens(s)[0][:1] and name_tokens(s)[0][0].casefold() == toks[0][:-1].casefold() for s in senders)):
            return None                                   # possessive: "Lenas Mueter"
        if not re.search(r"(?<!%s)%s\s+%s(?!%s)" % (WORD, re.escape(toks[0]), re.escape(toks[-1]), WORD), text):
            return None                                   # the full name never occurs: nothing to tie it to
    sur = toks[-1]
    if len(sur) < 2 or not sur[:1].isupper() or sur.lower() in RELATION_WORDS or sur.lower() in NOT_NAMES:
        return None
    return sur


def mask_surnames(text, surnames):
    for s in sorted(surnames, key=len, reverse=True):
        rx = re.compile(r"(?<!%s)%s(['’]s|s)?(?!%s)" % (WORD, re.escape(s), WORD))
        text = rx.sub(lambda m: "[surname]" + ("'s" if m.group(1) else ""), text)
    return text


def check_sentence(sentence, message, admin=False):
    """The model's second opinion on one flagged sentence -> a category, or None (not private)."""
    user = "Message: <<<%s>>>\nSentence: <<<%s>>>" % (message, sentence)
    system = CHECK_SYSTEM_ADMIN if admin else CHECK_SYSTEM
    schema = CHECK_SCHEMA_ADMIN if admin else CHECK_SCHEMA
    ck = None
    if CACHE:                                         # the verdict only (a category, "?" or None), never the text
        ck = CACHE.key_for("check", {"system": system, "schema": schema, "user": user, "max_tokens": 24})
        hit = CACHE.get("check", ck)
        if isinstance(hit, dict) and (hit.get("c") is None or hit.get("c") == "?" or hit.get("c") in PRIVATE_LABEL):
            return hit.get("c")
    out, _ = chat([{"role": "system", "content": system}, {"role": "user", "content": user}],
                  max_tokens=24, temperature=0.0, schema=schema, label="check")
    try:
        cat = json.loads(out).get("category")
        verdict = cat if cat in PRIVATE_LABEL else None
    except (ValueError, AttributeError):
        verdict = "?"                                 # unreadable answer: keep the detector's verdict
    if CACHE:
        CACHE.put("check", ck, {"c": verdict})
    return verdict


def apply_private(text, items, senders, owner, check=None):
    """items: [(model item, chunk start, chunk end)] -> (text with each private sentence replaced by
    '[private: category]', stats, surnames to mask). Each quote is located and widened to whole sentences; with
    check(sentence, message) every one of those sentences gets a second opinion and only confirmed ones go (with
    the checker's category). Chat prefixes and tgread line tails are never touched, so lines, senders and message
    refs stay; adjacent redacted sentences share one placeholder."""
    norm = norm_index(text)
    cands = {}                                        # (start, end) -> {"cat", "about", "ls"}
    st = {"private_spans_from_model": len(items), "private_unmatched": 0, "private_located": {}}
    owner_n = People._norm(owner) if owner else None
    for item, lo, hi in items:
        span = (item.get("text") or "").strip()
        cat = item.get("category") if item.get("category") in PRIVATE_LABEL else "confidential"
        if not private_plausible(span, senders):
            continue
        regions, how = locate(text, span, lo, hi, norm)
        if not regions:
            st["private_unmatched"] += 1
            continue
        if len(regions) > 3:                          # a short quote found all over the text: only its own chunk
            regions = [r for r in regions if lo <= r[0] < hi][:3]
        st["private_located"][how] = st["private_located"].get(how, 0) + 1
        for s, e in regions:
            ls = line_at(text, s)[0]
            while ls < e and ls <= len(text):
                le = line_at(text, ls)[1]
                bs, be = body_bounds(text, ls, le)
                cs, ce = max(s, bs), min(e, be)
                if ce > cs and re.search(r"[^\W_]", text[cs:ce]):
                    a, b = expand_to_sentence(text, cs, ce, bs, be)
                    cuts = [a] + [p for p in sentence_ends(text, a, b) if a < p < b] + [b]
                    for x, y in zip(cuts, cuts[1:]):        # one candidate per sentence
                        while x < y and text[x].isspace():
                            x += 1
                        if re.search(r"[^\W\d_]", text[x:y]):
                            c = cands.setdefault((x, y), {"cats": [], "about": (item.get("about") or "").strip(),
                                                          "ls": ls, "body": (bs, be)})
                            if cat not in c["cats"]:
                                c["cats"].append(cat)
                ls = le + 1
    st["private_candidates"] = len(cands)
    verdicts, intervals, surnames, bycat = {}, [], set(), {}
    for (x, y), c in sorted(cands.items()):
        cats = c["cats"]
        if check is not None:
            sent = " ".join(text[x:y].split())
            if sent not in verdicts:
                verdicts[sent] = check(sent, " ".join(text[c["body"][0]:c["body"][1]].split()))
            if verdicts[sent] is None:
                continue
            cats = cats if verdicts[sent] == "?" else [verdicts[sent]]
        for cat in cats:
            intervals.append((x, y, cat))
            bycat[cat] = bycat.get(cat, 0) + 1
        about = c["about"]                            # its subject and its writer are attached
        for person in (line_sender(text, c["ls"]), None if about.lower() in ABOUT_WRITER else about):
            if person and People._norm(person) not in (owner_n, "you"):
                sur = surname_of(person, senders, text)
                if sur and not (owner_n and sur.lower() in owner_n.split()):
                    surnames.add(sur)
    st["private_rejected_by_check"] = len(cands) - len({(x, y) for x, y, _ in intervals})
    st["private_by_category"] = bycat
    merged = []
    for s, e, cat in sorted(intervals):
        if merged and (s <= merged[-1][1] or (not text[merged[-1][1]:s].strip() and "\n" not in text[merged[-1][1]:s])):
            ps, pe, pc = merged[-1]
            merged[-1] = (ps, max(pe, e), pc + ([cat] if cat not in pc else []))
        else:
            merged.append((s, e, [cat]))
    out, last = [], 0
    for s, e, cats in merged:
        out.append(text[last:s])
        out.append("[private: %s]" % ", ".join(PRIVATE_LABEL[c] for c in cats))
        last = e
    out.append(text[last:])
    st["private_redactions"] = len(merged)
    return "".join(out), st, surnames


def detect(chunks, system, schema, user_fmt, known=None, label="detect", numbered=True):
    """One grammar-constrained detection call per chunk -> yields (chunk index, data dict). numbered=False (the default
    detector): no "(part i of n)" in the request, so a chunk's request depends on its text only and the
    cache reuses it when the window around it moves."""
    for i, ch in enumerate(chunks):
        part = " (part %d of %d)" % (i + 1, len(chunks)) if len(chunks) > 1 and numbered else ""
        user = user_fmt % {"known": known() if known else "", "part": part, "text": ch}
        ck, data = None, None
        if CACHE:
            ck = CACHE.key_for("detect", {"system": system, "schema": schema, "user": user, "max_tokens": 3072})
            ref = CACHE.get("detect", ck)
            if ref is not None:
                try:
                    data = from_refs(ref, user, CACHE.crypt(ck))
                except (ValueError, TypeError, KeyError, UnicodeDecodeError):
                    data = None
        if data is None:
            out, finish = chat([{"role": "system", "content": system}, {"role": "user", "content": user}],
                               max_tokens=3072, temperature=0.0, schema=schema,
                               label="%s %d/%d" % (label, i + 1, len(chunks)))
            try:
                data = json.loads(out)
            except ValueError:
                raise LLMError("the local LLM returned invalid JSON while detecting personal data (chunk %d%s)"
                               % (i + 1, ", output cut off" if finish == "length" else ""), 4)
            if CACHE and isinstance(data, dict):
                try:
                    CACHE.put("detect", ck, to_refs(data, user, enc=CACHE.crypt(ck)))
                except NotCacheable:
                    CACHE_STATS.setdefault("detect_not_stored", [0, 0])[1] += 1
        yield i, data if isinstance(data, dict) else {}


def anonymize(text, owner, chunk_chars, stats_out, strict=False, keep_money=False, all_amounts=False):
    """-> (anonymized text, reapply(str) -> str for re-applying the name rules to a summary).
    Default (policy v2): names, addresses and facts stay; private passages, identifiers and the surnames of people
    attached to private passages go. strict: also every private person -> Person A/B/..., addresses, locations.
    keep_money: admin documents (v2 money rule, no business category, no [amount] net).
    all_amounts: the owner's own mail: the money net masks every amount (see money_pass)."""
    senders = chat_senders(text)
    people = People(owner)
    chunks = chunk_lines(text, chunk_chars)
    offs = [0]
    for ch in chunks:
        offs.append(offs[-1] + len(ch))
    spans, private = [], []
    if strict:                                       # pass 1 (strict only): the pre-v2 people + personal-data detector
        for n in senders:                            # deterministic safety net for chat logs
            if not (owner and People._norm(n) == People._norm(owner)):
                people.add(n)
        fmt = ("Known people so far: %(known)s\n\nFind the people and personal data in this text%(part)s:\n<<<\n"
               "%(text)s\n>>>")
        for i, data in detect(chunks, DETECT_SYSTEM_STRICT, DETECT_SCHEMA_STRICT, fmt,
                              lambda: people.known() or "(none yet)", "people"):
            for p in data.get("people") or []:
                if isinstance(p, dict) and isinstance(p.get("name"), str):
                    names = [p["name"]] + [v for v in p.get("variants") or [] if isinstance(v, str)]
                    if people.find(names) is None and all(venue_only(n, text) for n in names):
                        continue                     # a venue like "Frau Gerolds Garten", not a person
                    people.add(names[0], names[1:])
            spans += [s for s in data.get("pii") or [] if isinstance(s, dict)]
    fmt = "Find the private passages and identifiers in this text%(part)s:\n<<<\n%(text)s\n>>>"
    for i, data in detect(chunks, DETECT_SYSTEM_ADMIN if keep_money else DETECT_SYSTEM,     # private passages +
                          DETECT_SCHEMA_ADMIN if keep_money else DETECT_SCHEMA, fmt,      # identifiers (all modes)
                          numbered=False):
        spans += [s for s in data.get("identifiers") or [] if isinstance(s, dict)]
        private += [(p, offs[i], offs[i + 1]) for p in data.get("private") or []
                    if isinstance(p, dict) and isinstance(p.get("text"), str)]
    out, pst, surnames = apply_private(text, private, senders, owner,
                                       lambda sent, msg: check_sentence(sent, msg, keep_money))
    out = apply_spans(out, spans)
    if strict:
        surnames = set()

        def reapply(s):
            return apply_people(s, people)
    else:
        def reapply(s):
            return mask_surnames(apply_people(s, people) if owner else s, surnames)
    out, counts = regex_pass(reapply(out), money=not keep_money, all_amounts=all_amounts)
    if counts.get("private_money") and not strict:   # the money backstop's lines: their writers' surnames go too,
        owner_n = People._norm(owner) if owner else None                             # like apply_private's
        for lm in re.finditer(r"[^\n]*\[private: money\][^\n]*", out):
            person = line_sender(out, lm.start())
            if person and People._norm(person) not in (owner_n, "you"):
                sur = surname_of(person, senders, text)
                if sur and not (owner_n and sur.lower() in owner_n.split()):
                    surnames.add(sur)
        out = mask_surnames(out, surnames)
    stats_out.update({"mode": "strict" if strict else "default", "chunks": len(chunks), "policy": POLICY,
                      "own_money": "kept" if keep_money else "redacted"})
    if all_amounts:
        stats_out["amounts"] = "all"
    if strict:
        stats_out["people"] = len([p for p in people.persons if p["alias"] != "You"])
    stats_out.update(pst)
    stats_out.update({"identifier_spans_from_model": len(spans), "surnames_masked": len(surnames),
                      "regex_pass_hits": counts})
    if pst["private_unmatched"]:
        print("llm-local: warning: %d private passage(s) reported by the model could not be located in the text"
              % pst["private_unmatched"], file=sys.stderr)
    return out, reapply


def summarize(anon, extra, max_tokens, strict=False, keep_money=False):
    if keep_money:
        system = SUMMARY_SYSTEM_STRICT.replace(_SUMMARY_MONEY, "") if strict else SUMMARY_SYSTEM_ADMIN
    else:
        system = SUMMARY_SYSTEM_STRICT if strict else SUMMARY_SYSTEM
    system += ("\n\nAdditional instructions: " + extra if extra else "")
    budget = ctx_size() - max_tokens - count_tokens(system) - 300
    parts = [anon]
    if count_tokens(anon) > budget:                  # too long for one pass: detailed summary per part
        n = max(2, -(-count_tokens(anon) // max(budget, 1000)))
        parts = chunk_lines(anon, max(2000, len(anon) // n + 1))
    outs = []
    for i, part in enumerate(parts):
        hdr = "" if len(parts) == 1 else " (part %d of %d)" % (i + 1, len(parts))
        msgs = [{"role": "system", "content": system},
                {"role": "user", "content": "Summarize this%s:\n<<<\n%s\n>>>" % (hdr, part)}]
        txt, ck = None, None
        if CACHE:                                     # summaries are built from anonymized text only (sealed)
            ck = CACHE.key_for("summary", {"messages": msgs, "max_tokens": max_tokens})
            txt = CACHE.unseal(ck, CACHE.get("summary", ck))
        if txt is None:
            txt, _ = chat(msgs, max_tokens=max_tokens, temperature=0.3, presence=0.5, label="summary%s" % hdr)
            if CACHE:
                CACHE.put("summary", ck, CACHE.seal(ck, txt))
        outs.append(("## Part %d of %d\n" % (i + 1, len(parts)) if len(parts) > 1 else "") + txt)
    return "\n\n".join(outs)


# ---------------------------------------------------------------- paraphrase (policy v4)
# Policy v4: the vault summarizes and paraphrases the messages without changing any meaning, numbers or
# facts; all remaining redactions still apply. --paraphrase runs on the ANONYMIZED text only (after the regex net, the
# detector + per-sentence check and the regex/money nets), and the nets run again on its result:
#   - What: every message body. Chat lines keep '[ts] Name: ' and the tail ' [photo] (#123 reply to #120)' in code;
#     only the text between them is rewritten. Mail: the text after 'Subject: ' and each paragraph. Headers ('### …'),
#     blank lines, '[service: …]' lines and messages of one or two words stay as they are.
#   - How: ONE grammar-constrained call per batch (≤ PARA_BATCH_CHARS / PARA_BATCH_ITEMS, cut where the content says so,
#     like the anonymizer's chunks): {"p": [one paraphrase per item, in order]}. Output language: the item's own (v4.1,
#     the original language, never translated; translating Swiss German turned "da meh nid chan
#     reserviere müend mer so früeh gah" into "early booking is required" and "am 4i" into "by the 4th").
#   - Code check per message: every number (digits, Swiss thousands separators, number words), weekday, month and
#     today/tomorrow/yesterday in the paraphrase must occur in that message's anonymized text; its bracket
#     placeholders ([private: …], [amount], [phone], …) must be exactly the input's; at most ~2x as long. v4.1: a number
#     keeps its role (clock time vs date/ordinal, num_roles), a sentence with a negation keeps one (negations), and
#     an item in German/Swiss German doesn't come back in English or the other way round (text_lang).
#   - A failing message is retried once (one call for all of them, told what was wrong); still failing -> the
#     anonymized text verbatim, marked "[not paraphrased]". Never raw: the model never saw anything else.
# Summaries (--summary --paraphrase): the same number/date/placeholder check on each summary line against the whole
# anonymized input; retried once; lines still failing are left out and counted in a "[not paraphrased]" note.
PARA_BATCH_CHARS = 3000
PARA_BATCH_ITEMS = 30
PARA_ITEM_MAX = 1500                             # a longer paragraph is split at sentence ends into several items
PARA_MIN_WORDS = 3                               # fewer words: kept as written (nothing to compress)
PARA_MARK = "[not paraphrased]"
PARA_SYSTEM = """You rewrite chat messages and e-mail text for the personal assistant of their owner. The text was already anonymized. Each numbered item is one message, or one part of an e-mail. Rewrite EVERY item as a short, neutral paraphrase in the SAME language as the item.

Rules:
- Never translate. Swiss German stays Swiss German (you may normalize the spelling a little), Standard German stays Standard German (never rewrite it in Swiss German), English stays English, French stays French. When in doubt, keep the item's own words.
- Keep the meaning exactly and keep every fact: who, what, when, where, plans, decisions, questions, requests, answers, reasons, names, places, addresses, dates, times, numbers.
- Keep every negation: what is "nid", "nöd", "nicht", "kein", "nie", "not", "no" or "never" in the item stays negated.
- Copy every number, date and time exactly as written ("07:30" stays "07:30", "12.10." stays "12.10.", "2" stays "2"). A clock time stays a clock time: in Swiss German "am 4i", "um 4", "am vieri", "halbi 5" and "17i" are times of day, never dates or ordinals. Never calculate, convert or add a date, weekday, time or number that is not in the item. Relative words (today, tomorrow, next week) stay relative.
- Copy names of people, places, venues, streets, companies and products exactly as written.
- Copy every placeholder in square brackets exactly as it is, e.g. [private: health], [amount], [phone], [surname], [link: example.com]. Never guess or describe what a placeholder hides.
- Add nothing: no opinions, guesses, explanations or new details. Leave out greetings and filler words. A message that only greets, thanks or reacts becomes a few words saying so, in its language.
- Keep the writer's perspective: "I" stays the writer, "you" the person written to. A question stays a question.
- One line per item, plain and neutral, shorter than the original where possible.

Answer with JSON only: {"p": ["<item 1 rewritten>", "<item 2 rewritten>", ...]}, exactly one string per item, in order."""

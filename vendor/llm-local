                           r"büro|office|arbeite[nt]?|schaffe|schafft|work(?:s|ing)?\s+(?:at|in|for|bei)|job\s+(?:at|bei))\b")


def plausible(typ, t):
    """Only PII-shaped spans are replaced: a small model sometimes flags times, weekdays or amounts, and a
    global replacement would then wipe real facts."""
    digits = sum(c.isdigit() for c in t)
    if typ == "secret":            # PINs and codes are often bare digits, so no amount guard; times/dates/days stay
        return (len(t) >= 4 and not re.match(r"^\d{1,2}[:.h]\d{2}(?:\s?uhr)?$", t, re.I) and not DATE_NO_YEAR.match(t)
                and not DAY_WORDS.match(t) and not re.search(r"(?i)chf|\bfr\.|eur\b|€|\$|\.-|\.–", t))
    if len(t) < 3 or TIME_OR_AMOUNT.match(t) or DATE_NO_YEAR.match(t) or DAY_WORDS.match(t):
        return False
    if typ == "birthdate":
        return bool(re.search(r"\b(19|20)\d{2}\b|\b\d{1,2}[./]\d{1,2}[./]\d{2}\b", t))
    if typ == "address":
        return bool(re.search(r"[^\W\d_]", t)) and (bool(STREET.search(t)) or bool(re.search(r"\b\d{4}\s+[^\W\d_]", t)))
    if typ == "link":
        return bool(re.match(r"(?i)(https?://|www\.|t\.me/)", t))
    if typ in ("phone", "iban", "card", "ahv"):
        return digits >= 7
    if typ == "email":
        return "@" in t
    if typ == "plate":
        return digits >= 1 and bool(re.search(r"[A-Za-z]", t))
    if typ == "id":
        return digits >= 4 or (len(t) >= 6 and digits >= 2 and re.search(r"[A-Za-z]", t) is not None)
    if typ == "location":
        return len(t.split()) >= 2
    return False


def apply_spans(text, spans):
    """Replace model-reported PII spans (verbatim, whitespace-tolerant) that pass plausible(). A 'location'
    is only replaced where a home/work cue word (wohnt, dihei, office, schaffe...) is close before it."""
    items = []
    for s in spans:
        t, typ = (s.get("text") or "").strip(), s.get("type")
        if typ in PLACEHOLDER and plausible(typ, t):
            items.append((t, typ))
    for t, typ in sorted(set(items), key=lambda x: -len(x[0])):
        ph = link_placeholder(t) if typ == "link" else PLACEHOLDER[typ]
        rx = re.compile(r"(?<!%s)%s(?!%s)" % (WORD, r"\s+".join(map(re.escape, t.split())), WORD))
        if typ == "location":
            def cue(m, ph=ph):
                start = max(m.string.rfind("\n", 0, m.start()) + 1, m.start() - 60)   # same line, 60 chars back
                return ph if HOME_WORK_CUE.search(m.string[start:m.start()]) else m.group(0)
            text = rx.sub(cue, text)
        else:
            text = rx.sub(lambda m, ph=ph: ph, text)
    return text


def link_placeholder(url):
    m = re.match(r"(?i)(?:https?://)?(?:www\.)?([^/\s?#]+)", url)
    return "[link: %s]" % m.group(1).lower() if m else "[link]"



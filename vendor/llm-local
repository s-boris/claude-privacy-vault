def num_roles(s):
    """{number: {'time', 'date'}} for the numbers s uses as clock times or as dates/ordinals (v4.1)."""
    roles = {}
    low = s.lower()
    for rx in _TIME_FORMS:
        for m in rx.finditer(s):
            roles.setdefault(int(m.group(1)), set()).add("time")
    for m in re.finditer(r"(?i)\b(?:%s|halbi?|viertel ab|viertel vor|viertel nach)\s+(%s)\b"
                         % (_PREP_T, "|".join(_HOUR_WORDS)), low):
        roles.setdefault(_HOUR_WORDS[m.group(1)], set()).add("time")
    for w in _words(low):
        if w in _HOUR_I:                                # "vieri", "füfi": always a time of day
            roles.setdefault(_HOUR_WORDS[w], set()).add("time")
        o = _ORD_WORDS.get(re.sub(r"(?<=e)[nmrs]$", "", w))
        if o:
            roles.setdefault(o, set()).add("date")
    for rx in _DATE_FORMS:
        for m in rx.finditer(s):
            for g in m.groups():
                if g:
                    roles.setdefault(int(g), set()).add("date")
    return roles



CUT_EVERY = 32                                   # a line is a cut point when its hash % CUT_EVERY == 0 (~every 32 lines)


def cut_line(line):
    return int(hashlib.sha256(line.encode("utf-8", "replace")).hexdigest()[:8], 16) % CUT_EVERY == 0


def chunk_lines(text, max_chars):
    """Line-aligned chunks of at most max_chars, cut where the content says, so the same
    messages give the same chunks when the window around them moves (recent -n 30 plus one new message: only the
    first and the last chunk change). A cut point (cut_line) ends a chunk when the text since the previous cut point
    holds at least max_chars // 6 characters: a choice that depends on those lines only, never on where the window
    starts. A chunk that would grow past max_chars ends at its last unused cut point, else before the line."""
    chunks, cur, seg, soft = [], "", 0, 0           # seg: chars since the last cut point; soft: an unused one in cur
    small = max_chars // 6
    for line in text.splitlines(keepends=True):
        while len(line) > max_chars:                      # very long line: hard split
            if cur:
                chunks.append(cur); cur = ""
            chunks.append(line[:max_chars]); line = line[max_chars:]
            soft = 0
        if cur and len(cur) + len(line) > max_chars:
            if soft and len(cur) - soft + len(line) <= max_chars:
                chunks.append(cur[:soft]); cur = cur[soft:]
            else:
                chunks.append(cur); cur = ""
            soft = 0
        cur += line
        seg += len(line)
        if cut_line(line):
            if seg >= small:
                chunks.append(cur); cur = ""; soft = 0
            else:
                soft = len(cur)
            seg = 0
    if cur:
        chunks.append(cur)
    return chunks


def name_tokens(name):
    toks = [t for t in re.split(r"\s+", name.strip().lstrip("@")) if t]
    titled = bool(toks) and toks[0].lower() in TITLES
    toks = [t.strip(".,;:()") for t in toks if t.lower() not in TITLES]
    return [t for t in toks if len(t) >= 2], titled


class People:
    """Alias map: private people -> Person A, B, ...; the owner -> You. Consistent across chunks."""

    def __init__(self, owner=None):
        self.persons = []          # {"alias", "names": [display forms]}
        self.n = 0
        if owner:
            self.persons.append({"alias": "You", "names": [owner]})

    @staticmethod
    def _norm(s):
        return " ".join(name_tokens(s)[0]).lower()

    def find(self, names):
        normed = {self._norm(n) for n in names if self._norm(n)}
        for p in self.persons:                                   # exact (full-form) match first
            if normed & {self._norm(n) for n in p["names"]}:
                return p
        singles = {n for n in normed if " " not in n}
        for p in self.persons:                                   # first name or surname alone
            for n in p["names"]:
                toks = self._norm(n).split()
                if len(toks) > 1 and singles & {toks[0], toks[-1]}:
                    return p
            # a full name whose first/last token is a known single-token name
            pn = {self._norm(n) for n in p["names"] if " " not in self._norm(n)}
            for n in normed:
                t = n.split()
                if len(t) > 1 and pn & {t[0], t[-1]}:
                    return p
        return None

    def add(self, name, variants=()):
        names = [n.strip() for n in [name, *variants] if n and n.strip()]
        names = [n for n in names if name_tokens(n)[0] and self._norm(n) not in NOT_NAMES]
        if not names:
            return None
        p = self.find(names)
        if p is None:
            p = {"alias": "Person " + self._label(self.n), "names": []}
            self.n += 1
            self.persons.append(p)
        for n in names:
            if n not in p["names"]:
                p["names"].append(n)
        return p

    @staticmethod
    def _label(i):
        letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        return letters[i] if i < 26 else letters[i % 26] + str(i // 26 + 1)

    def known(self):
        return "; ".join("%s (also: %s)" % (p["names"][0], ", ".join(p["names"][1:])) if len(p["names"]) > 1
                         else p["names"][0] for p in self.persons)

    def patterns(self):
        """[(regex, alias)] longest first. Full names and first names match case-insensitively; surnames
        (last token of a full name, or a name used with a title) only as capitalised, since many German
        surnames are ordinary words (frei, Keller, weber)."""
        items = []
        for p in self.persons:
            parsed = [name_tokens(n) for n in p["names"]]
            surnames = {t[-1].lower() for t, titled in parsed if t and (titled or len(t) > 1)} | COMMON_WORD_NAMES
            for toks, titled in parsed:
                if not toks:
                    continue
                if len(toks) > 1:
                    items.append((r"\s+".join(map(re.escape, toks)), True, p["alias"]))
                    items.append((re.escape(toks[0]), toks[0].lower() not in surnames, p["alias"]))
                    items.append((re.escape(toks[-1]), False, p["alias"]))
                else:
                    items.append((re.escape(toks[0]), toks[0].lower() not in surnames, p["alias"]))
        seen, out = set(), []
        for pat, ci, alias in sorted(items, key=lambda x: -len(x[0])):
            if (pat.lower(), ci) in seen:
                continue
            seen.add((pat.lower(), ci))
            rx = re.compile(r"(?<!%s)@?(%s)('s|’s|s)?(?!%s)" % (WORD, pat, WORD), re.I if ci else 0)
            out.append((rx, alias))
        return out


def apply_people(text, people):
    for rx, alias in people.patterns():
        def rep(m, alias=alias):
            at = "@" if m.group(0).startswith("@") else ""
            return at + alias + ("'s" if m.group(2) else "")
        text = rx.sub(rep, text)
    return text



def allowed_facts(src):
    """(numbers, weekdays, months, relative days) a paraphrase of src may mention: what src says, in any language."""
    nums = set()
    for m in _NUM_GROUP.finditer(src):
        g = m.group(0)
        nums.add(int(re.sub(r"\D", "", g)))
        nums.update(int(x) for x in re.findall(r"\d+", g))
    words = _words(src)
    for w in words:
        nums |= _NUMBER_WORDS.get(w, set())
    for m in _TIME_RE.finditer(src):                  # 19:00 may become "7 pm"
        h = int(m.group(1))
        if 12 < h < 24:
            nums.add(h - 12)
    for h, rs in num_roles(src).items():              # "17i" / "um 17" may become "5 pm" (v4.1)
        if "time" in rs and 12 < h < 24:
            nums.add(h - 12)
    for m in _HALF_RE.finditer(src):                  # "halb acht" = 7:30, "viertel vor acht" = 7:45
        hs = _NUMBER_WORDS.get(m.group(2).lower(), set()) | ({int(m.group(2))} if m.group(2).isdigit() else set())
        for h in hs:
            nums |= {h - 1, h, 15, 30, 45}
    days = {_DAY_IN[w] for w in words if w in _DAY_IN}
    months = {_MONTH_IN[w] for w in words if w in _MONTH_IN} | {n for n in nums if 1 <= n <= 12}
    rel = {_REL_IN[w] for w in words if w in _REL_IN}
    if "abend" in words or "znacht" in words or "abig" in words:
        rel.add("today")                              # "heute Abend" -> tonight
    return nums, days, months, rel



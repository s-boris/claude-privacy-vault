               "mega gäll dihei ned nöt zmorge znacht gseh gsehsch gässe gmacht gschribe säg säge lueg luege "
               "mini dini sini öppis zrugg träffed hochziit gäld zmittag mäntig zischtig mittwuch dunschtig fritig "
               "friitig samstig samschtig sunntig".split())
_STD_MARK = set("ist bin bist habe haben hast hat nicht nichts kann kannst können gehen geht gehe müssen muss "
                "musst willst uns einmal morgen heute etwas zuhause gewesen kommt komme kommst war waren gestern "
                "sehr".split())


def _lang_words(s):
    return re.findall(r"(?<!\d)\b[^\W\d_]+(?:'[^\W\d_]+)?", _BRACKET.sub(" ", s))   # not the "i" of Swiss "17i"


def lang_scores(s):
    """(German marker count, English marker count) of s; placeholders don't count."""
    ws = _lang_words(s)
    low = [w.lower() for w in ws]
    de = sum(w in _DE_MARK for w in low) + sum(1 for w in ws if w[:1].islower() and re.search("[äöüß]", w))
    de += sum(1 for k, w in enumerate(low) if w == "am" and (k == 0 or low[k - 1] != "i"))   # German "am", not "I am"
    return de, sum(w in _EN_MARK for w in low)


def text_lang(s):
    """'de' (German/Swiss German), 'en' or None (too few words to tell)."""
    de, en = lang_scores(s)
    if de >= 2 and de > 2 * en:
        return "de"
    if en >= 2 and en > 2 * de:
        return "en"
    return None


def lang_problem(src, out):
    """None, or why the paraphrase out is not in the language of the item src."""
    lo = text_lang(out)
    if lo:
        de, en = lang_scores(src)
        lean = text_lang(src) or ("de" if de > en else "en" if en > de else None)
        if lean and lean != lo:
            names = {"de": "German", "en": "English"}
            return "it translates the item into %s; write it in %s like the item" % (names[lo], names[lean])
    sw = [w.lower() for w in _lang_words(src)]
    ow = [w.lower() for w in _lang_words(out)]
    if sum(w in _CH_MARK for w in sw) >= 2 and not any(w in _STD_MARK for w in sw) \
            and not any(w in _CH_MARK for w in ow) and sum(w in _STD_MARK for w in ow) >= 2:
        return "it turns Swiss German into Standard German; keep the item's Swiss German"
    ch_out = sum(w in _CH_MARK for w in ow)
    if any(w in _STD_MARK for w in sw) and not any(w in _CH_MARK for w in sw) and lang_scores(src)[0] > \
            lang_scores(src)[1] and ch_out >= 2 and ch_out > sum(w in _STD_MARK for w in ow):
        return "it turns Standard German into Swiss German; keep the item's Standard German"
    return None


def negations(s, item=False):
    """Item: the number of sentences with a negation. Paraphrase: the number of negation words."""
    def neg_words(t, english):
        ws = _words(t.replace("’", "'"))
        return sum(w in _NEG or (w == "no" and english) or w.endswith("n't") for w in ws)
    if not item:
        return neg_words(s, True)
    return sum(1 for sent in re.split(r"(?<=[.!?;])\s+|\n", s) if neg_words(sent, text_lang(sent) == "en"))


def para_problems(src, out, facts=None, required=True):
    """What a paraphrase of src (anonymized) changed: [] if fine. facts: allowed_facts(src), precomputed."""
    nums, days, months, rel = facts or allowed_facts(src)
    bad = []
    for m in _NUM_TOKEN.finditer(out):
        g = m.group(0)
        runs = [int(x) for x in re.findall(r"\d+", g)]
        if not all(x in nums for x in runs) and not (len(runs) > 1 and int(re.sub(r"\D", "", g)) in nums):
            bad.append("the number %s is not in it" % g)
    for w, n in _OUT_NUMBER_WORDS.items():
        if n not in nums and re.search(r"\b%s\b" % w, out, re.I):
            bad.append("the number '%s' is not in it" % w)
    for m in _OUT_DAYS.finditer(out):
        if _OUT_DAY_INDEX[(m.group(1) or m.group(2)).lower()] not in days:
            bad.append("the weekday %s is not in it" % m.group(0).strip("."))
    for m in _OUT_MONTHS.finditer(out):
        name = (m.group(1) or m.group(2) or m.group(3)).lower()
        if _MONTH_IN.get(name, 0) not in months:
            bad.append("the month %s is not in it" % m.group(0).strip("."))
    for m in _OUT_REL.finditer(out):
        if _REL_IN[m.group(1).lower()] not in rel:
            bad.append("'%s' is not in it" % m.group(1))
    bad += role_problems(num_roles(src), out)
    have = {re.sub(r"\s+", " ", x.lower()) for x in _BRACKET.findall(src)}
    got = {re.sub(r"\s+", " ", x.lower()) for x in _BRACKET.findall(out)}
    if got - have:
        bad.append("it adds %s" % ", ".join(sorted(got - have)))
    if required:
        need = {re.sub(r"\s+", " ", x.lower()) for x in PH_REQUIRED.findall(src)}
        if need - got:
            bad.append("it drops %s" % ", ".join(sorted(need - got)))
    return bad


def _ok_item(src, out):
    """None if out is a usable paraphrase of src, else the reasons."""
    if not isinstance(out, str) or not out.strip():
        return ["it is empty"]
    out = out.strip()
    bad = para_problems(src, out)
    if len(out) > max(80, 2 * len(src) + 40):
        bad.append("it is much longer than the item")
    if negations(out) < negations(src, item=True):    # v4.1
        bad.append("it drops a negation (keep nid / nöd / nicht / kein / not / never)")
    lang = lang_problem(src, out)
    if lang:
        bad.append(lang)
    return bad or None


CHAT_TAIL = re.compile(r"(?:\s\[[^\[\]\n]*\])?\s\(#M?\d+(?: reply to #M?\d+)?\)(?:\s+<== match)?\s*$")
PARA_CHAT = [re.compile(r"^\s*\[[^\]\n]{4,40}\]\s*[^:\n]{1,80}?:\s"), CHAT_PREFIX[1]]   # the sender may hold [surname]
SUBJECT = re.compile(r"^(Subject:[ \t]?)(.*)$")


def para_units(text):
    """text -> [('keep', line) | ['item', prefix, body, tail]] (the body is what gets rewritten; prefix and tail stay)."""
    units, para = [], None
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        ln = lines[i]
        i += 1
        if not ln.strip() or ln.startswith("### ") or BLOCK_HEADER.match(ln):
            units.append(("keep", ln))
            para = None
            continue
        m = next((m for m in (rx.match(ln) for rx in PARA_CHAT) if m), None)
        if m:
            body = [ln[m.end():]]
            while i < len(lines) and lines[i].startswith("    ") and lines[i].strip():
                body.append(lines[i].strip())         # a message's continuation lines
                i += 1
            joined = " ".join(b.strip() for b in body if b.strip())
            t = CHAT_TAIL.search(joined)
            tail = joined[t.start():] if t else ""
            units.append(["item", ln[:m.end()], joined[:t.start()] if t else joined, tail])
            para = None
            continue
        m = SUBJECT.match(ln)
        if m:                                         # mail: the subject (and ' | ' parts of an event line)
            segs = m.group(2).split(" | ")
            for k, seg in enumerate(segs):
                pre = m.group(1) if k == 0 else " | "
                if re.fullmatch(r"\s*\[[^\[\]\n]*\]\s*|\s*Attachments:.*", seg) and k:
                    units.append(["item", pre, "", seg])  # bulk marker, size note, attachment names: as they are
                else:
                    units.append(["item", pre, seg, ""])
            para = None
            continue
        if para is not None and units[para][0] == "item":
            units[para][2] += " " + ln.strip()            # a paragraph: consecutive plain lines
        else:
            units.append(["item", "", ln.strip(), ""])
            para = len(units) - 1
    out = []                                              # very long paragraphs: several items
    for u in units:
        if u[0] == "item" and len(u[2]) > PARA_ITEM_MAX:
            parts, cur = [], ""
            for s in re.split(r"(?<=[.!?…])\s+", u[2]):
                if cur and len(cur) + len(s) + 1 > PARA_ITEM_MAX:
                    parts.append(cur)
                    cur = ""
                cur = (cur + " " + s).strip()
                while len(cur) > PARA_ITEM_MAX:
                    parts.append(cur[:PARA_ITEM_MAX])
                    cur = cur[PARA_ITEM_MAX:]
            if cur:
                parts.append(cur)
            for k, p in enumerate(parts):
                out.append(["item", u[1] if k == 0 else " ", p, u[3] if k == len(parts) - 1 else ""])
        else:
            out.append(u)
    return out


def para_wanted(body):
    """Rewrite this body? Not: empty, placeholders/emojis only, '[service: …]', fewer than PARA_MIN_WORDS words."""
    if not body.strip() or re.fullmatch(r"\s*\[service:[^\]]*\]\s*", body):
        return False
    return len([w for w in _words(_BRACKET.sub(" ", body)) if len(w) >= 2]) >= PARA_MIN_WORDS


def para_batches(idx, bodies):
    """Item indices -> batches of at most PARA_BATCH_CHARS / PARA_BATCH_ITEMS. Like the anonymizer's chunks
    (chunk_lines), an item whose content hash says so is a cut point; it ends a batch when the items since the
    previous cut point hold a sixth of the limit, and a full batch ends at its last unused cut point, so a sliding
    window keeps its earlier batches (and their cache entries)."""
    def cost(xs):
        return sum(len(bodies[i]) + 8 for i in xs)
    out, cur, seg, soft = [], [], 0, 0
    for i in idx:
        n = len(bodies[i]) + 8
        if cur and (cost(cur) + n > PARA_BATCH_CHARS or len(cur) >= PARA_BATCH_ITEMS):
            if soft and cost(cur[soft:]) + n <= PARA_BATCH_CHARS and len(cur) - soft < PARA_BATCH_ITEMS:
                out.append(cur[:soft])
                cur = cur[soft:]
            else:
                out.append(cur)
                cur = []
            soft = 0
        cur.append(i)
        seg += n
        if int(hashlib.sha256(bodies[i].encode("utf-8", "replace")).hexdigest()[:8], 16) % 8 == 0:
            if seg >= PARA_BATCH_CHARS // 6:
                out.append(cur)
                cur, soft = [], 0
            else:
                soft = len(cur)
            seg = 0
    if cur:
        out.append(cur)
    return out


def para_call(texts, notes=None, label="paraphrase"):
    """One grammar-constrained call -> one string per text (None for each if the answer is unusable)."""
    lines = ["[%d] %s" % (k + 1, " ".join(t.split())) for k, t in enumerate(texts)]
    user = ((PARA_RETRY % "\n".join(notes) + "\n\n") if notes else "") + \
        "Rewrite these %d items:\n<<<\n%s\n>>>" % (len(texts), "\n".join(lines))
    max_tokens = min(8192, 200 + 12 * len(texts) + sum(len(t) for t in texts) // 2)
    msgs = [{"role": "system", "content": PARA_SYSTEM}, {"role": "user", "content": user}]
    schema = para_schema(len(texts))
    ck, out = None, None
    if CACHE:                         # the batch's answer, sealed: built from anonymized text only, checked again below
        ck = CACHE.key_for("para", {"messages": msgs, "schema": schema, "max_tokens": max_tokens})
        out = CACHE.unseal(ck, CACHE.get("para", ck))
    fresh = out is None
    if fresh:
        out, _ = chat(msgs, max_tokens=max_tokens, temperature=0.0, schema=schema, label=label)
    try:
        got = json.loads(out).get("p")
    except (ValueError, AttributeError):
        got = None
    if not isinstance(got, list) or len(got) != len(texts):
        return [None] * len(texts)
    if CACHE and fresh:               # only usable answers; every code check still runs on every call
        CACHE.put("para", ck, CACHE.seal(ck, out))
    return [re.sub(r"^\[\d+\]\s*", "", " ".join(x.split())) if isinstance(x, str) else None for x in got]


def paraphrase(text, stats_out):
    """Anonymized text -> the same lines, every message body as a checked paraphrase in its own language (v4.1)."""
    units = para_units(text)
    items = [k for k, u in enumerate(units) if u[0] == "item" and para_wanted(u[2])]
    bodies = {k: units[k][2].strip() for k in items}
    result, todo = {}, []
    batches = para_batches(items, bodies)
    for b, batch in enumerate(batches):
        got = para_call([bodies[k] for k in batch], label="paraphrase %d/%d" % (b + 1, len(batches)))
        for k, p in zip(batch, got):
            bad = _ok_item(bodies[k], p)
            if bad:
                todo.append((k, bad))
            else:
                result[k] = p.strip()
    retried, fallback = len(todo), 0
    for r, chunk in enumerate([todo[x:x + PARA_BATCH_ITEMS] for x in range(0, len(todo), PARA_BATCH_ITEMS)]):
        notes = ["[%d] %s" % (n + 1, "; ".join(bad)) for n, (k, bad) in enumerate(chunk)]
        got = para_call([bodies[k] for k, _ in chunk], notes, label="paraphrase retry %d" % (r + 1))
        for (k, _), p in zip(chunk, got):
            if _ok_item(bodies[k], p):
                result[k] = PARA_MARK + " " + bodies[k]   # never raw: the anonymized text, marked
                fallback += 1
            else:
                result[k] = p.strip()
    out = []
    for k, u in enumerate(units):
        if u[0] == "keep":
            out.append(u[1])
        else:
            body = result.get(k, u[2].strip())
            line = u[1] + body + u[3]
            if u[1] in (" | ", " ") and out:          # a later ' | ' part or a split paragraph: same line
                out[-1] += line
            else:
                out.append(line)
    stats_out["paraphrase"] = {"items": len(items), "kept_short": sum(1 for u in units if u[0] == "item") - len(items),
                               "calls": len(batches) + (-(-retried // PARA_BATCH_ITEMS) if retried else 0),
                               "retried": retried, "not_paraphrased": fallback}
    return "\n".join(out)


def verify_summary(summary, anon, redo, stats_out):
    """--summary --paraphrase: each summary line's numbers, dates and placeholders must be in the anonymized text.
    One retry (redo(note) -> a new summary); lines still failing are left out and counted in a closing note."""
    facts = allowed_facts(anon)

    def bad_lines(s):
        return [(i, b) for i, ln in enumerate(s.split("\n")) if not re.fullmatch(r"## Part \d+ of \d+", ln.strip())
                for b in [para_problems(anon, ln, facts, required=False)] if b]
    bad = bad_lines(summary)
    st = {"retried": 0, "lines_left_out": 0}
    if bad:
        vals = sorted({x.split(" ")[2] if x.startswith("the ") else x for _, b in bad for x in b})
        summary = redo(SUMMARY_RETRY % ", ".join(vals[:20]))
        st["retried"] = 1
        bad = bad_lines(summary)
    if bad:
        drop = {i for i, _ in bad}
        lines = [ln for i, ln in enumerate(summary.split("\n")) if i not in drop]
        lines.append("%s %d summary line(s) left out: they held a number or date that is not in the messages."
                     % (PARA_MARK, len(drop)))
        summary = "\n".join(lines)
        st["lines_left_out"] = len(drop)
    stats_out["summary_check"] = st
    return summary


# ---------------------------------------------------------------- main
def vault_backend():
    """True when the local LLM lives in the privacy vault (env LLM_LOCAL_BACKEND, else ~/.config/llm-local/backend)."""
    b = os.environ.get("LLM_LOCAL_BACKEND")
    if b is None:
        try:
            with open(os.path.expanduser("~/.config/llm-local/backend"), encoding="utf-8") as f:
                b = f.read()
        except OSError:
            b = ""
    return b.strip() == "vault"


def main():
    if vault_backend():
        vault = os.environ.get("LLM_LOCAL_VAULT_BIN") or os.path.expanduser("~/bin/vault")
        try:
            os.execv(vault, [vault, "llm-run", "--"] + sys.argv[1:])
        except OSError as e:
            die("cannot run the vault client %s: %s" % (vault, e.strerror), 3)
    ap = argparse.ArgumentParser(prog="llm-local", description="Local LLM (127.0.0.1 only). Prompt on stdin.")
    ap.add_argument("--system", help="system prompt (with --summary: extra summary instructions)")
    ap.add_argument("--max-tokens", type=int, default=None, help="max tokens to generate (default 1024; summary 1500)")
    ap.add_argument("--json", action="store_true", help="ask for a JSON object; print it validated")
    ap.add_argument("--schema", help="a JSON schema: grammar-constrained JSON output (implies --json; the privacy "
                    "vault's answers)")
    ap.add_argument("--temp", type=float, default=0.7, help="temperature (default 0.7)")
    ap.add_argument("--anonymize", action="store_true",
                    help="redact private passages and identifiers, keep names, addresses and facts verbatim")
    ap.add_argument("--summary", action="store_true", help="with --anonymize (implied): detailed summary of that")
    ap.add_argument("--strict", action="store_true",
                    help="maximum anonymity: also alias every name (Person A/B) and mask addresses/locations")
    ap.add_argument("--owner-name", help="the owner's name in the text; becomes 'You'")
    ap.add_argument("--keep-own-money", action="store_true",
                    help="admin documents (his bills, payslips, tax papers): keep the owner's own money details "
                         "(policy v2 money rule, no business category, no [amount] net)")
    ap.add_argument("--all-amounts", action="store_true",
                    help="the owner's own mail (receipts, orders, bank notices): the money net masks every currency "
                         "amount, every labelled number and bare cents, any size (policy v3.1)")
    ap.add_argument("--paraphrase", action="store_true",
                    help="policy v4, after --anonymize (implied): rewrite every message body as a "
                         "short, neutral paraphrase in its own language (v4.1: never translated) that keeps every fact; numbers, dates and placeholders "
                         "are checked in code (one retry, then the anonymized text marked [not paraphrased]); with "
                         "--summary: the summary is checked the same way")
    ap.add_argument("--cache-dir", help="anonymization cache (the privacy vault's private jobs only; env "
                                        "LLM_LOCAL_CACHE_DIR): detections as positions, check verdicts, summaries "
                                        "and paraphrase batches (sealed)")
    ap.add_argument("--chunk-chars", type=int, default=6000, help="anonymize chunk size in characters")
    ap.add_argument("--stats", action="store_true", help="print speed and counts to stderr")
    ap.add_argument("--no-start", action="store_true", help="don't start the server if it's down")
    ap.add_argument("--timeout", type=int, default=1800, help="per-request timeout in seconds")
    a = ap.parse_args()
    if a.summary or a.strict or a.keep_own_money or a.all_amounts or a.paraphrase:
        a.anonymize = True
    if a.keep_own_money and a.all_amounts:
        die("--all-amounts can't be combined with --keep-own-money", 2)
    if a.max_tokens is not None and a.max_tokens < 1:
        die("--max-tokens must be >= 1", 2)
    if a.chunk_chars < 500:
        die("--chunk-chars must be >= 500", 2)
    if a.json and a.anonymize:
        die("--json can't be combined with --anonymize/--summary/--strict/--keep-own-money/--all-amounts/"
            "--paraphrase", 2)
    text = sys.stdin.read()
    if not text.strip():
        die("empty input on stdin", 2)
    extra = {}
    global CACHE
    try:
        ensure_server(a.no_start)
        cdir = a.cache_dir or os.environ.get("LLM_LOCAL_CACHE_DIR")
        if a.anonymize and cdir:                     # never for a plain prompt (the caller's own text)
            try:
                CACHE = AnonCache(cdir)
            except OSError:                           # an unusable cache folder: the work runs without it
                CACHE_STATS.setdefault("cache_unavailable", [0, 0])[1] += 1
        if a.anonymize:
            out, reapply = anonymize(text, a.owner_name, a.chunk_chars, extra, a.strict, a.keep_own_money,
                                     a.all_amounts)
            if a.summary:   # the model only sees the anonymized text; re-apply the name rules and regexes anyway
                def redo(note=""):
                    return summarize(out, (a.system or "") + note, a.max_tokens or 1500, a.strict, a.keep_own_money)
                summ = redo()
                if a.paraphrase:                     # policy v4: its numbers and dates must be in the text
                    summ = verify_summary(summ, out, redo, extra)
                out, c2 = regex_pass(reapply(summ), money=not a.keep_own_money, all_amounts=a.all_amounts)
                extra["regex_pass_hits_summary"] = c2
            elif a.paraphrase:                       # policy v4: the anonymized text only, then the nets again
                out, c3 = regex_pass(reapply(paraphrase(out, extra)), money=not a.keep_own_money,
                                     all_amounts=a.all_amounts)
                extra["regex_pass_hits_paraphrase"] = c3
            sys.stdout.write(out if out.endswith("\n") else out + "\n")
        else:
            msgs = ([{"role": "system", "content": a.system}] if a.system else []) + [{"role": "user", "content": text}]
            schema = None
            if a.schema:
                try:
                    schema = json.loads(a.schema)
                except ValueError:
                    raise LLMError("--schema is not valid JSON", 2)
                a.json = True
            out, finish = chat(msgs, max_tokens=a.max_tokens or 1024, temperature=a.temp, json_mode=a.json,
                               schema=schema, timeout=a.timeout)
            if a.json:
                try:
                    out = json.dumps(json.loads(out), ensure_ascii=False)
                except ValueError:
                    raise LLMError("the local LLM did not return valid JSON%s"
                                   % (" (cut off: raise --max-tokens)" if finish == "length" else ""), 4)
            print(out)
            if finish == "length":
                print("llm-local: note: answer cut off at --max-tokens", file=sys.stderr)
    except LLMError as e:
        die(str(e), e.code)
    finally:
        if a.stats:
            checks = [s for s in STATS if s["step"] == "check"]
            for s in [s for s in STATS if s["step"] != "check"]:
                print("llm-local stats: " + json.dumps(s), file=sys.stderr)
            if checks:
                print("llm-local stats: " + json.dumps({"step": "check x%d" % len(checks),
                      "wall_s": round(sum(s["wall_s"] for s in checks), 1),
                      "prompt_tokens": sum(s["prompt_tokens"] or 0 for s in checks),
                      "gen_tokens": sum(s["gen_tokens"] or 0 for s in checks)}), file=sys.stderr)
            if CACHE_STATS:
                extra["cache"] = {k: {"hits": v[0], "misses": v[1]} for k, v in CACHE_STATS.items()}
            if extra:
                print("llm-local stats: " + json.dumps(extra, ensure_ascii=False), file=sys.stderr)
        if os.environ.get("LLM_LOCAL_STATS_FILE") and (STATS or CACHE_STATS):
            write_stats_line(os.environ["LLM_LOCAL_STATS_FILE"])
        if CACHE:
            try:
                CACHE.prune()
            except OSError:
                pass


if __name__ == "__main__":
    main()

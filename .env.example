# Copy to .env (chmod 600). docker compose reads it for variable substitution and passes it to the container.
VAULT_TOKEN_SHA256=            # sha256 of the API token the assistant uses (the token itself stays on the assistant side)
VAULT_HA_DEVICE=               # optional: your phone's Home Assistant entity prefix, e.g. pixel_8
VAULT_MODELS_DIR=./models      # host dir with the local LLM weights (mounted read-only at /models)
VAULT_CPUS=8                   # CPU quota for the container
VAULT_CPUSET=0-7               # cores the local LLM may use (pin to your fast cores)
VAULT_MEM_LIMIT=22g            # memory limit (the default model peaks around 19 GB)
# VAULT_FIREFLY_SYNC=/data/finance/importer   # optional: your own bank-export importer (dir with vault_runner.py)
# Deploy mailbox on the host (Telegram-approved deploys; the runner's MAILBOX setting must match). Default:
# VAULT_DEPLOY_DIR=/mnt/user/appdata/claude-vault-mailbox
